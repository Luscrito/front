{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.some.js\";\nimport { ref, reactive } from 'vue';\nimport axios from 'axios';\nimport { ElMessage } from 'element-plus';\nexport default {\n  __name: 'AddContainerDialog',\n  setup(__props, {\n    expose: __expose\n  }) {\n    const dialogVisible = ref(false);\n    const form = reactive({\n      containerName: '',\n      routes: [{\n        targetIp: '',\n        nextHopIp: ''\n      }]\n    });\n    const openDialog = () => {\n      // 重置表单\n      form.containerName = '';\n      form.routes = [{\n        targetIp: '',\n        nextHopIp: ''\n      }];\n      dialogVisible.value = true;\n    };\n    const addRoute = () => {\n      form.routes.push({\n        targetIp: '',\n        nextHopIp: ''\n      });\n    };\n    const removeRoute = index => {\n      form.routes.splice(index, 1);\n    };\n    const submitRoutes = async () => {\n      if (!form.containerName || form.routes.some(r => !r.targetIp || !r.nextHopIp)) {\n        ElMessage.warning('请填写完整容器名和路由项');\n        return;\n      }\n      try {\n        await axios.post(`http://localhost:8081/bird/add?containerName=${encodeURIComponent(form.containerName)}`, form.routes);\n        ElMessage.success('添加成功');\n        dialogVisible.value = false;\n      } catch (err) {\n        console.error(err);\n        ElMessage.error('添加失败：' + (err.response?.data || err.message));\n      }\n    };\n    __expose({\n      openDialog\n    });\n    const __returned__ = {\n      dialogVisible,\n      form,\n      openDialog,\n      addRoute,\n      removeRoute,\n      submitRoutes,\n      ref,\n      reactive,\n      get axios() {\n        return axios;\n      },\n      get ElMessage() {\n        return ElMessage;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","reactive","axios","ElMessage","dialogVisible","form","containerName","routes","targetIp","nextHopIp","openDialog","value","addRoute","push","removeRoute","index","splice","submitRoutes","some","r","warning","post","encodeURIComponent","success","err","console","error","response","data","message","__expose"],"sources":["/home/lsc/IdeaProjects/dockerNetwork/front/src/components/Container/AddContainerDialog.vue"],"sourcesContent":["<template>\n  <el-dialog title=\"添加静态路由\" v-model=\"dialogVisible\" width=\"600px\">\n    <el-form :model=\"form\" label-width=\"90px\" class=\"route-form\">\n      <el-form-item label=\"容器名称\" required>\n        <el-input v-model=\"form.containerName\" placeholder=\"请输入容器名称\" />\n      </el-form-item>\n\n      <div v-for=\"(route, index) in form.routes\" :key=\"index\" class=\"route-item\">\n        <el-form-item label=\"目标 IP\" required>\n          <el-input v-model=\"route.targetIp\" placeholder=\"例如 192.168.1.0/24\" />\n        </el-form-item>\n        <el-form-item label=\"下一跳 IP\" required>\n          <el-input v-model=\"route.nextHopIp\" placeholder=\"例如 172.17.0.2\" />\n        </el-form-item>\n        <el-button type=\"danger\" @click=\"removeRoute(index)\" :disabled=\"form.routes.length <= 1\">删除</el-button>\n        <el-divider />\n      </div>\n\n      <el-form-item>\n        <el-button @click=\"addRoute\">添加路由条目</el-button>\n      </el-form-item>\n    </el-form>\n\n    <template #footer>\n      <el-button type=\"primary\" @click=\"submitRoutes\">提 交</el-button>\n      <el-button @click=\"dialogVisible = false\">取 消</el-button>\n    </template>\n  </el-dialog>\n</template>\n\n<script setup>\nimport { ref, reactive, defineExpose } from 'vue'\nimport axios from 'axios'\nimport { ElMessage } from 'element-plus'\n\nconst dialogVisible = ref(false)\n\nconst form = reactive({\n  containerName: '',\n  routes: [\n    { targetIp: '', nextHopIp: '' }\n  ]\n})\n\nconst openDialog = () => {\n  // 重置表单\n  form.containerName = ''\n  form.routes = [{ targetIp: '', nextHopIp: '' }]\n  dialogVisible.value = true\n}\n\nconst addRoute = () => {\n  form.routes.push({ targetIp: '', nextHopIp: '' })\n}\n\nconst removeRoute = (index) => {\n  form.routes.splice(index, 1)\n}\n\nconst submitRoutes = async () => {\n  if (!form.containerName || form.routes.some(r => !r.targetIp || !r.nextHopIp)) {\n    ElMessage.warning('请填写完整容器名和路由项')\n    return\n  }\n\n  try {\n    await axios.post(`http://localhost:8081/bird/add?containerName=${encodeURIComponent(form.containerName)}`, form.routes)\n    ElMessage.success('添加成功')\n    dialogVisible.value = false\n  } catch (err) {\n    console.error(err)\n    ElMessage.error('添加失败：' + (err.response?.data || err.message))\n  }\n}\n\ndefineExpose({ openDialog })\n</script>\n\n<style scoped>\n.route-form {\n  padding-top: 10px;\n}\n\n.route-item {\n  background: #f9f9f9;\n  padding: 12px;\n  margin-bottom: 12px;\n  border: 1px dashed #ccc;\n  border-radius: 6px;\n}\n</style>\n"],"mappings":";;;AA+BA,SAASA,GAAG,EAAEC,QAAsB,QAAQ,KAAI;AAChD,OAAOC,KAAK,MAAM,OAAM;AACxB,SAASC,SAAS,QAAQ,cAAa;;;;;;IAEvC,MAAMC,aAAa,GAAGJ,GAAG,CAAC,KAAK;IAE/B,MAAMK,IAAI,GAAGJ,QAAQ,CAAC;MACpBK,aAAa,EAAE,EAAE;MACjBC,MAAM,EAAE,CACN;QAAEC,QAAQ,EAAE,EAAE;QAAEC,SAAS,EAAE;MAAG;IAElC,CAAC;IAED,MAAMC,UAAU,GAAGA,CAAA,KAAM;MACvB;MACAL,IAAI,CAACC,aAAa,GAAG,EAAC;MACtBD,IAAI,CAACE,MAAM,GAAG,CAAC;QAAEC,QAAQ,EAAE,EAAE;QAAEC,SAAS,EAAE;MAAG,CAAC;MAC9CL,aAAa,CAACO,KAAK,GAAG,IAAG;IAC3B;IAEA,MAAMC,QAAQ,GAAGA,CAAA,KAAM;MACrBP,IAAI,CAACE,MAAM,CAACM,IAAI,CAAC;QAAEL,QAAQ,EAAE,EAAE;QAAEC,SAAS,EAAE;MAAG,CAAC;IAClD;IAEA,MAAMK,WAAW,GAAIC,KAAK,IAAK;MAC7BV,IAAI,CAACE,MAAM,CAACS,MAAM,CAACD,KAAK,EAAE,CAAC;IAC7B;IAEA,MAAME,YAAY,GAAG,MAAAA,CAAA,KAAY;MAC/B,IAAI,CAACZ,IAAI,CAACC,aAAa,IAAID,IAAI,CAACE,MAAM,CAACW,IAAI,CAACC,CAAC,IAAI,CAACA,CAAC,CAACX,QAAQ,IAAI,CAACW,CAAC,CAACV,SAAS,CAAC,EAAE;QAC7EN,SAAS,CAACiB,OAAO,CAAC,cAAc;QAChC;MACF;MAEA,IAAI;QACF,MAAMlB,KAAK,CAACmB,IAAI,CAAC,gDAAgDC,kBAAkB,CAACjB,IAAI,CAA