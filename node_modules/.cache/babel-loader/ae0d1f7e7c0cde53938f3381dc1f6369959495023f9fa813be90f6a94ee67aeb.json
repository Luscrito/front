{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport { ref, reactive, nextTick, computed } from 'vue';\nimport axios from 'axios';\nimport { ElMessage } from 'element-plus';\nimport DockerContainers from '@/components/Container/DockerContainers.vue';\nexport default {\n  __name: 'DeleteStaticRouteDialog',\n  setup(__props, {\n    expose: __expose\n  }) {\n    const dialogVisible = ref(false);\n    const containersRef = ref(null);\n    const containerList = ref([]);\n    const routeOptions = ref([]);\n    const form = reactive({\n      containerName: '',\n      selectedRoutes: [] // string[] -> 用字符串标识 targetIp->nextHopIp\n    });\n\n    // 打开弹窗\n    const openDialog = async () => {\n      form.containerName = '';\n      form.selectedRoutes = [];\n      routeOptions.value = [];\n      dialogVisible.value = true;\n      await nextTick();\n      if (containersRef.value) {\n        await containersRef.value.fetchContainers();\n        containerList.value = containersRef.value.containers || [];\n      }\n    };\n\n    // 计算可用的运行中容器\n    const availableContainers = computed(() => {\n      return containerList.value.filter(c => c.status?.includes('Up'));\n    });\n    const formatContainerName = name => {\n      return name.replace(/^\\//, '');\n    };\n    const formatStatus = status => {\n      return status?.includes('Up') ? '运行中' : '已停止';\n    };\n\n    // 选中容器后加载静态路由\n    const loadRoutes = async () => {\n      if (!form.containerName) return;\n      try {\n        const res = await axios.get(`http://localhost:8081/bird/list?containerName=${encodeURIComponent(form.containerName)}`);\n        routeOptions.value = res.data || [];\n      } catch (err) {\n        console.error('获取路由失败', err);\n        ElMessage.error('获取路由失败');\n      }\n    };\n\n    // 提交删除\n    const submitDelete = async () => {\n      if (!form.containerName || form.selectedRoutes.length === 0) {\n        ElMessage.warning('请选择容器和需要删除的路由');\n        return;\n      }\n      const routesToDelete = form.selectedRoutes.map(str => {\n        const [targetIp, nextHopIp] = str.split('->');\n        return {\n          targetIp,\n          nextHopIp\n        };\n      });\n      try {\n        await axios.delete(`http://localhost:8081/bird/delete`, {\n          params: {\n            containerName: form.containerName\n          },\n          data: routesToDelete\n        });\n        ElMessage.success('删除成功');\n        dialogVisible.value = false;\n      } catch (err) {\n        console.error(err);\n        ElMessage.error('删除失败：' + (err.response?.data || err.message));\n      }\n    };\n    __expose({\n      openDialog\n    });\n    const __returned__ = {\n      dialogVisible,\n      containersRef,\n      containerList,\n      routeOptions,\n      form,\n      openDialog,\n      availableContainers,\n      formatContainerName,\n      formatStatus,\n      loadRoutes,\n      submitDelete,\n      ref,\n      reactive,\n      nextTick,\n      computed,\n      get axios() {\n        return axios;\n      },\n      get ElMessage() {\n        return ElMessage;\n      },\n      DockerContainers\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","reactive","nextTick","computed","axios","ElMessage","DockerContainers","dialogVisible","containersRef","containerList","routeOptions","form","containerName","selectedRoutes","openDialog","value","fetchContainers","containers","availableContainers","filter","c","status","includes","formatContainerName","name","replace","formatStatus","loadRoutes","res","get","encodeURIComponent","data","err","console","error","submitDelete","length","warning","routesToDelete","map","str","targetIp","nextHopIp","split","delete","params","success","response","message","__expose"],"sources":["/home/lsc/IdeaProjects/dockerNetwork/front/src/components/Bird/DeleteStaticRouteDialog.vue"],"sourcesContent":["<template>\n  <el-dialog title=\"删除静态路由\" v-model=\"dialogVisible\" width=\"600px\">\n    <el-form :model=\"form\" label-width=\"90px\" class=\"route-form\">\n      <el-form-item label=\"容器名称\" required>\n        <el-select\n            v-model=\"form.containerName\"\n            placeholder=\"请选择容器\"\n            clearable\n            filterable\n            class=\"full-width\"\n        >\n          <el-option\n              v-for=\"container in availableContainers\"\n              :key=\"container.id\"\n              :value=\"formatContainerName(container.name)\"\n          >\n            <span class=\"container-option\">\n              <span class=\"name\">{{ formatContainerName(container.name) }}</span>\n              <span class=\"status running\">\n                {{ formatStatus(container.status) }}\n              </span>\n            </span>\n          </el-option>\n        </el-select>\n      </el-form-item>\n\n      <div v-if=\"routeOptions.length > 0\">\n        <el-form-item label=\"选择路由\" required>\n          <el-checkbox-group v-model=\"form.selectedRoutes\">\n            <el-checkbox\n                v-for=\"(route, index) in routeOptions\"\n                :key=\"index\"\n                :label=\"`${route.targetIp}->${route.nextHopIp}`\"\n            >\n              {{ route.targetIp }} → {{ route.nextHopIp }}\n            </el-checkbox>\n          </el-checkbox-group>\n        </el-form-item>\n      </div>\n\n      <div v-else-if=\"form.containerName\">\n        <el-alert title=\"该容器暂无静态路由配置\" type=\"info\" show-icon />\n      </div>\n    </el-form>\n\n    <template #footer>\n      <el-button type=\"primary\" @click=\"submitDelete\">确 定</el-button>\n      <el-button @click=\"dialogVisible = false\">取 消</el-button>\n    </template>\n\n    <!-- 获取容器列表用 -->\n    <DockerContainers ref=\"containersRef\" />\n  </el-dialog>\n</template>\n\n<script setup>\nimport {ref, reactive, nextTick, defineExpose, computed} from 'vue'\nimport axios from 'axios'\nimport { ElMessage } from 'element-plus'\nimport DockerContainers from '@/components/Container/DockerContainers.vue'\n\nconst dialogVisible = ref(false)\nconst containersRef = ref(null)\nconst containerList = ref([])\nconst routeOptions = ref([])\n\nconst form = reactive({\n  containerName: '',\n  selectedRoutes: [] // string[] -> 用字符串标识 targetIp->nextHopIp\n})\n\n// 打开弹窗\nconst openDialog = async () => {\n  form.containerName = ''\n  form.selectedRoutes = []\n  routeOptions.value = []\n  dialogVisible.value = true\n\n  await nextTick()\n  if (containersRef.value) {\n    await containersRef.value.fetchContainers()\n    containerList.value = containersRef.value.containers || []\n  }\n}\n\n// 计算可用的运行中容器\nconst availableContainers = computed(() => {\n  return containerList.value.filter(c => c.status?.includes('Up'))\n})\n\nconst formatContainerName = (name) => {\n  return name.replace(/^\\//, '')\n}\n\nconst formatStatus = (status) => {\n  return status?.includes('Up') ? '运行中' : '已停止'\n}\n\n// 选中容器后加载静态路由\nconst loadRoutes = async () => {\n  if (!form.containerName) return\n\n  try {\n    const res = await axios.get(`http://localhost:8081/bird/list?containerName=${encodeURIComponent(form.containerName)}`)\n    routeOptions.value = res.data || []\n  } catch (err) {\n    console.error('获取路由失败', err)\n    ElMessage.error('获取路由失败')\n  }\n}\n\n// 提交删除\nconst submitDelete = async () => {\n  if (!form.containerName || form.selectedRoutes.length === 0) {\n    ElMessage.warning('请选择容器和需要删除的路由')\n    return\n  }\n\n  const routesToDelete = form.selectedRoutes.map(str => {\n    const [targetIp, nextHopIp] = str.split('->')\n    return { targetIp, nextHopIp }\n  })\n\n  try {\n    await axios.delete(`http://localhost:8081/bird/delete`, {\n      params: { containerName: form.containerName },\n      data: routesToDelete\n    })\n    ElMessage.success('删除成功')\n    dialogVisible.value = false\n  } catch (err) {\n    console.error(err)\n    ElMessage.error('删除失败：' + (err.response?.data || err.message))\n  }\n}\n\ndefineExpose({ openDialog })\n</script>\n\n<style scoped>\n.route-form {\n  padding: 20px 30px;\n}\n\n.full-width {\n  width: 100%;\n}\n\n.container-option {\n  display: flex;\n  justify-content: space-between;\n  width: 100%;\n}\n\n.status {\n  font-size: 12px;\n  padding: 2px 8px;\n  border-radius: 4px;\n}\n\n.status.running {\n  color: #67C23A;\n  background: #f0f9eb;\n}\n\n.route-item {\n  background: #f9f9f9;\n  padding: 12px;\n  margin-bottom: 12px;\n  border: 1px dashed #ccc;\n  border-radius: 6px;\n}\n</style>\n"],"mappings":";;;AAwDA,SAAQA,GAAG,EAAEC,QAAQ,EAAEC,QAAsB,EAAEC,QAAQ,QAAO,KAAI;AAClE,OAAOC,KAAK,MAAM,OAAM;AACxB,SAASC,SAAS,QAAQ,cAAa;AACvC,OAAOC,gBAAgB,MAAM,6CAA4C;;;;;;IAEzE,MAAMC,aAAa,GAAGP,GAAG,CAAC,KAAK;IAC/B,MAAMQ,aAAa,GAAGR,GAAG,CAAC,IAAI;IAC9B,MAAMS,aAAa,GAAGT,GAAG,CAAC,EAAE;IAC5B,MAAMU,YAAY,GAAGV,GAAG,CAAC,EAAE;IAE3B,MAAMW,IAAI,GAAGV,QAAQ,CAAC;MACpBW,aAAa,EAAE,EAAE;MACjBC,cAAc,EAAE,EAAE,CAAC;IACrB,CAAC;;IAED;IACA,MAAMC,UAAU,GAAG,MAAAA,CAAA,KAAY;MAC7BH,IAAI,CAACC,aAAa,GAAG,EAAC;MACtBD,IAAI,CAACE,cAAc,GAAG,EAAC;MACvBH,YAAY,CAACK,KAAK,GAAG,EAAC;MACtBR,aAAa,CAACQ,KAAK,GAAG,IAAG;MAEzB,MAAMb,QAAQ,CAAC;MACf,IAAIM,aAAa,CAACO,KAAK,EAAE;QACvB,MAAMP,aAAa,CAACO,KAAK,CAACC,eAAe,CAAC;QAC1CP,aAAa,CAACM,KAAK,GAAGP,aAAa,CAACO,KAAK,CAACE,UAAU,IAAI,EAAC;MAC3D;IACF;;IAEA;IACA,MAAMC,mBAAmB,GAAGf,QAAQ,CAAC,MAAM;MACzC,OAAOM,aAAa,CAACM,KAAK,CAACI,MAAM,CAACC,CAAC,IAAIA,CAAC,CAACC,MAAM,EAAEC,QAAQ,CAAC,IAAI,CAAC;IACjE,CAAC;IAED,MAAMC,mBAAmB,GAAIC,IAAI,IAAK;MACpC,OAAOA,IAAI,CAACC,OAAO,CAAC,KAAK,EAAE,EAAE;IAC/B;IAEA,MAAMC,YAAY,GAAIL,MAAM,IAAK;MAC/B,OAAOA,MAAM,EAAEC,QAAQ,CAAC,IAAI,CAAC,GAAG,KAAK,GAAG,KAAI;IAC9C;;IAEA;IACA,MAAMK,UAAU,GAAG,MAAAA,CAAA,KAAY;MAC7B,IAAI,CAAChB,IAAI,CAACC,aAAa,EAAE;MAEzB,IAAI;QACF,MAAMgB,GAAG,GAAG,MAAMxB,KAAK,CAACyB,GAAG,CAAC,iDAAiDC,kBAAkB,CAACnB,IAAI,CAACC,aAAa,CAAC,EAAE;QACrHF,YAAY,CAACK,KAAK,GAAGa,GAAG,CA