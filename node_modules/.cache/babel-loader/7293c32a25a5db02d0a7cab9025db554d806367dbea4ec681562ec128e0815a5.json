{"ast":null,"code":"import { createCommentVNode as _createCommentVNode, renderList as _renderList, Fragment as _Fragment, openBlock as _openBlock, createElementBlock as _createElementBlock, resolveComponent as _resolveComponent, createBlock as _createBlock, withCtx as _withCtx, createElementVNode as _createElementVNode, createVNode as _createVNode } from \"vue\";\nconst _hoisted_1 = {\n  class: \"monitor-container\"\n};\nconst _hoisted_2 = {\n  class: \"charts-container\"\n};\nconst _hoisted_3 = {\n  ref: \"bandwidthChartRef\",\n  style: {\n    \"height\": \"300px\",\n    \"flex\": \"1\",\n    \"margin-right\": \"20px\"\n  }\n};\nconst _hoisted_4 = {\n  ref: \"networkChartRef\",\n  style: {\n    \"height\": \"300px\",\n    \"flex\": \"1\"\n  }\n};\nexport function render(_ctx, _cache, $props, $setup, $data, $options) {\n  const _component_el_option = _resolveComponent(\"el-option\");\n  const _component_el_select = _resolveComponent(\"el-select\");\n  return _openBlock(), _createElementBlock(_Fragment, null, [_createElementVNode(\"div\", _hoisted_1, [_createCommentVNode(\" 容器选择器，只有当 containers 不为空时才渲染 \"), $setup.containers.length > 0 ? (_openBlock(), _createBlock(_component_el_select, {\n    key: 0,\n    modelValue: $setup.selectedContainer,\n    \"onUpdate:modelValue\": _cache[0] || (_cache[0] = $event => $setup.selectedContainer = $event),\n    placeholder: \"选择容器\",\n    onChange: $setup.startMonitoring\n  }, {\n    default: _withCtx(() => [(_openBlock(true), _createElementBlock(_Fragment, null, _renderList($setup.containers, c => {\n      return _openBlock(), _createBlock(_component_el_option, {\n        key: c.name,\n        label: c.name.replace(/^\\//, ''),\n        value: c.name.replace(/^\\//, '')\n      }, null, 8 /* PROPS */, [\"label\", \"value\"]);\n    }), 128 /* KEYED_FRAGMENT */))]),\n    _: 1 /* STABLE */\n  }, 8 /* PROPS */, [\"modelValue\"])) : _createCommentVNode(\"v-if\", true), _createCommentVNode(\" 容器图表，使用 flexbox 横向排列 \"), _createElementVNode(\"div\", _hoisted_2, [_createCommentVNode(\" 带宽图表 \"), _createElementVNode(\"div\", _hoisted_3, null, 512 /* NEED_PATCH */), _createCommentVNode(\" 网络收发图表 \"), _createElementVNode(\"div\", _hoisted_4, null, 512 /* NEED_PATCH */)])]), _createVNode($setup[\"DockerContainers\"], {\n    ref: \"dockerContainersRef\"\n  }, null, 512 /* NEED_PATCH */)], 64 /* STABLE_FRAGMENT */);\n}","map":{"version":3,"names":["class","ref","style","_createElementBlock","_Fragment","_createElementVNode","_hoisted_1","_createCommentVNode","$setup","containers","length","_createBlock","_component_el_select","key","modelValue","selectedContainer","_cache","$event","placeholder","onChange","startMonitoring","default","_withCtx","_renderList","c","_component_el_option","name","label","replace","value","_","_hoisted_2","_hoisted_3","_hoisted_4","_createVNode"],"sources":["/home/lsc/IdeaProjects/dockerNetwork/front/src/components/Monitor/MonitorView.vue"],"sourcesContent":["<template>\n  <div class=\"monitor-container\">\n    <!-- 容器选择器，只有当 containers 不为空时才渲染 -->\n    <el-select\n        v-if=\"containers.length > 0\"\n        v-model=\"selectedContainer\"\n        placeholder=\"选择容器\"\n        @change=\"startMonitoring\"\n    >\n      <el-option\n          v-for=\"c in containers\"\n          :key=\"c.name\"\n          :label=\"c.name.replace(/^\\//, '')\"\n          :value=\"c.name.replace(/^\\//, '')\"\n      />\n    </el-select>\n\n    <!-- 容器图表，使用 flexbox 横向排列 -->\n    <div class=\"charts-container\">\n      <!-- 带宽图表 -->\n      <div ref=\"bandwidthChartRef\" style=\"height: 300px; flex: 1; margin-right: 20px;\"></div>\n\n      <!-- 网络收发图表 -->\n      <div ref=\"networkChartRef\" style=\"height: 300px; flex: 1;\"></div>\n    </div>\n  </div>\n\n  <DockerContainers ref=\"dockerContainersRef\" />\n</template>\n\n<script setup>\nimport { ref, onMounted, onBeforeUnmount, nextTick } from 'vue'\nimport DockerContainers from '@/components/Container/DockerContainers.vue' // 修改为你的实际路径\nimport axios from 'axios'\nimport * as echarts from 'echarts'\n\n// refs\nconst dockerContainersRef = ref(null)\nconst containers = ref([])  // 容器列表\nconst selectedContainer = ref('')  // 当前选中的容器\nconst bandwidthChartRef = ref(null)\nconst networkChartRef = ref(null)\n\nlet bandwidthChart = null\nlet networkChart = null\nlet intervalId = null\n\n// 图表数据\nconst timeData = ref([])\nconst bandwidthData = ref([])\nconst rxData = ref([])\nconst txData = ref([])\n\n// 获取容器列表（通过子组件暴露的方法）\nconst fetchContainers = async () => {\n  if (dockerContainersRef.value) {\n    await dockerContainersRef.value.fetchContainers()\n    containers.value = dockerContainersRef.value.containers\n  }\n}\n\n// 开始监控\nconst startMonitoring = () => {\n  clearInterval(intervalId)\n\n  timeData.value = []\n  bandwidthData.value = []\n  rxData.value = []\n  txData.value = []\n\n  updateCharts()\n\n  intervalId = setInterval(async () => {\n    if (!selectedContainer.value) return\n\n    const timestamp = new Date().toLocaleTimeString()\n\n    try {\n      const bandwidthRes = await axios.get(`http://localhost:8081/stats/bandwidth/${selectedContainer.value}?interval=1000`)\n      const statsRes = await axios.get(`http://localhost:8081/stats/networkStats/${selectedContainer.value}`)\n\n      timeData.value.push(timestamp)\n      bandwidthData.value.push(bandwidthRes.data.totalRate)\n      rxData.value.push(statsRes.data.rxBytes)\n      txData.value.push(statsRes.data.txBytes)\n\n      if (timeData.value.length > 20) {\n        timeData.value.shift()\n        bandwidthData.value.shift()\n        rxData.value.shift()\n        txData.value.shift()\n      }\n\n      updateCharts()\n    } catch (err) {\n      console.error('监控数据获取失败', err)\n    }\n  }, 1000)\n}\n\n// 更新图表\nconst updateCharts = () => {\n  if (!bandwidthChart || !networkChart) {\n    bandwidthChart = echarts.init(bandwidthChartRef.value)\n    networkChart = echarts.init(networkChartRef.value)\n  }\n\n  bandwidthChart.setOption({\n    title: { text: '容器带宽使用率 (Bytes/s)' },\n    tooltip: { trigger: 'axis' },\n    xAxis: { type: 'category', data: timeData.value },\n    yAxis: { type: 'value' },\n    series: [\n      {\n        data: bandwidthData.value,\n        type: 'line',\n        name: '总带宽',\n        smooth: true,\n        areaStyle: {}\n      }\n    ]\n  })\n\n  networkChart.setOption({\n    title: { text: '网络收发字节数 (累计)' },\n    tooltip: { trigger: 'axis' },\n    legend: { data: ['接收字节 RX', '发送字节 TX'] },\n    xAxis: { type: 'category', data: timeData.value },\n    yAxis: { type: 'value' },\n    series: [\n      {\n        data: rxData.value,\n        type: 'line',\n        name: '接收字节 RX',\n        smooth: true\n      },\n      {\n        data: txData.value,\n        type: 'line',\n        name: '发送字节 TX',\n        smooth: true\n      }\n    ]\n  })\n}\n\nonMounted(async () => {\n  await nextTick()\n  await fetchContainers()\n})\n\nonBeforeUnmount(() => {\n  clearInterval(intervalId)\n})\n</script>\n\n<style scoped>\n.monitor-container {\n  padding: 20px;\n}\n\n/* 使用 flexbox 来让两个图表横向排列 */\n.charts-container {\n  display: flex;\n  justify-content: space-between;\n  margin-top: 20px;\n}\n</style>\n"],"mappings":";;EACOA,KAAK,EAAC;AAAmB;;EAiBvBA,KAAK,EAAC;AAAkB;;EAEtBC,GAAG,EAAC,mBAAmB;EAACC,KAAmD,EAAnD;IAAA;IAAA;IAAA;EAAA;;;EAGxBD,GAAG,EAAC,iBAAiB;EAACC,KAA+B,EAA/B;IAAA;IAAA;EAAA;;;;;uBAvBjCC,mBAAA,CAAAC,SAAA,SACEC,mBAAA,CAwBM,OAxBNC,UAwBM,GAvBJC,mBAAA,kCAAqC,EAE3BC,MAAA,CAAAC,UAAU,CAACC,MAAM,Q,cAD3BC,YAAA,CAYYC,oBAAA;IAfhBC,GAAA;IAAAC,UAAA,EAKiBN,MAAA,CAAAO,iBAAiB;IALlC,uBAAAC,MAAA,QAAAA,MAAA,MAAAC,MAAA,IAKiBT,MAAA,CAAAO,iBAAiB,GAAAE,MAAA;IAC1BC,WAAW,EAAC,MAAM;IACjBC,QAAM,EAAEX,MAAA,CAAAY;;IAPjBC,OAAA,EAAAC,QAAA,CAUU,MAAuB,E,kBAD3BnB,mBAAA,CAKEC,SAAA,QAdRmB,WAAA,CAUsBf,MAAA,CAAAC,UAAU,EAAfe,CAAC;2BADZb,YAAA,CAKEc,oBAAA;QAHGZ,GAAG,EAAEW,CAAC,CAACE,IAAI;QACXC,KAAK,EAAEH,CAAC,CAACE,IAAI,CAACE,OAAO;QACrBC,KAAK,EAAEL,CAAC,CAACE,IAAI,CAACE,OAAO;;;IAbhCE,CAAA;uCAAAvB,mBAAA,gBAiBIA,mBAAA,0BAA6B,EAC7BF,mBAAA,CAMM,OANN0B,U