cache","_createTextVNode","_","ref","style","_normalizeStyle","containerHeight"],"sources":["/home/lsc/IdeaProjects/dockerNetwork/front/src/components/Topology/TopologyGraph.vue"],"sourcesContent":["<template>\n  <div class=\"topology-graph\">\n    <el-card shadow=\"hover\">\n      <template #header>\n        <div class=\"card-header\">\n          <span>容器网络拓扑图</span>\n          <el-button\n              type=\"primary\"\n              size=\"small\"\n              :loading=\"isLoading\"\n              @click=\"fetchTopology\"\n          >\n            刷新\n          </el-button>\n        </div>\n      </template>\n      <div\n          ref=\"chartRef\"\n          :style=\"{\n          width: '100%',\n          height: containerHeight + 'px'\n        }\"\n          v-loading=\"isLoading\"\n      ></div>\n    </el-card>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted, onBeforeUnmount } from 'vue'\nimport * as echarts from 'echarts'\nimport axios from 'axios'\nimport _ from 'lodash'\n\nconst chartRef = ref(null)\nconst containerHeight = ref(500)\nlet chartInstance = null\nconst isLoading = ref(false)\n\nconst fetchTopology = _.debounce(async () => {\n  try {\n    isLoading.value = true\n    const response = await axios.get('http://localhost:8081/topology/get')\n    renderGraph(response.data.nodes, response.data.links)\n  } catch (error) {\n    console.error('获取拓扑数据失败:', error)\n  } finally {\n    isLoading.value = false\n  }\n}, 500)\n\nconst renderGraph = (nodes, links) => {\n  if (!chartInstance) {\n    chartInstance = echarts.init(chartRef.value)\n  }\n\n  const option = {\n    title: { text: 'Docker 容器拓扑图', left: 'center' },\n    tooltip: { /* 保持原有 */ },\n    series: [{\n      type: 'graph',\n      layout: 'force',\n      roam: true,\n      label: {\n        show: true,\n        position: 'right',\n        fontSize: 12\n      },\n      force: {\n        repulsion: 2000,\n        edgeLength: [50, 150],\n        gravity: 0.1,\n        layoutAnimation: true\n      },\n      lineStyle: {\n        curveness: 0.3\n      },\n      data: nodes.map(n => ({\n        id: n.id,\n        name: n.name,\n        symbolSize: 40,\n        itemStyle: {\n          color: '#409EFF'\n        }\n      })),\n      links: links.map(l => ({\n        source: l.source,\n        target: l.target\n      }))\n    }]\n  }\n\n  chartInstance.setOption(option)\n}\n\n// 修改高度计算方式\nconst handleResize = () => {\n  if (chartRef.value?.parentElement) {\n    // 改为取父容器高度的80%（留出更多边距）\n    const parentHeight = chartRef.value.parentElement.offsetHeight\n    containerHeight.value = Math.min(500, parentHeight * 0.8) // 新增最大高度限制\n  }\n  chartInstance?.resize()\n}\n\nonMounted(() => {\n  window.addEventListener('resize', handleResize)\n  fetchTopology()\n})\n\nonBeforeUnmount(() => {\n  window.removeEventListener('resize', handleResize)\n  chartInstance?.dispose()\n})\n</script>\n\n<style scoped>\n.topology-graph {\n  width: 100%;\n  height: 100%;\n  min-height: 500px;\n  box-sizing: border-box;\n}\n\n:deep(.el-card) {\n  height: 100%;\n}\n\n:deep(.el-card__body) {\n  height: calc(100% - 60px);\n  padding: 0;\n}\n\n.card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 12px 16px;\n}\n</style>"],"mappings":";;EACOA,KAAK,EAAC;AAAgB;;EAGhBA,KAAK,EAAC;AAAa;;;;;uBAH9BC,mBAAA,CAwBM,OAxBNC,UAwBM,GAvBJC,YAAA,CAsBUC,kBAAA;IAtBDC,MAAM,EAAC;EAAO;IACVC,MAAM,EAAAC,QAAA,CACf,MAUM,CAVNC,mBAAA,CAUM,OAVNC,UAUM,G,0BATJD,mBAAA,CAAoB,cAAd,SAAO,sBACbL,YAAA,CAOYO,oBAAA;MANRC,IAAI,EAAC,SAAS;MACdC,IAAI,EAAC,OAAO;MACXC,OAAO,EAAEC,MAAA,CAAAC,SAAS;MAClBC,OAAK,EAAEF,MAAA,CAAAG;;MAVtBC,OAAA,EAAAX,QAAA,CAWW,MAEDY,MAAA,QAAAA,MAAA,OAbVC,gBAAA,CAWW,MAED,E;MAbVC,CAAA;;IAAAH,OAAA,EAAAX,QAAA,CAgBM,MAOO,C,gBAPPC,mBAAA,CAOO;MANHc,GAAG,EAAC,UAAU;MACbC,KAAK,EAlBhBC,eAAA;;gBAkB+DV,MAAA,CAAAW,eAAe;;mDAIzDX,MAAA,CAAAC,SAAS,E;IAtB9BM,CAAA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}