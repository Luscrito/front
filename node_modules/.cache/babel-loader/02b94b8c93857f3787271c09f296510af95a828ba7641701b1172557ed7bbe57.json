y\"\n                :loading=\"isLoading\"\n                style=\"margin-left: 8px\"\n            >\n              刷新\n            </el-button>\n          </div>\n        </div>\n      </template>\n      <div\n          ref=\"chartRef\"\n          :style=\"{\n          width: '100%',\n          height: containerHeight + 'px'\n        }\"\n          v-loading=\"isLoading\"\n      ></div>\n    </el-card>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted, onBeforeUnmount } from 'vue'\nimport * as echarts from 'echarts'\nimport axios from 'axios'\nimport _ from 'lodash'\nimport {ElMessage} from \"element-plus\";\n\nconst selectedNodes = ref([])\nconst chartRef = ref(null)\nconst containerHeight = ref(500)\nlet chartInstance = null\nconst isLoading = ref(false)\n\nconst fetchTopology = _.debounce(async () => {\n  try {\n    isLoading.value = true\n    const response = await axios.get('http://localhost:8081/topology/get')\n    renderGraph(response.data.nodes, response.data.links)\n  } catch (error) {\n    console.error('获取拓扑数据失败:', error)\n  } finally {\n    isLoading.value = false\n  }\n}, 500)\n\nconst renderGraph = (nodes, links) => {\n  if (!chartInstance) {\n    chartInstance = echarts.init(chartRef.value)\n  }\n\n  const option = {\n    title: { text: 'Docker 容器拓扑图', left: 'center' },\n    tooltip: { /* 保持原有 */ },\n    series: [{\n      type: 'graph',\n      layout: 'force',\n      roam: true,\n      label: {\n        show: true,\n        fontSize: 10, // 缩小标签字号\n        position: 'right',\n        distance: 5 // 标签与节点的距离\n      },\n      force: {\n        repulsion: 1000,\n        edgeLength: [30, 80],\n        gravity: 0.2,\n        layoutAnimation: true\n      },\n      lineStyle: {\n        width: 1.2\n      },\n      data: nodes.map(n => ({\n        id: n.id,\n        name: n.name,\n        symbolSize: 28,\n        itemStyle: {\n          color: '#409EFF'\n        }\n      })),\n      links: links.map(l => ({\n        source: l.source,\n        target: l.target\n      }))\n    }]\n  }\n\n  chartInstance.off('click') // 移除旧监听器\n  chartInstance.on('click', params => {\n    if (params.dataType === 'node') {\n      handleNodeClick(params.data)\n    }\n  })\n  chartInstance.setOption(option)\n}\n\n// 处理节点点击\nconst handleNodeClick = (nodeData) => {\n  const maxSelection = 2\n  const index = selectedNodes.value.findIndex(n => n.id === nodeData.id)\n\n  if (index > -1) {\n    // 取消选中\n    selectedNodes.value.splice(index, 1)\n  } else {\n    // 添加选中\n    if (selectedNodes.value.length >= maxSelection) {\n      ElMessage.warning('最多选择两个容器')\n      return\n    }\n    selectedNodes.value.push(nodeData)\n  }\n\n  // 更新节点样式\n  updateNodeStyle()\n}\n\n// 更新节点选中状态样式\nconst updateNodeStyle = () => {\n  const option = chartInstance.getOption()\n  option.series[0].data = option.series[0].data.map(node => ({\n    ...node,\n    itemStyle: {\n      color: selectedNodes.value.some(n => n.id === node.id)\n          ? '#67C23A'\n          : '#409EFF'\n    }\n  }))\n  chartInstance.setOption(option)\n}\n\n// 处理添加关系\nconst handleAddConnection = async () => {\n  try {\n    const [node1, node2] = selectedNodes.value\n    await axios.post('http://localhost:8081/container/connect', null, {\n      params: {\n        container1: node1.name,\n        container2: node2.name\n      }\n    })\n    ElMessage.success('关系添加成功')\n    clearSelection()\n    await fetchTopology()\n  } catch (error) {\n    ElMessage.error('操作失败: ' + error.message)\n  }\n}\n\n// 处理删除关系\nconst handleRemoveConnection = async () => {\n  try {\n    const [node1, node2] = selectedNodes.value\n    await axios.post('http://localhost:8081/container/disconnect', null, {\n      params: {\n        container1: node1.name,\n        container2: node2.name\n      }\n    })\n    ElMessage.success('关系删除成功')\n    clearSelection()\n    await fetchTopology()\n  } catch (error) {\n    ElMessage.error('操作失败: ' + error.message)\n  }\n}\n\n// 清空选中状态\nconst clearSelection = () => {\n  selectedNodes.value = []\n  updateNodeStyle()\n}\n\n// 修改高度计算方式\nconst handleResize = () => {\n  if (chartRef.value?.parentElement) {\n    // 改为取父容器高度的80%（留出更多边距）\n    const parentHeight = chartRef.value.parentElement.offsetHeight\n    containerHeight.value = Math.min(500, parentHeight * 0.8) // 新增最大高度限制\n  }\n  chartInstance?.resize()\n}\n\nonMounted(() => {\n  window.addEventListener('resize', handleResize)\n  fetchTopology()\n})\n\nonBeforeUnmount(() => {\n  window.removeEventListener('resize', handleResize)\n  chartInstance?.dispose()\n})\n</script>\n\n<style scoped>\n.topology-graph {\n  width: 100%;\n  height: 100%;\n  min-height: 500px;\n  box-sizing: border-box;\n}\n\n/* 微调卡片内边距 */\n:deep(.el-card__header) {\n  padding: 10px 16px !important;\n}\n\n:deep(.el-card) {\n  height: 100%;\n}\n\n:deep(.el-card__body) {\n  height: calc(100% - 50px);\n  padding: 0;\n}\n\n.card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 8px 12px;\n}\n\n/* 新增按钮组样式 */\n.action-group {\n  display: flex;\n  gap: 8px;\n  align-items: center;\n}\n\n/* 调整卡片头部内边距 */\n.card-header {\n  padding: 8px 12px;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n</style>"],"mappings":";;EACOA,KAAK,EAAC;AAAgB;;EAGhBA,KAAK,EAAC;AAAa;;EAEjBA,KAAK,EAAC;AAAc;;;;;uBALjCC,mBAAA,CA2CM,OA3CNC,UA2CM,GA1CJC,YAAA,CAyCUC,kBAAA;IAzCDC,MAAM,EAAC;EAAO;IACVC,MAAM,EAAAC,QAAA,CACf,MA6BM,CA7BNC,mBAAA,CA6BM,OA7BNC,UA6BM,G,0BA5BJD,mBAAA,CAAoB,cAAd,SAAO,sBACbA,mBAAA,CA0BM,OA1BNE,UA0BM,GAzBJP,YAAA,CAOYQ,oBAAA;MANRC,IAAI,EAAC,SAAS;MACdC,IAAI,EAAC,OAAO;MACXC,QAAQ,EAAEC,MAAA,CAAAC,aAAa,CAACC,MAAM;MAC9BC,OAAK,EAAEH,MAAA,CAAAI;;MAXxBC,OAAA,EAAAb,QAAA,CAYa,MAEDc,MAAA,QAAAA,MAAA,OAdZC,gBAAA,CAYa,QAED,E;MAdZC,CAAA;qCAeYpB,YAAA,CAOYQ,oBAAA;MANRC,IAAI,EAAC,QAAQ;MACbC,IAAI,EAAC,OAAO;MACXC,QAAQ,EAAEC,MAAA,CAAAC,aAAa,CAACC,MAAM;MAC9BC,OAAK,EAAEH,MAAA,CAAAS;;MAnBxBJ,OAAA,EAAAb,QAAA,CAoBa,MAEDc,MAAA,QAAAA,MAAA,OAtBZC,gBAAA,CAoBa,QAED,E;MAtBZC,CAAA;qCAuBYpB,YAA