{"ast":null,"code":"import { ref, onMounted, onBeforeUnmount } from 'vue';\nimport axios from 'axios';\nimport { ElMessage } from 'element-plus';\nexport default {\n  __name: 'PlanList',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const plansRef = ref([]);\n    const dialogVisible = ref(false);\n    const selectedPlan = ref(null);\n    const fetchPlans = async () => {\n      try {\n        const response = await axios.get('http://localhost:8081/plan/list');\n        plansRef.value = response.data.records || [];\n      } catch (error) {\n        ElMessage.error('获取计划数据失败');\n        console.error(error);\n      }\n    };\n    const refreshPlans = () => {\n      fetchPlans();\n    };\n    let intervalId = null;\n    onMounted(() => {\n      intervalId = setInterval(() => {\n        refreshPlans();\n      }, 1000);\n    });\n    onBeforeUnmount(() => {\n      if (intervalId) {\n        clearInterval(intervalId);\n      }\n    });\n    const viewPlan = plan => {\n      selectedPlan.value = plan;\n      dialogVisible.value = true;\n    };\n    const executePlan = plan => {\n      // 执行计划的逻辑，可以替换为你需要的操作\n      ElMessage.success(`执行计划: ${plan.name}`);\n      console.log(`正在执行计划: ${plan.name}`);\n      // 例如，你可以调用一个 API 执行计划，或者其他业务逻辑\n    };\n    const __returned__ = {\n      plansRef,\n      dialogVisible,\n      selectedPlan,\n      fetchPlans,\n      refreshPlans,\n      get intervalId() {\n        return intervalId;\n      },\n      set intervalId(v) {\n        intervalId = v;\n      },\n      viewPlan,\n      executePlan,\n      ref,\n      onMounted,\n      onBeforeUnmount,\n      get axios() {\n        return axios;\n      },\n      get ElMessage() {\n        return ElMessage;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","onBeforeUnmount","axios","ElMessage","plansRef","dialogVisible","selectedPlan","fetchPlans","response","get","value","data","records","error","console","refreshPlans","intervalId","setInterval","clearInterval","viewPlan","plan","executePlan","success","name","log"],"sources":["/home/lsc/IdeaProjects/dockerNetwork/front/src/components/Plan/PlanList.vue"],"sourcesContent":["<template>\n  <div class=\"plan-section\">\n    <div v-if=\"plansRef.length === 0\" class=\"text-center text-gray-500\">暂无数据</div>\n    <div class=\"table-wrapper\">\n      <el-table :data=\"plansRef\" style=\"width: 100%\">\n        <el-table-column label=\"操作\" width=\"200\" fixed=\"right\">\n          <template #default=\"{ row }\">\n            <!-- 使用 flex 排列按钮 -->\n            <div class=\"button-group\">\n              <el-button size=\"small\" type=\"primary\" @click=\"viewPlan(row)\">查看</el-button>\n              <el-button size=\"small\" type=\"success\" @click=\"executePlan(row)\">执行</el-button>\n            </div>\n          </template>\n        </el-table-column>\n\n        <el-table-column label=\"#\" type=\"index\" width=\"50\" />\n        <el-table-column label=\"ID\" prop=\"id\" />\n        <el-table-column label=\"名称\" prop=\"name\" />\n        <el-table-column label=\"类型\" prop=\"type\" />\n      </el-table>\n    </div>\n\n    <!-- Plan Detail Dialog -->\n    <el-dialog v-model=\"dialogVisible\" title=\"计划详情\" width=\"500px\" :close-on-click-modal=\"false\">\n      <div v-if=\"selectedPlan\">\n        <p><strong>ID:</strong> {{ selectedPlan.id }}</p>\n        <p><strong>名称:</strong> {{ selectedPlan.name }}</p>\n        <p><strong>类型:</strong> {{ selectedPlan.type }}</p>\n        <p><strong>描述:</strong> {{ selectedPlan.description }}</p>\n        <p><strong>大小:</strong> {{ selectedPlan.size }}</p>\n        <p><strong>时间:</strong> {{ selectedPlan.time }}</p>\n        <p><strong>数量:</strong> {{ selectedPlan.num }}</p>\n        <p><strong>速度:</strong> {{ selectedPlan.velocity }}</p>\n        <p><strong>容器1:</strong> {{ selectedPlan.container1 }}</p>\n        <p><strong>容器2:</strong> {{ selectedPlan.container2 }}</p>\n        <p><strong>容器2 IP:</strong> {{ selectedPlan.container2Ip }}</p>\n      </div>\n      <template #footer>\n        <el-button @click=\"dialogVisible = false\">关闭</el-button>\n      </template>\n    </el-dialog>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted, onBeforeUnmount } from 'vue'\nimport axios from 'axios'\nimport { ElMessage } from 'element-plus'\n\nconst plansRef = ref([])\nconst dialogVisible = ref(false)\nconst selectedPlan = ref(null)\n\nconst fetchPlans = async () => {\n  try {\n    const response = await axios.get('http://localhost:8081/plan/list')\n    plansRef.value = response.data.records || []\n  } catch (error) {\n    ElMessage.error('获取计划数据失败')\n    console.error(error)\n  }\n}\n\nconst refreshPlans = () => {\n  fetchPlans()\n}\n\nlet intervalId = null\nonMounted(() => {\n  intervalId = setInterval(() => {\n    refreshPlans()\n  }, 1000)\n})\n\nonBeforeUnmount(() => {\n  if (intervalId) {\n    clearInterval(intervalId)\n  }\n})\n\nconst viewPlan = (plan) => {\n  selectedPlan.value = plan\n  dialogVisible.value = true\n}\n\nconst executePlan = (plan) => {\n  // 执行计划的逻辑，可以替换为你需要的操作\n  ElMessage.success(`执行计划: ${plan.name}`)\n  console.log(`正在执行计划: ${plan.name}`)\n  // 例如，你可以调用一个 API 执行计划，或者其他业务逻辑\n}\n</script>\n\n<style scoped>\n.plan-section {\n  flex: 1;\n  overflow-y: auto;\n  padding-right: 8px;\n}\n\n.table-wrapper {\n  flex: 1;\n  overflow-y: auto;\n  padding-right: 10px;\n}\n\n.el-table th {\n  background-color: #f1f5f9;\n  color: #333;\n  font-weight: bold;\n}\n\n.text-center {\n  text-align: center;\n}\n\n/* 按钮组的容器 */\n.button-group {\n  display: flex;\n  justify-content: space-between; /* 确保按钮平行排列 */\n  gap: 10px; /* 按钮之间的间隔 */\n}\n\n.el-button {\n  flex: 1; /* 使按钮具有相同的宽度 */\n}\n</style>\n"],"mappings":"AA6CA,SAASA,GAAG,EAAEC,SAAS,EAAEC,eAAe,QAAQ,KAAI;AACpD,OAAOC,KAAK,MAAM,OAAM;AACxB,SAASC,SAAS,QAAQ,cAAa;;;;;;;IAEvC,MAAMC,QAAQ,GA