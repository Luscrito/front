{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport { ref, nextTick, computed } from 'vue';\nimport axios from 'axios';\nimport { ElMessage } from 'element-plus';\nimport DockerContainers from '@/components/Container/DockerContainers.vue';\nexport default {\n  __name: 'ViewFirewallRulesDialog',\n  setup(__props, {\n    expose: __expose\n  }) {\n    const dialogVisible = ref(false);\n    const containerName = ref('');\n    const chain = ref('');\n    const rules = ref([]);\n    const loading = ref(false);\n    const containers = ref([]);\n    const containersRef = ref(null);\n    const headers = ref([]);\n\n    // 弹窗打开时初始化\n    const openDialog = async () => {\n      dialogVisible.value = true;\n      containerName.value = ''; // 重置节点名称\n      chain.value = ''; // 重置链名称\n      await nextTick();\n      if (containersRef.value) {\n        await containersRef.value.fetchContainers();\n        containers.value = containersRef.value.containers || [];\n      }\n    };\n    __expose({\n      openDialog\n    });\n    const handleViewRules = async () => {\n      if (!containerName.value) {\n        ElMessage.warning('请选择节点');\n        return;\n      }\n      loading.value = true;\n      try {\n        const response = await axios.get('http://localhost:8081/firewall/list', {\n          params: {\n            containerName: containerName.value,\n            chain: chain.value\n          }\n        });\n        const lines = response.data.split('\\n').map(line => line.trim()).filter(line => line.length > 0);\n        if (lines.length < 2) {\n          rules.value = [];\n          headers.value = [];\n          return;\n        }\n\n        // 第二行作为表头字段\n        const headerLine = lines[1];\n        headers.value = headerLine.split(/\\s+/);\n\n        // 剩下的作为数据\n        const ruleLines = lines.slice(2);\n        rules.value = ruleLines.map(line => {\n          const parts = line.split(/\\s+/);\n          const obj = {};\n          parts.forEach((p, idx) => {\n            obj[`field${idx}`] = p;\n          });\n          return obj;\n        });\n      } catch (err) {\n        ElMessage.error(`获取规则失败：${err?.response?.data || err.message}`);\n      } finally {\n        loading.value = false;\n      }\n    };\n\n    // 计算可用的运行中节点\n    const availableContainers = computed(() => {\n      return containers.value.filter(c => c.status?.includes('Up'));\n    });\n    const formatContainerName = name => {\n      return name.replace(/^\\//, '');\n    };\n    const formatStatus = status => {\n      return status?.includes('Up') ? '运行中' : '已停止';\n    };\n    const __returned__ = {\n      dialogVisible,\n      containerName,\n      chain,\n      rules,\n      loading,\n      containers,\n      containersRef,\n      headers,\n      openDialog,\n      handleViewRules,\n      availableContainers,\n      formatContainerName,\n      formatStatus,\n      ref,\n      nextTick,\n      computed,\n      get axios() {\n        return axios;\n      },\n      get ElMessage() {\n        return ElMessage;\n      },\n      DockerContainers\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","nextTick","computed","axios","ElMessage","DockerContainers","dialogVisible","containerName","chain","rules","loading","containers","containersRef","headers","openDialog","value","fetchContainers","__expose","handleViewRules","warning","response","get","params","lines","data","split","map","line","trim","filter","length","headerLine","ruleLines","slice","parts","obj","forEach","p","idx","err","error","message","availableContainers","c","status","includes","formatContainerName","name","replace","formatStatus"],"sources":["/home/lsc/IdeaProjects/dockerNetwork/front/src/components/Firewall/ViewFirewallRulesDialog.vue"],"sourcesContent":["<template>\n  <el-dialog\n      v-model=\"dialogVisible\"\n      title=\"查看防火墙规则\"\n      width=\"800px\"\n      @close=\"rules = []\"\n  >\n    <!-- 节点选择 -->\n    <el-form :inline=\"true\" class=\"mb-4\">\n      <el-form-item label=\"节点名称\" required>\n        <el-select v-model=\"containerName\" placeholder=\"选择节点\" clearable filterable class=\"full-width\">\n          <el-option\n              v-for=\"container in availableContainers\"\n              :key=\"container.id\"\n              :value=\"formatContainerName(container.name)\"\n          >\n            <span class=\"container-option\">\n              <span class=\"name\">{{ formatContainerName(container.name) }}</span>\n              <span class=\"status running\">\n                {{ formatStatus(container.status) }}\n              </span>\n            </span>\n          </el-option>\n        </el-select>\n      </el-form-item>\n\n      <el-form-item label=\"链名称\" required>\n        <el-select v-model=\"chain\" placeholder=\"选择链\" style=\"width: 160px\">\n          <el-option label=\"INPUT\" value=\"INPUT\" />\n          <el-option label=\"OUTPUT\" value=\"OUTPUT\" />\n          <el-option label=\"FORWARD\" value=\"FORWARD\" />\n        </el-select>\n      </el-form-item>\n\n      <el-form-item>\n        <el-button type=\"primary\" @click=\"handleViewRules\">查看</el-button>\n      </el-form-item>\n    </el-form>\n\n    <!-- 表格展示 -->\n    <el-table :data=\"rules\" v-loading=\"loading\" style=\"width: 100%\">\n      <el-table-column label=\"#\" type=\"index\" width=\"50\" />\n      <el-table-column\n          v-for=\"(header, idx) in headers\"\n          :key=\"idx\"\n          :prop=\"'field' + idx\"\n          :label=\"header\"\n      />\n    </el-table>\n\n    <template #footer>\n      <el-button @click=\"dialogVisible = false\">关闭</el-button>\n    </template>\n\n    <DockerContainers ref=\"containersRef\" style=\"display: none\" />\n  </el-dialog>\n</template>\n\n<script setup>\nimport {ref, defineExpose, nextTick, computed} from 'vue'\nimport axios from 'axios'\nimport { ElMessage } from 'element-plus'\nimport DockerContainers from '@/components/Container/DockerContainers.vue'\n\nconst dialogVisible = ref(false)\nconst containerName = ref('')\nconst chain = ref('')\nconst rules = ref([])\nconst loading = ref(false)\nconst containers = ref([])\nconst containersRef = ref(null)\nconst headers = ref([])\n\n// 弹窗打开时初始化\nconst openDialog = async () => {\n  dialogVisible.value = true\n  containerName.value = ''  // 重置节点名称\n  chain.value = ''  // 重置链名称\n  await nextTick()\n  if (containersRef.value) {\n    await containersRef.value.fetchContainers()\n    containers.value = containersRef.value.containers || []\n  }\n}\ndefineExpose({ openDialog })\n\nconst handleViewRules = async () => {\n  if (!containerName.value) {\n    ElMessage.warning('请选择节点')\n    return\n  }\n\n  loading.value = true\n  try {\n    const response = await axios.get('http://localhost:8081/firewall/list', {\n      params: {\n        containerName: containerName.value,\n        chain: chain.value,\n      },\n    })\n\n    const lines = response.data\n        .split('\\n')\n        .map(line => line.trim())\n        .filter(line => line.length > 0)\n\n    if (lines.length < 2) {\n      rules.value = []\n      headers.value = []\n      return\n    }\n\n    // 第二行作为表头字段\n    const headerLine = lines[1]\n    headers.value = headerLine.split(/\\s+/)\n\n    // 剩下的作为数据\n    const ruleLines = lines.slice(2)\n    rules.value = ruleLines.map(line => {\n      const parts = line.split(/\\s+/)\n      const obj = {}\n      parts.forEach((p, idx) => {\n        obj[`field${idx}`] = p\n      })\n      return obj\n    })\n\n  } catch (err) {\n    ElMessage.error(`获取规则失败：${err?.response?.data || err.message}`)\n  } finally {\n    loading.value = false\n  }\n}\n\n// 计算可用的运行中节点\nconst availableContainers = computed(() => {\n  return containers.value.filter(c => c.status?.includes('Up'))\n})\n\nconst formatContainerName = (name) => {\n  return name.replace(/^\\//, '')\n}\n\nconst formatStatus = (status) => {\n  return status?.includes('Up') ? '运行中' : '已停止'\n}\n\n</script>\n\n<style scoped>\n.mb-4 {\n  margin-bottom: 16px;\n}\n\n.full-width {\n  width: 100%;\n}\n\n.container-option {\n  display: flex;\n  justify-content: space-between;\n  width: 100%;\n}\n\n.status {\n  font-size: 12px;\n  padding: 2px 8px;\n  border-radius: 4px;\n}\n\n.status.running {\n  color: #67C23A;\n  background: #f0f9eb;\n}\n</style>\n"],"mappings":";;;;AA2DA,SAAQA,GAAiB,EAAEC,QAAQ,EAAEC,QAAQ,QAAO,KAAI;AACxD,OAAOC,KAAK,MAAM,OAAM;AACxB,SAASC,SAAS,QAAQ,cAAa;AACvC,OAAOC,gBAAgB,MAAM,6CAA4C;;;;;;IAEzE,MAAMC,aAAa,GAAGN,GAAG,CAAC,KAAK;IAC/B,MAAMO,aAAa,GAAGP,GAAG,CAAC,EAAE;IAC5B,MAAMQ,KAAK,GAAGR,GAAG,CAAC,EAAE;IACpB,MAAMS,KAAK,GAAGT,GAAG,CAAC,EAAE;IACpB,MAAMU,OAAO,GAAGV,GAAG,CAAC,KAAK;IACzB,MAAMW,UAAU,GAAGX,GAAG,CAAC,EAAE;IACzB,MAAMY,aAAa,GAAGZ,GAAG,CAAC,IAAI;IAC9B,MAAMa,OAAO,GAAGb,GAAG,CAAC,EAAE;;IAEtB;IACA,MAAMc,UAAU,GAAG,MAAAA,CAAA,KAAY;MAC7BR,aAAa,CAACS,KAAK,GAAG,IAAG;MACzBR,aAAa,CAACQ,KAAK,GAAG,EAAE,EAAE;MAC1BP,KAAK,CAACO,KAAK,GAAG,EAAE,EAAE;MAClB,MAAMd,QAAQ,CAAC;MACf,IAAIW,aAAa,CAACG,KAAK,EAAE;QACvB,MAAMH,aAAa,CAACG,KAAK,CAACC,eAAe,CAAC;QAC1CL,UAAU,CAACI,KAAK,GAAGH,aAAa,CAACG,KAAK,CAACJ,UAAU,IAAI,EAAC;MACxD;IACF;IACAM,QAAY,CAAC;MAAEH;IAAW,CAAC;IAE3B,MAAMI,eAAe,GAAG,MAAAA,CAAA,KAAY;MAClC,IAAI,CAACX,aAAa,CAACQ,KAAK,EAAE;QACxBX,SAAS,CAACe,OAAO,CAAC,OAAO;QACzB;MACF;MAEAT,OAAO,CAACK,KAAK,GAAG,IAAG;MACnB,IAAI;QACF,MAAMK,QAAQ,GAAG,MAAMjB,KAAK,CAACkB,GAAG,CAAC,qCAAqC,EAAE;UACtEC,MAAM,EAAE;YACNf,aAAa,EAAEA,aAAa,CAACQ,KAAK;YAClCP,KAAK,EAAEA,KAAK,CAACO;UACf;QACF,CAAC;QAED,MAAMQ,KAAK,GAAGH,QAAQ,CAACI,IAAG,CACrBC,KAAK,CAAC,IAAI,EACVC,GAAG,CAACC,IAAI,IAAIA,IAAI,CAACC,IAAI,CAAC,CAAC,EACvBC,MAAM,CAACF,IAAI,IAAIA,IAAI,CAACG,MAAM,GAAG,CAAC;QAEnC,IAAIP,KAAK,CAACO,MAAM,GAAG,CAAC,EAAE;UACpBrB,KAAK,CAACM,KAAK,GAAG,EAAC;UACfF,OAAO,CAACE,KAAK,GAAG,EAAC;UACjB;QACF;;QAE