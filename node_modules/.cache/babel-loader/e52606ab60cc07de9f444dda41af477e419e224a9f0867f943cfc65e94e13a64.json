{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport axios from 'axios';\nimport { ElMessage } from 'element-plus';\nconst pageSize = 3;\nexport default {\n  __name: 'PlanList',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const plansRef = ref([]);\n    const total = ref(0);\n    const pageNum = ref(1);\n    const fetchPlans = async () => {\n      try {\n        const response = await axios.get('http://localhost:8081/plan/list', {\n          params: {\n            pageNum: pageNum.value,\n            pageSize: pageSize\n          }\n        });\n        plansRef.value = response.data.records || [];\n        total.value = response.data.total || 0;\n      } catch (error) {\n        ElMessage.error('获取计划数据失败');\n        console.error(error);\n      }\n    };\n    const handlePageChange = newPage => {\n      pageNum.value = newPage;\n      fetchPlans();\n    };\n    onMounted(() => {\n      fetchPlans();\n    });\n    const viewPlan = plan => {\n      alert(`ID: ${plan.id}\n名称: ${plan.name}\n类型: ${plan.type}\n描述: ${plan.description}\n大小: ${plan.size}\n时间: ${plan.time}\n数量: ${plan.num}\n速度: ${plan.velocity}\n容器1: ${plan.container1}\n容器2: ${plan.container2}\n容器2 IP: ${plan.container2Ip}`);\n    };\n    const __returned__ = {\n      plansRef,\n      total,\n      pageSize,\n      pageNum,\n      fetchPlans,\n      handlePageChange,\n      viewPlan,\n      ref,\n      onMounted,\n      get axios() {\n        return axios;\n      },\n      get ElMessage() {\n        return ElMessage;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","axios","ElMessage","pageSize","plansRef","total","pageNum","fetchPlans","response","get","params","value","data","records","error","console","handlePageChange","newPage","viewPlan","plan","alert","id","name","type","description","size","time","num","velocity","container1","container2","container2Ip"],"sources":["/home/lsc/IdeaProjects/dockerNetwork/front/src/components/Plan/PlanList.vue"],"sourcesContent":["<template>\n  <div class=\"plan-section\">\n    <div v-if=\"plansRef.length === 0\" class=\"text-center text-gray-500\">暂无数据</div>\n    <div class=\"table-wrapper\">\n      <el-table :data=\"plansRef\" style=\"width: 100%\">\n        <el-table-column label=\"操作\" width=\"100\" fixed=\"right\">\n          <template #default=\"{ row }\">\n            <el-button size=\"small\" type=\"primary\" @click=\"viewPlan(row)\">查看</el-button>\n          </template>\n        </el-table-column>\n\n        <el-table-column label=\"#\" type=\"index\" width=\"50\" />\n        <el-table-column label=\"ID\" prop=\"id\" />\n        <el-table-column label=\"名称\" prop=\"name\" />\n        <el-table-column label=\"类型\" prop=\"type\" />\n      </el-table>\n\n      <div class=\"pagination-wrapper\">\n        <el-pagination\n            background\n            layout=\"prev, pager, next, jumper\"\n            :total=\"total\"\n            :page-size=\"pageSize\"\n            :current-page=\"pageNum\"\n            @current-change=\"handlePageChange\"\n        />\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted } from 'vue'\nimport axios from 'axios'\nimport { ElMessage } from 'element-plus'\n\nconst plansRef = ref([])\nconst total = ref(0)\nconst pageSize = 3\nconst pageNum = ref(1)\n\nconst fetchPlans = async () => {\n  try {\n    const response = await axios.get('http://localhost:8081/plan/list', {\n      params: {\n        pageNum: pageNum.value,\n        pageSize: pageSize\n      }\n    })\n    plansRef.value = response.data.records || []\n    total.value = response.data.total || 0\n  } catch (error) {\n    ElMessage.error('获取计划数据失败')\n    console.error(error)\n  }\n}\n\nconst handlePageChange = (newPage) => {\n  pageNum.value = newPage\n  fetchPlans()\n}\n\nonMounted(() => {\n  fetchPlans()\n})\n\nconst viewPlan = (plan) => {\n  alert(`ID: ${plan.id}\n名称: ${plan.name}\n类型: ${plan.type}\n描述: ${plan.description}\n大小: ${plan.size}\n时间: ${plan.time}\n数量: ${plan.num}\n速度: ${plan.velocity}\n容器1: ${plan.container1}\n容器2: ${plan.container2}\n容器2 IP: ${plan.container2Ip}`)\n}\n</script>\n\n<style scoped>\n.plan-section {\n  flex: 1;\n  overflow-y: auto;\n  padding-right: 8px;\n}\n\n.table-wrapper {\n  flex: 1;\n  overflow-y: auto;\n  padding-right: 10px;\n}\n\n.pagination-wrapper {\n  margin-top: 16px;\n  display: flex;\n  justify-content: center;\n}\n\n.el-table th {\n  background-color: #f1f5f9;\n  color: #333;\n  font-weight: bold;\n}\n\n.text-center {\n  text-align: center;\n}\n\n.el-button {\n  transition: background-color 0.3s ease;\n}\n\n.el-button:hover {\n  background-color: #34d399;\n}\n</style>\n"],"mappings":"AAgCA,SAASA,GAAG,EAAEC,SAAS,QAAQ,KAAI;AACnC,OAAOC,KAAK,MAAM,OAAM;AACxB,SAASC,SAAS,QAAQ,cAAa;AAIvC,MAAMC,QAAQ,GAAG;;;;;;;IAFjB,MAAMC,QAAQ,GAAGL,GAAG,CAAC,EAAE;IACvB,MAAMM,KAAK,GAAGN,GAAG,CAAC,CAAC;IAEnB,MAAMO,OAAO,GAAGP,GAAG,CAAC,CAAC;IAErB,MAAMQ,UAAU,GAAG,MAAAA,CAAA,KAAY;MAC7B,IAAI;QACF,MAAMC,QAAQ,GAAG,MAAMP,KAAK,CAACQ,GAAG,CAAC,iCAAiC,EAAE;UAClEC,MAAM,EAAE;YACNJ,OAAO,EAAEA,OAAO,CAACK,KAAK;YACtBR,QAAQ,EAAEA;UACZ;QACF,CAAC;QACDC,QAAQ,CAACO,KAAK,GAAGH,QAAQ,CAACI,IAAI,CAACC,OAAO,IAAI,EAAC;QAC3CR,KAAK,CAACM,KAAK,GAAGH,QAAQ,CAACI,IAAI,CAACP,KAAK,IAAI;MACvC,CAAC,CAAC,OAAOS,KAAK,EAAE;QACdZ,SAAS,CAACY,KAAK,CAAC,UAAU;QAC1BC,OAAO,CAACD,KAAK,CAACA,KAAK;MACrB;IACF;IAEA,MAAME,gBAAgB,GAAIC,OAAO,IAAK;MACpCX,OAAO,CAACK,KAAK,GAAGM,OAAM;MACtBV,UAAU,CAAC;IACb;IAEAP,SAAS,CAAC,MAAM;MACdO,UAAU,CAAC;IACb,CAAC;IAED,MAAMW,QAAQ,GAAIC,IAAI,IAAK;MACzBC,KAAK,CAAC,OAAOD,IAAI,CAACE,EAAE;AACtB,MAAMF,IAAI,CAACG,IAAI;AACf,MAAMH,IAAI,CAACI,IAAI;AACf,MAAMJ,IAAI,CAACK,WAAW;AACtB,MAAML,IAAI,CAACM,IAAI;AACf,MAAMN,IAAI,CAACO,IAAI;AACf,MAAMP,IAAI,CAACQ,GAAG;AACd,MAAMR,IAAI,CAACS,QAAQ;AACnB,OAAOT,IAAI,CAACU,UAAU;AACtB,OAAOV,IAAI,CAACW,UAAU;AACtB,UAAUX,IAAI,CAACY,YAAY,EAAE;IAC7