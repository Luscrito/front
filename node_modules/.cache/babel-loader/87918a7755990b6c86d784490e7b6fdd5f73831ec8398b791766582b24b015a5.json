 ref(null);\n    const startContainerDialogRef = ref(null);\n    const stopContainerDialogRef = ref(null);\n    const addNetworkDialogRef = ref(null);\n    const deleteNetworkDialogRef = ref(null);\n    const addRouteDialogRef = ref(null);\n    const deleteRouteDialogRef = ref(null);\n    const dynamicConfigDialogRef = ref(null);\n    const resetRouteDialogRef = ref(null);\n    const autoConfigDialogRef = ref(null);\n    const addFirewallRuleDialogRef = ref(null);\n    const viewFirewallRulesDialogRef = ref(null);\n    const deleteFirewallRulesDialogRef = ref(null);\n    const clearFirewallRulesDialogRef = ref(null);\n    const networkParamDialogRef = ref(null);\n    const sourceParamDialogRef = ref(null);\n    const __returned__ = {\n      addContainerDialogRef,\n      deleteContainerDialogRef,\n      startContainerDialogRef,\n      stopContainerDialogRef,\n      addNetworkDialogRef,\n      deleteNetworkDialogRef,\n      addRouteDialogRef,\n      deleteRouteDialogRef,\n      dynamicConfigDialogRef,\n      resetRouteDialogRef,\n      autoConfigDialogRef,\n      addFirewallRuleDialogRef,\n      viewFirewallRulesDialogRef,\n      deleteFirewallRulesDialogRef,\n      clearFirewallRulesDialogRef,\n      networkParamDialogRef,\n      sourceParamDialogRef,\n      ref,\n      get Cpu() {\n        return Cpu;\n      },\n      get Share() {\n        return Share;\n      },\n      get Monitor() {\n        return Monitor;\n      },\n      get PieChart() {\n        return PieChart;\n      },\n      get Guide() {\n        return Guide;\n      },\n      get Lock() {\n        return Lock;\n      },\n      get Setting() {\n        return Setting;\n      },\n      get DocumentChecked() {\n        return DocumentChecked;\n      },\n      get Warning() {\n        return Warning;\n      },\n      AddContainerDialog,\n      DeleteContainerDialog,\n      StartContainerDialog,\n      StopContainerDialog,\n      ContainerList,\n      ContainerDetailDialog,\n      AddNetworkDialog,\n      D