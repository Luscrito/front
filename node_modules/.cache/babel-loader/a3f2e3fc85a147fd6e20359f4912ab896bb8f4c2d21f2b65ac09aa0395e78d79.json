{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport axios from 'axios';\nimport { ElMessage } from 'element-plus';\nexport default {\n  __name: 'PlanList',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const plans = ref([]);\n\n    // 获取计划列表\n    const fetchPlans = async () => {\n      try {\n        const response = await axios.get('http://localhost:8081/plan/list');\n        plans.value = response.data.records || [];\n      } catch (error) {\n        ElMessage.error('获取计划数据失败');\n        console.error(error);\n      }\n    };\n    onMounted(fetchPlans);\n\n    // 执行计划\n    const executePlan = async planId => {\n      try {\n        const response = await axios.post(`http://localhost:8081/plan/execute/${planId}`);\n        ElMessage.success(`计划ID ${planId} 执行成功：${response.data}`);\n      } catch (err) {\n        ElMessage.error(`执行计划失败：${err?.response?.data || err.message}`);\n      }\n    };\n    const __returned__ = {\n      plans,\n      fetchPlans,\n      executePlan,\n      ref,\n      onMounted,\n      get axios() {\n        return axios;\n      },\n      get ElMessage() {\n        return ElMessage;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","axios","ElMessage","plans","fetchPlans","response","get","value","data","records","error","console","executePlan","planId","post","success","err","message"],"sources":["/home/lsc/IdeaProjects/dockerNetwork/front/src/components/Plan/PlanList.vue"],"sourcesContent":["<template>\n  <div class=\"p-4\">\n    <div v-if=\"plans.length === 0\" class=\"text-center text-gray-500\">暂无数据</div>\n    <el-table :data=\"plans\" style=\"width: 100%\">\n      <!-- 执行按钮列 -->\n      <el-table-column label=\"操作\" width=\"100\" fixed=\"right\">\n        <template #default=\"{ row }\">\n          <el-button size=\"small\" type=\"success\" @click=\"executePlan(row.id)\">执行</el-button>\n        </template>\n      </el-table-column>\n\n      <!-- 索引列 -->\n      <el-table-column label=\"#\" type=\"index\" width=\"50\" />\n\n      <!-- 计划字段展示 -->\n      <el-table-column label=\"ID\" prop=\"id\" />\n      <el-table-column label=\"名称\" prop=\"name\" />\n      <el-table-column label=\"类型\" prop=\"type\" />\n      <el-table-column label=\"大小\" prop=\"size\" />\n      <el-table-column label=\"时间\" prop=\"time\" />\n      <el-table-column label=\"数量\" prop=\"num\" />\n      <el-table-column label=\"速度\" prop=\"velocity\" />\n      <el-table-column label=\"容器1\" prop=\"container1\" />\n      <el-table-column label=\"容器2\" prop=\"container2\" />\n      <el-table-column label=\"容器2 IP\" prop=\"container2Ip\" />\n    </el-table>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted } from 'vue'\nimport axios from 'axios'\nimport { ElMessage } from 'element-plus'\n\nconst plans = ref([])\n\n// 获取计划列表\nconst fetchPlans = async () => {\n  try {\n    const response = await axios.get('http://localhost:8081/plan/list')\n    plans.value = response.data.records || []\n  } catch (error) {\n    ElMessage.error('获取计划数据失败')\n    console.error(error)\n  }\n}\n\nonMounted(fetchPlans)\n\n// 执行计划\nconst executePlan = async (planId) => {\n  try {\n    const response = await axios.post(`http://localhost:8081/plan/execute/${planId}`)\n    ElMessage.success(`计划ID ${planId} 执行成功：${response.data}`)\n  } catch (err) {\n    ElMessage.error(`执行计划失败：${err?.response?.data || err.message}`)\n  }\n}\n</script>\n\n<style scoped>\n.el-table th {\n  background-color: #f1f5f9;\n  color: #333;\n  font-weight: bold;\n}\n\n.el-button {\n  transition: background-color 0.3s ease;\n}\n\n.el-button:hover {\n  background-color: #34d399;\n}\n\n.text-center {\n  text-align: center;\n}\n</style>\n"],"mappings":"AA8BA,SAASA,GAAG,EAAEC,SAAS,QAAQ,KAAI;AACnC,OAAOC,KAAK,MAAM,OAAM;AACxB,SAASC,SAAS,QAAQ,cAAa;;;;;;;IAEvC,MAAMC,KAAK,GAAGJ,GAAG,CAAC,EA