{"ast":null,"code":"import { ref } from 'vue';\nimport axios from 'axios';\nimport { ElMessage } from 'element-plus';\nexport default {\n  __name: 'AddPlanDialog',\n  emits: ['success'],\n  setup(__props, {\n    expose: __expose,\n    emit: __emit\n  }) {\n    __expose();\n    const emit = __emit;\n    const dialogVisible = ref(false);\n    const formRef = ref(null);\n    const form = ref({\n      id: null,\n      name: '',\n      type: '',\n      size: null,\n      time: '',\n      num: null,\n      velocity: '',\n      container1: '',\n      container2: '',\n      container2Ip: ''\n    });\n    const rules = {\n      name: [{\n        required: true,\n        message: '请输入名称',\n        trigger: 'blur'\n      }],\n      type: [{\n        required: true,\n        message: '请输入类型',\n        trigger: 'blur'\n      }],\n      size: [{\n        required: true,\n        message: '请输入大小',\n        trigger: 'blur'\n      }],\n      time: [{\n        required: true,\n        message: '请输入时间',\n        trigger: 'blur'\n      }],\n      num: [{\n        required: true,\n        message: '请输入数量',\n        trigger: 'blur'\n      }]\n    };\n    const submitForm = () => {\n      formRef.value.validate(async valid => {\n        if (valid) {\n          try {\n            const response = await axios.post('http://localhost:8081/plan/add', form.value);\n            if (response.data === '添加成功') {\n              ElMessage.success('添加成功');\n              dialogVisible.value = false;\n              emit('success'); // 通知父组件刷新\n              resetForm();\n            } else {\n              ElMessage.warning(response.data);\n            }\n          } catch (error) {\n            ElMessage.error('添加失败');\n            console.error(error);\n          }\n        }\n      });\n    };\n    const resetForm = () => {\n      form.value = {\n        id: null,\n        name: '',\n        type: '',\n        size: null,\n        time: '',\n        num: null,\n        velocity: '',\n        container1: '',\n        container2: '',\n        container2Ip: ''\n      };\n    };\n    const __returned__ = {\n      emit,\n      dialogVisible,\n      formRef,\n      form,\n      rules,\n      submitForm,\n      resetForm,\n      ref,\n      get axios() {\n        return axios;\n      },\n      get ElMessage() {\n        return ElMessage;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","axios","ElMessage","emit","__emit","dialogVisible","formRef","form","id","name","type","size","time","num","velocity","container1","container2","container2Ip","rules","required","message","trigger","submitForm","value","validate","valid","response","post","data","success","resetForm","warning","error","console"],"sources":["/home/lsc/IdeaProjects/dockerNetwork/front/src/components/Plan/AddPlanDialog.vue"],"sourcesContent":["<template>\n  <div>\n    <el-button type=\"primary\" @click=\"dialogVisible = true\">添加测试计划</el-button>\n\n    <el-dialog v-model=\"dialogVisible\" title=\"添加计划\" width=\"600px\" :close-on-click-modal=\"false\">\n      <el-form :model=\"form\" :rules=\"rules\" ref=\"formRef\" label-width=\"100px\">\n        <el-form-item label=\"计划名称\" prop=\"name\">\n          <el-input v-model=\"form.name\" />\n        </el-form-item>\n        <el-form-item label=\"类型\" prop=\"type\">\n          <el-input v-model=\"form.type\" />\n        </el-form-item>\n        <el-form-item label=\"大小\" prop=\"size\">\n          <el-input-number v-model=\"form.size\" :min=\"0\" />\n        </el-form-item>\n        <el-form-item label=\"时间\" prop=\"time\">\n          <el-input v-model=\"form.time\" />\n        </el-form-item>\n        <el-form-item label=\"数量\" prop=\"num\">\n          <el-input-number v-model=\"form.num\" :min=\"1\" />\n        </el-form-item>\n        <el-form-item label=\"速度\" prop=\"velocity\">\n          <el-input v-model=\"form.velocity\" />\n        </el-form-item>\n        <el-form-item label=\"容器1\" prop=\"container1\">\n          <el-input v-model=\"form.container1\" />\n        </el-form-item>\n        <el-form-item label=\"容器2\" prop=\"container2\">\n          <el-input v-model=\"form.container2\" />\n        </el-form-item>\n        <el-form-item label=\"容器2 IP\" prop=\"container2Ip\">\n          <el-input v-model=\"form.container2Ip\" />\n        </el-form-item>\n      </el-form>\n\n      <template #footer>\n        <el-button @click=\"dialogVisible = false\">取消</el-button>\n        <el-button type=\"primary\" @click=\"submitForm\">提交</el-button>\n      </template>\n    </el-dialog>\n  </div>\n</template>\n\n<script setup>\nimport { ref } from 'vue'\nimport axios from 'axios'\nimport { ElMessage } from 'element-plus'\n\nconst emit = defineEmits(['success'])\n\nconst dialogVisible = ref(false)\n\nconst formRef = ref(null)\nconst form = ref({\n  id: null,\n  name: '',\n  type: '',\n  size: null,\n  time: '',\n  num: null,\n  velocity: '',\n  container1: '',\n  container2: '',\n  container2Ip: '',\n})\n\nconst rules = {\n  name: [{ required: true, message: '请输入名称', trigger: 'blur' }],\n  type: [{ required: true, message: '请输入类型', trigger: 'blur' }],\n  size: [{ required: true, message: '请输入大小', trigger: 'blur' }],\n  time: [{ required: true, message: '请输入时间', trigger: 'blur' }],\n  num: [{ required: true, message: '请输入数量', trigger: 'blur' }],\n}\n\nconst submitForm = () => {\n  formRef.value.validate(async (valid) => {\n    if (valid) {\n      try {\n        const response = await axios.post('http://localhost:8081/plan/add', form.value)\n        if (response.data === '添加成功') {\n          ElMessage.success('添加成功')\n          dialogVisible.value = false\n          emit('success') // 通知父组件刷新\n          resetForm()\n        } else {\n          ElMessage.warning(response.data)\n        }\n      } catch (error) {\n        ElMessage.error('添加失败')\n        console.error(error)\n      }\n    }\n  })\n}\n\nconst resetForm = () => {\n  form.value = {\n    id: null,\n    name: '',\n    type: '',\n    size: null,\n    time: '',\n    num: null,\n    velocity: '',\n    container1: '',\n    container2: '',\n    container2Ip: '',\n  }\n}\n</script>\n"],"mappings":"AA4CA,SAASA,GAAG,QAAQ,KAAI;AACxB,OAAOC,KAAK,MAAM,OAAM;AACxB,SAASC,SAAS,QAAQ,cAAa;;;;;;;;;IAEvC,MAAMC,IAAI,GAAGC,MAAA;IAEb,MAAMC,aAAa,GAAGL,GAAG,CAAC,KAAK;IAE/B,MAAMM,OAAO,GAAGN,GAAG,CAAC,IAAI;IACxB,MAAMO,IAAI,GAAGP,GAAG,CAAC;MACfQ,EAAE,EAAE,IAAI;MACRC,IAAI,EAAE,EAAE;MACRC,IAAI,EAAE,EAAE;MACRC,IAAI,EAAE,IAAI;MACVC,IAAI,EAAE,EAAE;MACRC,GAAG,EAAE,IAAI;MACTC,QAAQ,EAAE,EAAE;MACZC,UAAU,EAAE,EAAE;MACdC,UAAU,EAAE,EAAE;MACdC,YAAY,EAAE;IAChB,CAAC;IAED,MAAMC,KAAK,GAAG;MACZT,IAAI,EAAE,CAAC;QAAEU,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,OAAO;QAAEC,OAAO,EAAE;MAAO,CAAC,CAAC;MAC7DX,IAAI,EAAE,CAAC;QAAES,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,OAAO;QAAEC,OAAO,EAAE;MAAO,CAAC,CAAC;MAC7DV,IAAI,EAAE,CAAC;QAAEQ,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,OAAO;QAAEC,OAAO,EAAE;MAAO,CAAC,CAAC;MAC7DT,IAAI,EAAE,CAAC;QAAEO,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,OAAO;QAAEC,OAAO,EAAE;MAAO,CAAC,CAAC;MAC7DR,GAAG,EAAE,CAAC;QAAEM,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,OAAO;QAAEC,OAAO,EAAE;MAAO,CAAC;IAC7D;IAEA,MAAMC,UAAU,GAAGA,CAAA,KAAM;MACvBhB,OAAO,CAACiB,KAAK,CAACC,QAAQ,CAAC,MAAOC,KAAK,IAAK;QACtC,IAAIA,KAAK,EAAE;UACT,IAAI;YACF,MAAMC,QAAQ,GAAG,MAAMzB,KAAK,CAAC0B,IAAI,CAAC,gCAAgC,EAAEpB,IAAI,CAACgB,KAAK;YAC9E,IAAIG,QAAQ,CAACE,IAAI,KAAK,MAAM,EAAE;cAC5B1B,SAAS,CAAC2B,OAAO,CAAC,MAAM;cACxBxB,aAAa,CAACkB,KAAK,GAAG,KAAI;cAC1BpB,IAAI,CAAC,SAAS,CAAC,EAAC;cAChB2B,SAAS,CAAC;YACZ,CAAC,MAAM;cACL5B,SAAS,CAAC6B,OAAO,CAACL,QAAQ,CAACE,IAAI;YACjC;UACF,CAAC,CAAC,OAAOI,KAAK,EAAE;YACd9B,SAAS,CAAC8B,KAAK,CAAC,MAAM;YACtBC,OAAO,CAACD,KAAK,CAACA,KAAK;UACrB;QACF;MACF,CAAC;IACH;IAEA,MAAMF,SAAS,GAAGA,CAAA,KAAM;MACtBvB,IAAI,CAACgB,KAAK,GAAG;QACXf,EAAE,EAAE,IAAI;QACRC,IAAI,EAAE,EAAE;QACRC,IAAI,EAAE,EAAE;QACRC,IAAI,EAAE,IAAI;QACVC,IAAI,EAAE,EAAE;QACRC,GAAG,EAAE,IAAI;QACTC,QAAQ,EAAE,EAAE;QACZC,UAAU,EAAE,EAA