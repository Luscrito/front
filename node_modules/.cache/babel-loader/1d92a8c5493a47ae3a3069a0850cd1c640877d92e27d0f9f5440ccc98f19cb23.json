{"ast":null,"code":"import { ref, nextTick } from 'vue';\nimport axios from 'axios';\nimport { ElMessage } from 'element-plus';\nimport DockerContainers from '@/components/Container/DockerContainers.vue';\nexport default {\n  __name: 'AddFirewallRuleDialog',\n  setup(__props, {\n    expose: __expose\n  }) {\n    const dialogVisible = ref(false); // 弹窗可见性\n    const containers = ref([]); // 容器列表\n    const selectedContainer = ref(''); // 选中的容器\n    const selectedChain = ref(''); // 选中的链\n    const selectedRule = ref('');\n    const sourceAddress = ref(''); // 源地址\n    const destinationAddress = ref(''); // 目标地址\n    const destinationPort = ref(''); // 目的端口\n    const loading = ref(false); // 按钮加载状态\n    const containersRef = ref(null); // 引用容器组件\n\n    // 打开弹窗并获取容器列表\n    const openDialog = async () => {\n      dialogVisible.value = true;\n      // 初始化状态\n      selectedContainer.value = ''; // 清空容器选择\n      selectedChain.value = ''; // 默认链\n      selectedRule.value = '';\n      sourceAddress.value = ''; // 清空源地址\n      destinationAddress.value = ''; // 清空目标地址\n      destinationPort.value = ''; // 清空目的端口\n\n      await nextTick();\n      if (containersRef.value) {\n        await containersRef.value.fetchContainers();\n        containers.value = containersRef.value.containers || [];\n      }\n    };\n\n    // 根据选择的链生成相应的规则\n    const generateRule = () => {\n      let ruleStr = '';\n      if (selectedChain.value === 'INPUT') {\n        ruleStr = `-i ${sourceAddress.value} -d ${destinationAddress.value} -j ${selectedRule.value}`;\n      } else if (selectedChain.value === 'OUTPUT') {\n        ruleStr = `-s ${sourceAddress.value} -d ${destinationAddress.value} --dport ${destinationPort.value} -j ${selectedRule.value}`;\n      } else if (selectedChain.value === 'FORWARD') {\n        ruleStr = `-s ${sourceAddress.value} -d ${destinationAddress.value} -j ${selectedRule.value}`;\n      }\n      return ruleStr;\n    };\n\n    // 处理添加防火墙规则\n    const handleAddRule = async () => {\n      if (!selectedContainer.value || !generateRule()) {\n        ElMessage.warning('请填写所有必需字段');\n        return;\n      }\n      loading.value = true;\n      try {\n        const ruleString = generateRule();\n        await axios.post(`http://localhost:8081/firewall/add`, {\n          containerName: selectedContainer.value,\n          chain: selectedChain.value,\n          rule: ruleString\n        });\n        ElMessage.success('防火墙规则添加成功');\n        dialogVisible.value = false;\n      } catch (err) {\n        console.error('添加规则失败', err);\n        ElMessage.error('添加规则失败', err);\n      } finally {\n        loading.value = false;\n      }\n    };\n\n    // 处理链选择变化\n    const handleChainChange = () => {\n      // 每次改变链时，清空相应的字段，避免用户混淆\n      sourceAddress.value = '';\n      destinationAddress.value = '';\n      destinationPort.value = '';\n      selectedRule.value = ''; // 清空规则选择\n    };\n    __expose({\n      openDialog\n    }); // 暴露openDialog方法\n\n    const __returned__ = {\n      dialogVisible,\n      containers,\n      selectedContainer,\n      selectedChain,\n      selectedRule,\n      sourceAddress,\n      destinationAddress,\n      destinationPort,\n      loading,\n      containersRef,\n      openDialog,\n      generateRule,\n      handleAddRule,\n      handleChainChange,\n      ref,\n      nextTick,\n      get axios() {\n        return axios;\n      },\n      get ElMessage() {\n        return ElMessage;\n      },\n      DockerContainers\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","nextTick","axios","ElMessage","DockerContainers","dialogVisible","containers","selectedContainer","selectedChain","selectedRule","sourceAddress","destinationAddress","destinationPort","loading","containersRef","openDialog","value","fetchContainers","generateRule","ruleStr","handleAddRule","warning","ruleString","post","containerName","chain","rule","success","err","console","error","handleChainChange","__expose"],"sources":["/home/lsc/IdeaProjects/dockerNetwork/front/src/components/Firewall/AddFirewallRuleDialog.vue"],"sourcesContent":["<template>\n  <el-dialog title=\"添加防火墙规则\" v-model=\"dialogVisible\" width=\"600px\">\n    <el-form label-width=\"100px\">\n      <!-- 容器选择 -->\n      <el-form-item label=\"选择容器\">\n        <el-select v-model=\"selectedContainer\" placeholder=\"请选择容器\">\n          <el-option\n              v-for=\"(container, index) in containers\"\n              :key=\"index\"\n              :label=\"container.name.replace(/^\\//, '')\"\n              :value=\"container.name.replace(/^\\//, '')\"\n          />\n        </el-select>\n      </el-form-item>\n\n      <!-- 链选择 -->\n      <el-form-item label=\"选择链\">\n        <el-select v-model=\"selectedChain\" placeholder=\"请选择链\" @change=\"handleChainChange\">\n          <el-option label=\"INPUT\" value=\"INPUT\" />\n          <el-option label=\"OUTPUT\" value=\"OUTPUT\" />\n          <el-option label=\"FORWARD\" value=\"FORWARD\" />\n        </el-select>\n      </el-form-item>\n\n      <!-- 动态生成的填空项 -->\n      <div v-if=\"selectedChain === 'INPUT'\">\n        <el-form-item label=\"源地址\">\n          <el-input v-model=\"sourceAddress\" placeholder=\"请输入源地址\" />\n        </el-form-item>\n        <el-form-item label=\"目标地址\">\n          <el-input v-model=\"destinationAddress\" placeholder=\"请输入目标地址\" />\n        </el-form-item>\n        <el-form-item label=\"选择规则\">\n          <el-select v-model=\"selectedRule\" placeholder=\"请选择链\">\n            <el-option label=\"流量通过\" value=\"ACCEPT\" />\n            <el-option label=\"流量拒绝\" value=\"REJECT\" />\n          </el-select>\n          <el-alert v-if=\"selectedChain === 'INPUT'\" type=\"info\" title=\"输入链: 填写源地址和目标地址\" />\n        </el-form-item>\n      </div>\n      <div v-if=\"selectedChain === 'OUTPUT'\">\n        <el-form-item label=\"源地址\">\n          <el-input v-model=\"sourceAddress\" placeholder=\"请输入源地址\" />\n        </el-form-item>\n        <el-form-item label=\"目标地址\">\n          <el-input v-model=\"destinationAddress\" placeholder=\"请输入目标地址\" />\n        </el-form-item>\n        <el-form-item label=\"目的端口\">\n          <el-input v-model=\"destinationPort\" placeholder=\"请输入目的端口\" />\n        </el-form-item>\n        <el-form-item label=\"选择规则\">\n          <el-select v-model=\"selectedRule\" placeholder=\"请选择链\">\n            <el-option label=\"流量通过\" value=\"ACCEPT\" />\n            <el-option label=\"流量拒绝\" value=\"REJECT\" />\n          </el-select>\n          <el-alert v-if=\"selectedChain === 'OUTPUT'\" type=\"info\" title=\"输出链: 填写源地址、目标地址和目的端口\" />\n        </el-form-item>\n      </div>\n      <div v-if=\"selectedChain === 'FORWARD'\">\n        <el-form-item label=\"源地址\">\n          <el-input v-model=\"sourceAddress\" placeholder=\"请输入源地址\" />\n        </el-form-item>\n        <el-form-item label=\"目标地址\">\n          <el-input v-model=\"destinationAddress\" placeholder=\"请输入目标地址\" />\n        </el-form-item>\n        <el-form-item label=\"选择规则\">\n          <el-select v-model=\"selectedRule\" placeholder=\"请选择链\">\n            <el-option label=\"流量通过\" value=\"ACCEPT\" />\n            <el-option label=\"流量拒绝\" value=\"REJECT\" />\n          </el-select>\n          <el-alert v-if=\"selectedChain === 'FORWARD'\" type=\"info\" title=\"转发链: 填写源地址和目标地址\" />\n        </el-form-item>\n      </div>\n\n    </el-form>\n\n    <template #footer>\n      <el-button type=\"primary\" @click=\"handleAddRule\" :loading=\"loading\">添加规则</el-button>\n      <el-button @click=\"dialogVisible = false\" :disabled=\"loading\">取消</el-button>\n    </template>\n\n    <!-- 获取容器列表 -->\n    <DockerContainers ref=\"containersRef\" />\n  </el-dialog>\n</template>\n\n<script setup>\nimport { ref, nextTick, defineExpose } from 'vue'\nimport axios from 'axios'\nimport { ElMessage } from 'element-plus'\nimport DockerContainers from '@/components/Container/DockerContainers.vue'\n\nconst dialogVisible = ref(false) // 弹窗可见性\nconst containers = ref([]) // 容器列表\nconst selectedContainer = ref('') // 选中的容器\nconst selectedChain = ref('') // 选中的链\nconst selectedRule = ref('')\nconst sourceAddress = ref('') // 源地址\nconst destinationAddress = ref('') // 目标地址\nconst destinationPort = ref('') // 目的端口\nconst loading = ref(false) // 按钮加载状态\nconst containersRef = ref(null) // 引用容器组件\n\n// 打开弹窗并获取容器列表\nconst openDialog = async () => {\n  dialogVisible.value = true\n  // 初始化状态\n  selectedContainer.value = ''  // 清空容器选择\n  selectedChain.value = ''  // 默认链\n  selectedRule.value = ''\n  sourceAddress.value = ''  // 清空源地址\n  destinationAddress.value = ''  // 清空目标地址\n  destinationPort.value = ''  // 清空目的端口\n\n  await nextTick()\n  if (containersRef.value) {\n    await containersRef.value.fetchContainers()\n    containers.value = containersRef.value.containers || []\n  }\n}\n\n// 根据选择的链生成相应的规则\nconst generateRule = () => {\n  let ruleStr = ''\n  if (selectedChain.value === 'INPUT') {\n    ruleStr = `-i ${sourceAddress.value} -d ${destinationAddress.value} -j ${selectedRule.value}`\n  } else if (selectedChain.value === 'OUTPUT') {\n    ruleStr = `-s ${sourceAddress.value} -d ${destinationAddress.value} --dport ${destinationPort.value} -j ${selectedRule.value}`\n  } else if (selectedChain.value === 'FORWARD') {\n    ruleStr = `-s ${sourceAddress.value} -d ${destinationAddress.value} -j ${selectedRule.value}`\n  }\n  return ruleStr\n}\n\n// 处理添加防火墙规则\nconst handleAddRule = async () => {\n  if (!selectedContainer.value || !generateRule()) {\n    ElMessage.warning('请填写所有必需字段')\n    return\n  }\n\n  loading.value = true\n\n  try {\n    const ruleString = generateRule()\n    await axios.post(`http://localhost:8081/firewall/add`, {\n      containerName: selectedContainer.value,\n      chain: selectedChain.value,\n      rule: ruleString\n    })\n    ElMessage.success('防火墙规则添加成功')\n    dialogVisible.value = false\n  } catch (err) {\n    console.error('添加规则失败', err)\n    ElMessage.error('添加规则失败', err)\n  } finally {\n    loading.value = false\n  }\n}\n\n// 处理链选择变化\nconst handleChainChange = () => {\n  // 每次改变链时，清空相应的字段，避免用户混淆\n  sourceAddress.value = ''\n  destinationAddress.value = ''\n  destinationPort.value = ''\n  selectedRule.value = '' // 清空规则选择\n}\n\ndefineExpose({ openDialog }) // 暴露openDialog方法\n</script>\n\n<style scoped>\n</style>\n"],"mappings":"AAuFA,SAASA,GAAG,EAAEC,QAAsB,QAAQ,KAAI;AAChD,OAAOC,KAAK,MAAM,OAAM;AACxB,SAASC,SAAS,QAAQ,cAAa;AACvC,OAAOC,gBAAgB,MAAM,6CAA4C;;;;;;IAEzE,MAAMC,aAAa,GAAGL,GAAG,CAAC,KAAK,CAAC,EAAC;IACjC,MAAMM,UAAU,GAAGN,GAAG,CAAC,EAAE,CAAC,EAAC;IAC3B,MAAMO,iBAAiB,GAAGP,GAAG,CAAC,EAAE,CAAC,EAAC;IAClC,MAAMQ,aAAa,GAAGR,GAAG,CAAC,EAAE,CAAC,EAAC;IAC9B,MAAMS,YAAY,GAAGT,GAAG,CAAC,EAAE;IAC3B,MAAMU,aAAa,GAAGV,GAAG,CAAC,EAAE,CAAC,EAAC;IAC9B,MAAMW,kBAAkB,GAAGX,GAAG,CAAC,EAAE,CAAC,EAAC;IACnC,MAAMY,eAAe,GAAGZ,GAAG,CAAC,EAAE,CAAC,EAAC;IAChC,MAAMa,OAAO,GAAGb,GAAG,CAAC,KAAK,CAAC,EAAC;IAC3B,MAAMc,aAAa,GAAGd,GAAG,CAAC,IAAI,CAAC,EAAC;;IAEhC;IACA,MAAMe,UAAU,GAAG,MAAAA,CAAA,KAAY;MAC7BV,aAAa,CAACW,KAAK,GAAG,IAAG;MACzB;MACAT,iBAAiB,CAACS,KAAK,GAAG,EAAE,EAAE;MAC9BR,aAAa,CAACQ,KAAK,GAAG,EAAE,EAAE;MAC1BP,YAAY,CAACO,KAAK,GAAG,EAAC;MACtBN,aAAa,CAACM,KAAK,GAAG,EAAE,EAAE;MAC1BL,kBAAkB,CAACK,KAAK,GAAG,EAAE,EAAE;MAC/BJ,eAAe,CAACI,KAAK,GAAG,EAAE,EAAE;;MAE5B,MAAMf,QAAQ,CAAC;MACf,IAAIa,aAAa,CAACE,KAAK,EAAE;QACvB,MAAMF,aAAa,CAACE,KAAK,CAACC,eAAe,CAAC;QAC1CX,UAAU,CAACU,KAAK,GAAGF,aAAa,CAACE,KAAK,CAACV,UAAU,IAAI,EAAC;MACxD;IACF;;IAEA;IACA,MAAMY,YAAY,GAAGA,CAAA,KAAM;MACzB,IAAIC,OAAO,GAAG,EAAC;MACf,IAAIX,aAAa,CAACQ,KAAK,KAAK,OAAO,EAAE;QACnCG,OAAO,GAAG,MAAMT,aAAa,CAACM,KAAK,OAAOL,kBAAkB,CAACK,KAAK,OAAOP,YAAY,CAACO,KAAK,EAAC;MAC9F,CAAC,MAAM,IAAIR,aAAa,CAACQ,KAAK,KAAK,QAAQ,EAAE;QAC3CG,OAAO,GAAG,MAAMT,aAAa,CAACM,KAAK,OAAOL,kBAAkB,CAACK,KAAK,YAAYJ,eAAe,CAACI,KAAK,OAAOP,YAAY,CAACO,KAAK,EAAC;MAC/H,CAAC,MAAM,IAAIR,aAAa,CAACQ,KAAK,KAAK,SAAS,EAAE;QAC5CG,OAAO,GAAG,MAAMT,aAAa,CAACM,KAAK,OAAOL,kBAAkB,CAACK,KAAK,OAAOP,YAAY,CAACO,KAAK,EAAC;MAC9F;MACA,OAAOG,OAAM;IACf;;IAEA;IACA,MAAMC,aAAa,GAAG,MAAAA,CAAA,KAAY;MAChC,IAAI,CAACb,iBAAiB,CAACS,KAAK,IAAI,CAACE,YAAY,CAAC,CAAC,EAAE;QAC/Cf,SAAS,CAACkB,OAAO,CAAC,WAAW;QAC7B;MACF;MAEAR,OAAO,CAACG,KAAK,GAAG,IAAG;MAEnB,IAAI;QACF,MAAMM,UAAU,GAAGJ,YAAY,CAAC;QAChC,MAAMhB,KAAK,CAACqB,IAAI,CAAC,oCAAoC,EAAE;UACrDC,aAAa,EAAEjB,iBAAiB,CAACS,KAAK;UACtCS,KAAK,EAAEjB,aAAa,CAACQ,KAAK;UAC1BU,IAAI,EAAEJ;QACR,CAAC;QACDnB,SAAS,CAACwB,OAAO,CAAC,WAAW;QAC7BtB,aAAa,CAACW,KAAK,GAAG,KAAI;MAC5B,CAAC,CAAC,OAAOY,GAAG,EAAE;QACZC,OAAO,CAACC,KAAK,CAAC,QAAQ,EAAEF,GAAG;QAC3BzB,SAAS,CAAC2B,KAAK,CAAC,QAAQ,EAAEF,GAAG;MAC/B,CAAC,SAAS;QACRf,OAAO,CAACG,KAAK,GAAG,KAAI;MACtB;IACF;;IAEA;IACA,MAAMe,iBAAiB,GAAGA,CAAA,KAAM;MAC9B;MACArB,aAAa,CAACM,KAAK,GAAG,EAAC;MACvBL,kBAAkB,CAACK,KAAK,GAAG,EAAC;MAC5BJ,eAAe,CAACI,KAAK,GAAG,EAAC;MACzBP,YAAY,CAACO,KAAK,GAAG,EAAE,EAAC;IAC1B;IAEAgB,QAAY,CAAC;MAAEjB;IAAW,CAAC,CAAC,EAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}