{"ast":null,"code":"import { ref } from 'vue';\nimport { ElMessage } from 'element-plus';\nimport { Cpu } from '@element-plus/icons-vue';\nimport axios from 'axios';\n\n// 控制弹窗显示\n\nexport default {\n  __name: 'ContainerPage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const showDialog = ref(false);\n\n    // 表单数据\n    const form = ref({\n      name: '',\n      image: '',\n      networks: []\n    });\n\n    // 模拟网络选项（你可以从后端获取）\n    const allNetworks = ref(['net1', 'net2', 'net3']);\n\n    // 提交创建容器请求\n    const submitContainer = async () => {\n      try {\n        await axios.post('/create', form.value);\n        ElMessage.success('容器创建成功！');\n        showDialog.value = false;\n      } catch (e) {\n        ElMessage.error('容器创建失败！');\n      }\n    };\n    const __returned__ = {\n      showDialog,\n      form,\n      allNetworks,\n      submitContainer,\n      ref,\n      get ElMessage() {\n        return ElMessage;\n      },\n      get Cpu() {\n        return Cpu;\n      },\n      get axios() {\n        return axios;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","ElMessage","Cpu","axios","showDialog","form","name","image","networks","allNetworks","submitContainer","post","value","success","e","error"],"sources":["/home/lsc/IdeaProjects/dockerNetwork/front/src/views/ContainerPage.vue"],"sourcesContent":["<template>\n  <div class=\"container-page\">\n    <!-- 顶部菜单栏 -->\n    <el-menu\n        mode=\"horizontal\"\n        menu-trigger=\"hover\"\n        background-color=\"#409EFF\"\n        text-color=\"#fff\"\n        active-text-color=\"#ffd04b\"\n    >\n      <el-sub-menu index=\"1\">\n        <template #title>\n          <el-icon><Cpu /></el-icon>\n          <span>容器</span>\n        </template>\n        <el-menu-item index=\"1-1\" @click=\"showDialog = true\">添加容器</el-menu-item>\n        <el-menu-item index=\"1-2\">删除容器</el-menu-item>\n        <el-menu-item index=\"1-3\">启动容器</el-menu-item>\n        <el-menu-item index=\"1-4\">停止容器</el-menu-item>\n      </el-sub-menu>\n    </el-menu>\n\n    <!-- 添加容器弹窗 -->\n    <el-dialog title=\"添加容器\" v-model=\"showDialog\" width=\"500px\">\n      <el-form :model=\"form\" label-width=\"100px\">\n        <el-form-item label=\"容器名称\">\n          <el-input v-model=\"form.name\" placeholder=\"请输入容器名称\" />\n        </el-form-item>\n        <el-form-item label=\"镜像\">\n          <el-input v-model=\"form.image\" placeholder=\"例如 nginx:latest\" />\n        </el-form-item>\n        <el-form-item label=\"连接网络\">\n          <el-select v-model=\"form.networks\" multiple placeholder=\"选择网络\">\n            <el-option\n                v-for=\"net in allNetworks\"\n                :key=\"net\"\n                :label=\"net\"\n                :value=\"net\"\n            />\n          </el-select>\n        </el-form-item>\n      </el-form>\n      <template #footer>\n        <el-button @click=\"showDialog = false\">取消</el-button>\n        <el-button type=\"primary\" @click=\"submitContainer\">创建</el-button>\n      </template>\n    </el-dialog>\n  </div>\n</template>\n\n<script setup>\nimport { ref } from 'vue'\nimport { ElMessage } from 'element-plus'\nimport { Cpu } from '@element-plus/icons-vue'\nimport axios from 'axios'\n\n// 控制弹窗显示\nconst showDialog = ref(false)\n\n// 表单数据\nconst form = ref({\n  name: '',\n  image: '',\n  networks: []\n})\n\n// 模拟网络选项（你可以从后端获取）\nconst allNetworks = ref(['net1', 'net2', 'net3'])\n\n// 提交创建容器请求\nconst submitContainer = async () => {\n  try {\n    await axios.post('/create', form.value)\n    ElMessage.success('容器创建成功！')\n    showDialog.value = false\n  } catch (e) {\n    ElMessage.error('容器创建失败！')\n  }\n}\n</script>\n\n<style scoped>\n.container-page {\n  padding: 20px;\n}\n</style>\n"],"mappings":"AAmDA,SAASA,GAAG,QAAQ,KAAI;AACxB,SAASC,SAAS,QAAQ,cAAa;AACvC,SAASC,GAAG,QAAQ,yBAAwB;AAC5C,OAAOC,KAAK,MAAM,OAAM;;AAExB;;;;;;;;IACA,MAAMC,UAAU,GAAGJ,GAAG,CAAC,KAAK;;IAE5B;IACA,MAAMK,IAAI,GAAGL,GAAG,CAAC;MACfM,IAAI,EAAE,EAAE;MACRC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE;IACZ,CAAC;;IAED;IACA,MAAMC,WAAW,GAAGT,GAAG,CAAC,CAAC,MAAM,EAAE,MAAM,EAAE,MAAM,CAAC;;IAEhD;IACA,MAAMU,eAAe,GAAG,MAAAA,CAAA,KAAY;MAClC,IAAI;QACF,MAAMP,KAAK,CAACQ,IAAI,CAAC,SAAS,EAAEN,IAAI,CAACO,KAAK;QACtCX,SAAS,CAACY,OAAO,CAAC,SAAS;QAC3BT,UAAU,CAACQ,KAAK,GAAG,KAAI;MACzB,CAAC,CAAC,OAAOE,CAAC,EAAE;QACVb,SAAS,CAACc,KAAK,CAAC,SAAS;MAC3B;IACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}