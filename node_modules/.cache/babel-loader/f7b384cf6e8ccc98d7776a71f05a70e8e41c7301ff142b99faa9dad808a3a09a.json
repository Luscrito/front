{"ast":null,"code":"import { ref } from 'vue';\nexport default {\n  __name: 'ContainerDetailDialog',\n  setup(__props, {\n    expose: __expose\n  }) {\n    const dialogVisible = ref(false);\n    const container = ref(null);\n    function openDialog(containerData) {\n      container.value = containerData;\n      dialogVisible.value = true;\n    }\n    __expose({\n      openDialog\n    });\n    const __returned__ = {\n      dialogVisible,\n      container,\n      openDialog,\n      ref\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","dialogVisible","container","openDialog","containerData","value","__expose"],"sources":["/home/lsc/IdeaProjects/dockerNetwork/front/src/components/ContainerDetailDialog.vue"],"sourcesContent":["<template>\n  <el-dialog v-model=\"dialogVisible\" title=\"容器详情\" width=\"500px\">\n    <div v-if=\"container\">\n      <p><strong>容器名：</strong>{{ container.name }}</p>\n      <p><strong>镜像：</strong>{{ container.image }}</p>\n      <p><strong>状态：</strong>{{ container.status }}</p>\n      <p><strong>网络：</strong>{{ container.networks?.join(', ') }}</p>\n    </div>\n    <div v-else>暂无容器信息</div>\n\n    <template #footer>\n      <el-button @click=\"dialogVisible = false\">关闭</el-button>\n    </template>\n  </el-dialog>\n</template>\n\n<script setup>\nimport { ref, defineExpose } from 'vue'\n\nconst dialogVisible = ref(false)\nconst container = ref(null)\n\nfunction openDialog(containerData) {\n  container.value = containerData\n  dialogVisible.value = true\n}\n\ndefineExpose({\n  openDialog\n})\n</script>\n"],"mappings":"AAiBA,SAASA,GAAiB,QAAQ,KAAI;;;;;;IAEtC,MAAMC,aAAa,GAAGD,GAAG,CAAC,KAAK;IAC/B,MAAME,SAAS,GAAGF,GAAG,CAAC,IAAI;IAE1B,SAASG,UAAUA,CAACC,aAAa,EAAE;MACjCF,SAAS,CAACG,KAAK,GAAGD,aAAY;MAC9BH,aAAa,CAACI,KAAK,GAAG,IAAG;IAC3B;IAEAC,QAAY,CAAC;MACXH;IACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"m