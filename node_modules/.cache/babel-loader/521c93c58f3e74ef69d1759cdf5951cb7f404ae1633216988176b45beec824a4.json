{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.some.js\";\nimport { ref, reactive, computed, nextTick } from 'vue';\nimport axios from 'axios';\nimport { ElMessage } from 'element-plus';\nimport DockerContainers from '@/components/Container/DockerContainers.vue';\nexport default {\n  __name: 'AddStaticRouteDialog',\n  setup(__props, {\n    expose: __expose\n  }) {\n    const dialogVisible = ref(false);\n    const containersRef = ref(null);\n    const containerList = ref([]);\n    const form = reactive({\n      containerName: '',\n      routes: [{\n        targetIp: '',\n        nextHopIp: ''\n      }]\n    });\n\n    // 计算可用的运行中容器\n    const availableContainers = computed(() => {\n      return containerList.value.filter(c => c.status?.includes('Up'));\n    });\n\n    // 格式化容器名称\n    const formatContainerName = name => {\n      return name.replace(/^\\//, '');\n    };\n\n    // 格式化状态显示\n    const formatStatus = status => {\n      return status?.includes('Up') ? '运行中' : '已停止';\n    };\n    const openDialog = async () => {\n      form.containerName = '';\n      form.routes = [{\n        targetIp: '',\n        nextHopIp: ''\n      }];\n      dialogVisible.value = true;\n      await nextTick();\n      if (containersRef.value) {\n        await containersRef.value.fetchContainers();\n        containerList.value = containersRef.value.containers || [];\n      }\n    };\n\n    // 其余方法保持不变\n    const addRoute = () => {\n      form.routes.push({\n        targetIp: '',\n        nextHopIp: ''\n      });\n    };\n    const removeRoute = index => {\n      form.routes.splice(index, 1);\n    };\n    const submitRoutes = async () => {\n      if (!form.containerName || form.routes.some(r => !r.targetIp || !r.nextHopIp)) {\n        ElMessage.warning('请填写完整容器名称和路由信息');\n        return;\n      }\n      try {\n        await axios.post(`http://localhost:8081/bird/add?containerName=${encodeURIComponent(form.containerName)}`, form.routes);\n        ElMessage.success('静态路由添加成功');\n        dialogVisible.value = false;\n      } catch (err) {\n        console.error(err);\n        ElMessage.error('添加失败：' + (err.response?.data || err.message));\n      }\n    };\n    __expose({\n      openDialog\n    });\n    const __returned__ = {\n      dialogVisible,\n      containersRef,\n      containerList,\n      form,\n      availableContainers,\n      formatContainerName,\n      formatStatus,\n      openDialog,\n      addRoute,\n      removeRoute,\n      submitRoutes,\n      ref,\n      reactive,\n      computed,\n      nextTick,\n      get axios() {\n        return axios;\n      },\n      get ElMessage() {\n        return ElMessage;\n      },\n      DockerContainers\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","reactive","computed","nextTick","axios","ElMessage","DockerContainers","dialogVisible","containersRef","containerList","form","containerName","routes","targetIp","nextHopIp","availableContainers","value","filter","c","status","includes","formatContainerName","name","replace","formatStatus","openDialog","fetchContainers","containers","addRoute","push","removeRoute","index","splice","submitRoutes","some","r","warning","post","encodeURIComponent","success","err","console","error","response","data","message","__expose"],"sources":["/home/lsc/IdeaProjects/dockerNetwork/front/src/components/Bird/AddStaticRouteDialog.vue"],"sourcesContent":["<template>\n  <el-dialog title=\"添加静态路由\" v-model=\"dialogVisible\" width=\"680px\">\n    <el-form :model=\"form\" label-width=\"100px\" class=\"route-form\">\n      <el-form-item label=\"目标容器\" required>\n        <el-select\n            v-model=\"form.containerName\"\n            placeholder=\"请选择容器\"\n            clearable\n            filterable\n            class=\"full-width\"\n        >\n          <el-option\n              v-for=\"container in availableContainers\"\n              :key=\"container.id\"\n              :value=\"formatContainerName(container.name)\"\n          >\n            <span class=\"container-option\">\n              <span class=\"name\">{{ formatContainerName(container.name) }}</span>\n              <span class=\"status running\">\n                {{ formatStatus(container.status) }}\n              </span>\n            </span>\n          </el-option>\n        </el-select>\n      </el-form-item>\n\n      <!-- 路由条目部分保持不变 -->\n      <div v-for=\"(route, index) in form.routes\" :key=\"index\" class=\"route-item\">\n        <el-form-item label=\"目标 IP\" required>\n          <el-input v-model=\"route.targetIp\" placeholder=\"例如 192.168.1.0/24\" />\n        </el-form-item>\n        <el-form-item label=\"下一跳 IP\" required>\n          <el-input v-model=\"route.nextHopIp\" placeholder=\"例如 172.17.0.2\" />\n        </el-form-item>\n        <el-button\n            type=\"danger\"\n            @click=\"removeRoute(index)\"\n            :disabled=\"form.routes.length <= 1\"\n        >\n          删除\n        </el-button>\n        <el-divider />\n      </div>\n\n      <el-form-item>\n        <el-button @click=\"addRoute\">添加路由条目</el-button>\n      </el-form-item>\n    </el-form>\n\n    <template #footer>\n      <el-button type=\"primary\" @click=\"submitRoutes\">提 交</el-button>\n      <el-button @click=\"dialogVisible = false\">取 消</el-button>\n    </template>\n\n    <DockerContainers ref=\"containersRef\" />\n  </el-dialog>\n</template>\n\n<script setup>\nimport { ref, reactive, computed, nextTick, defineExpose } from 'vue'\nimport axios from 'axios'\nimport { ElMessage } from 'element-plus'\nimport DockerContainers from '@/components/Container/DockerContainers.vue'\n\nconst dialogVisible = ref(false)\nconst containersRef = ref(null)\nconst containerList = ref([])\n\nconst form = reactive({\n  containerName: '',\n  routes: [{ targetIp: '', nextHopIp: '' }]\n})\n\n// 计算可用的运行中容器\nconst availableContainers = computed(() => {\n  return containerList.value.filter(c => c.status?.includes('Up'))\n})\n\n// 格式化容器名称\nconst formatContainerName = (name) => {\n  return name.replace(/^\\//, '')\n}\n\n// 格式化状态显示\nconst formatStatus = (status) => {\n  return status?.includes('Up') ? '运行中' : '已停止'\n}\n\nconst openDialog = async () => {\n  form.containerName = ''\n  form.routes = [{ targetIp: '', nextHopIp: '' }]\n  dialogVisible.value = true\n\n  await nextTick()\n  if (containersRef.value) {\n    await containersRef.value.fetchContainers()\n    containerList.value = containersRef.value.containers || []\n  }\n}\n\n// 其余方法保持不变\nconst addRoute = () => {\n  form.routes.push({ targetIp: '', nextHopIp: '' })\n}\n\nconst removeRoute = (index) => {\n  form.routes.splice(index, 1)\n}\n\nconst submitRoutes = async () => {\n  if (!form.containerName || form.routes.some(r => !r.targetIp || !r.nextHopIp)) {\n    ElMessage.warning('请填写完整容器名称和路由信息')\n    return\n  }\n\n  try {\n    await axios.post(\n        `http://localhost:8081/bird/add?containerName=${encodeURIComponent(form.containerName)}`,\n        form.routes\n    )\n    ElMessage.success('静态路由添加成功')\n    dialogVisible.value = false\n  } catch (err) {\n    console.error(err)\n    ElMessage.error('添加失败：' + (err.response?.data || err.message))\n  }\n}\n\ndefineExpose({ openDialog })\n</script>\n\n<style scoped>\n.route-form {\n  padding: 20px 30px;\n}\n\n.full-width {\n  width: 100%;\n}\n\n.container-option {\n  display: flex;\n  justify-content: space-between;\n  width: 100%;\n}\n\n.status {\n  font-size: 12px;\n  padding: 2px 8px;\n  border-radius: 4px;\n}\n\n.status.running {\n  color: #67C23A;\n  background: #f0f9eb;\n}\n\n.route-item {\n  background: #f9f9f9;\n  padding: 12px;\n  margin-bottom: 12px;\n  border: 1px dashed #ccc;\n  border-radius: 6px;\n}\n</style>"],"mappings":";;;;AA2DA,SAASA,GAAG,EAAEC,