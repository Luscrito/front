{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.some.js\";\nimport { ref, reactive, nextTick } from 'vue';\nimport axios from 'axios';\nimport { ElMessage } from 'element-plus';\nimport DockerContainers from '@/components/Container/DockerContainers.vue';\nexport default {\n  __name: 'AddStaticRouteDialog',\n  setup(__props, {\n    expose: __expose\n  }) {\n    const dialogVisible = ref(false);\n    const containersRef = ref(null);\n    const containerList = ref([]);\n    const form = reactive({\n      containerName: '',\n      routes: [{\n        targetIp: '',\n        nextHopIp: ''\n      }]\n    });\n    const openDialog = async () => {\n      form.containerName = '';\n      form.routes = [{\n        targetIp: '',\n        nextHopIp: ''\n      }];\n      dialogVisible.value = true;\n\n      // 等待 DockerContainers 挂载并获取容器\n      await nextTick();\n      if (containersRef.value) {\n        await containersRef.value.fetchContainers();\n        containerList.value = containersRef.value.containers || [];\n      }\n    };\n    const addRoute = () => {\n      form.routes.push({\n        targetIp: '',\n        nextHopIp: ''\n      });\n    };\n    const removeRoute = index => {\n      form.routes.splice(index, 1);\n    };\n    const submitRoutes = async () => {\n      if (!form.containerName || form.routes.some(r => !r.targetIp || !r.nextHopIp)) {\n        ElMessage.warning('请填写完整容器名称和路由信息');\n        return;\n      }\n      try {\n        await axios.post(`http://localhost:8081/bird/add?containerName=${encodeURIComponent(form.containerName)}`, form.routes);\n        ElMessage.success('静态路由添加成功');\n        dialogVisible.value = false;\n      } catch (err) {\n        console.error(err);\n        ElMessage.error('添加失败：' + (err.response?.data || err.message));\n      }\n    };\n    __expose({\n      openDialog\n    });\n    const __returned__ = {\n      dialogVisible,\n      containersRef,\n      containerList,\n      form,\n      openDialog,\n      addRoute,\n      removeRoute,\n      submitRoutes,\n      ref,\n      reactive,\n      nextTick,\n      get axios() {\n        return axios;\n      },\n      get ElMessage() {\n        return ElMessage;\n      },\n      DockerContainers\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","reactive","nextTick","axios","ElMessage","DockerContainers","dialogVisible","containersRef","containerList","form","containerName","routes","targetIp","nextHopIp","openDialog","value","fetchContainers","containers","addRoute","push","removeRoute","index","splice","submitRoutes","some","r","warning","post","encodeURIComponent","success","err","console","error","response","data","message","__expose"],"sources":["/home/lsc/IdeaProjects/dockerNetwork/front/src/components/Bird/AddStaticRouteDialog.vue"],"sourcesContent":["<template>\n  <el-dialog title=\"添加静态路由\" v-model=\"dialogVisible\" width=\"600px\">\n    <el-form :model=\"form\" label-width=\"90px\" class=\"route-form\">\n      <el-form-item label=\"容器名称\" required>\n        <el-select v-model=\"form.containerName\" placeholder=\"请选择容器\" clearable>\n          <el-option\n              v-for=\"(container, index) in containerList\"\n              :key=\"index\"\n              :label=\"container.name.replace(/^\\//, '')\"\n              :value=\"container.name.replace(/^\\//, '')\"\n          />\n        </el-select>\n      </el-form-item>\n\n      <div v-for=\"(route, index) in form.routes\" :key=\"index\" class=\"route-item\">\n        <el-form-item label=\"目标 IP\" required>\n          <el-input v-model=\"route.targetIp\" placeholder=\"例如 192.168.1.0/24\" />\n        </el-form-item>\n        <el-form-item label=\"下一跳 IP\" required>\n          <el-input v-model=\"route.nextHopIp\" placeholder=\"例如 172.17.0.2\" />\n        </el-form-item>\n        <el-button type=\"danger\" @click=\"removeRoute(index)\" :disabled=\"form.routes.length <= 1\">删除</el-button>\n        <el-divider />\n      </div>\n\n      <el-form-item>\n        <el-button @click=\"addRoute\">添加路由条目</el-button>\n      </el-form-item>\n    </el-form>\n\n    <template #footer>\n      <el-button type=\"primary\" @click=\"submitRoutes\">提 交</el-button>\n      <el-button @click=\"dialogVisible = false\">取 消</el-button>\n    </template>\n\n    <!-- ✅ 容器组件仅用于获取容器名 -->\n    <DockerContainers ref=\"containersRef\" />\n  </el-dialog>\n</template>\n\n<script setup>\nimport { ref, reactive, nextTick, defineExpose } from 'vue'\nimport axios from 'axios'\nimport { ElMessage } from 'element-plus'\nimport DockerContainers from '@/components/Container/DockerContainers.vue'\n\nconst dialogVisible = ref(false)\nconst containersRef = ref(null)\nconst containerList = ref([])\n\nconst form = reactive({\n  containerName: '',\n  routes: [{ targetIp: '', nextHopIp: '' }]\n})\n\nconst openDialog = async () => {\n  form.containerName = ''\n  form.routes = [{ targetIp: '', nextHopIp: '' }]\n  dialogVisible.value = true\n\n  // 等待 DockerContainers 挂载并获取容器\n  await nextTick()\n  if (containersRef.value) {\n    await containersRef.value.fetchContainers()\n    containerList.value = containersRef.value.containers || []\n  }\n}\n\nconst addRoute = () => {\n  form.routes.push({ targetIp: '', nextHopIp: '' })\n}\n\nconst removeRoute = (index) => {\n  form.routes.splice(index, 1)\n}\n\nconst submitRoutes = async () => {\n  if (!form.containerName || form.routes.some(r => !r.targetIp || !r.nextHopIp)) {\n    ElMessage.warning('请填写完整容器名称和路由信息')\n    return\n  }\n\n  try {\n    await axios.post(`http://localhost:8081/bird/add?containerName=${encodeURIComponent(form.containerName)}`, form.routes)\n    ElMessage.success('静态路由添加成功')\n    dialogVisible.value = false\n  } catch (err) {\n    console.error(err)\n    ElMessage.error('添加失败：' + (err.response?.data || err.message))\n  }\n}\n\ndefineExpose({ openDialog })\n</script>\n\n<style scoped>\n.route-form {\n  padding-top: 10px;\n}\n\n.route-item {\n  background: #f9f9f9;\n  padding: 12px;\n  margin-bottom: 12px;\n  border: 1px dashed #ccc;\n  border-radius: 6px;\n}\n</style>\n"],"mappings":";;;AAyCA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,QAAsB,QAAQ,KAAI;AAC1D,OAAOC,KAAK,MAAM,OAAM;AACxB,SAASC,SAAS,QAAQ,cAAa;AACvC,OAAOC,gBAAgB,MAAM,6CAA4C;;;;;;IAEzE,MAAMC,aAAa,GAAGN,GAAG,CAAC,KAAK;IAC/B,MAAMO,aAAa,GAAGP,GAAG,CAAC,IAAI;IAC9B,MAAMQ,aAAa,GAAGR,GAAG,CAAC,EAAE;IAE5B,MAAMS,IAAI,GAAGR,QAAQ,CAAC;MACpBS,aAAa,EAAE,EAAE;MACjBC,MAAM,EAAE,CAAC;QAAEC,QAAQ,EAAE,EAAE;QAAEC,SAAS,EAAE;MAAG,CAAC;IAC1C,CAAC;IAED,MAAMC,UAAU,GAAG,MAAAA,CAAA,KAAY;MAC7BL,IAAI,CAACC,aAAa,GAAG,EAAC;MACtBD,IAAI,CAACE,MAAM,GAAG,CAAC;QAAEC,QAAQ,EAAE,EAAE;QAAEC,SAAS,EAAE;MAAG,CAAC;MAC9CP,aAAa,CAACS,KAAK,GAAG,IAAG;;MAEzB;MACA,MAAMb,QAAQ,CAAC;MACf,IAAIK,aAAa,CAACQ,KAAK,EAAE;QACvB,MAAMR,aAAa,CAACQ,KAAK,CAACC,eAAe,CAAC;QAC1CR,aAAa,CAACO,KAAK,GAAGR,aAAa,CAACQ,KAAK,CAACE,UAAU,IAAI,EAAC;MAC3D;IACF;IAEA,MAAMC,QAAQ,GAAGA,CAAA,KAAM;MACrBT,IAAI,CAACE,MAAM,CAACQ,IAAI,CAAC;QAAEP,QAAQ,EAAE,EAAE;QAAEC,SAAS,EAAE;MAAG,CAAC;IAClD;IAEA,MAAMO,WAAW,GAAIC,KAAK,IAAK;MAC7BZ,IAAI,CAACE,MAAM,CAACW,MAAM,CAACD,KAAK,EAAE,CAAC;IAC7B;IAEA,MAAME,YAAY,GAAG,MAAAA,CAAA,KAAY;MAC/B,IAAI,CAACd,IAAI,CAACC,aAAa,IAAID,IAAI,CAACE,MAAM,CAACa,IAAI,CAACC,CAAC,IAAI,CAACA,CAAC,CAACb,QAAQ,IAAI,CAACa,CAAC,CAACZ,SAAS,CAAC,EAAE;QAC7ET,SAAS,CAACsB,OAAO,CAAC,gBAAgB;QAClC;MACF;MAEA,IAAI;QACF,MAAMvB,KAAK,CAACwB,IAAI,CAAC,gDAAgDC,kBAAkB,CAACnB,IAAI,CAACC,aAAa,CAAC,EAAE,EAAED,IAAI,CAACE,MAAM;QACtHP,SAAS,CAACyB,OAAO,CAAC,UAAU;QAC5BvB,aAAa,CAACS,KAAK,GAAG,KAAI;MAC5B,CAAC,CAAC,OAAOe,GAAG,EAAE;QACZC,OAAO,CAACC,KAAK,CAACF,GAAG;QACjB1B,SAAS,CAAC4B,KAAK,CAAC,OAAO,IAAIF,GAAG,CAACG,QAAQ,EAAEC,IAAI,IAAIJ,GAAG,CAACK,OAAO,CAAC;MAC/D;IACF;IAEAC,QAAY,CAAC;MAAEtB;IAAW,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}