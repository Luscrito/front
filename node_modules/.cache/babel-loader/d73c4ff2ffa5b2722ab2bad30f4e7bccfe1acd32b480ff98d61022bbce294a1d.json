{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport axios from 'axios';\nimport { ElMessage } from 'element-plus';\nexport default {\n  __name: 'PlanList',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const plans = ref([]);\n\n    // 获取计划列表\n    const fetchPlans = async () => {\n      try {\n        const response = await axios.get('http://localhost:8081/plan/list');\n        plans.value = response.data.records || [];\n      } catch (error) {\n        ElMessage.error('获取计划数据失败');\n        console.error(error);\n      }\n    };\n    onMounted(fetchPlans);\n\n    // 查看计划详细信息\n    const viewPlan = plan => {\n      alert(`查看计划：\\nID: ${plan.id}\\n名称: ${plan.name}\\n类型: ${plan.type}\\n描述: ${plan.description}\\n大小: ${plan.size}\\n时间: ${plan.time}\\n数量: ${plan.num}\\n速度: ${plan.velocity}\\n容器1: ${plan.container1}\\n容器2: ${plan.container2}\\n容器2 IP: ${plan.container2Ip}`);\n    };\n    const __returned__ = {\n      plans,\n      fetchPlans,\n      viewPlan,\n      ref,\n      onMounted,\n      get axios() {\n        return axios;\n      },\n      get ElMessage() {\n        return ElMessage;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","axios","ElMessage","plans","fetchPlans","response","get","value","data","records","error","console","viewPlan","plan","alert","id","name","type","description","size","time","num","velocity","container1","container2","container2Ip"],"sources":["/home/lsc/IdeaProjects/dockerNetwork/front/src/components/Plan/PlanList.vue"],"sourcesContent":["<template>\n  <div class=\"p-4\">\n    <div v-if=\"plans.length === 0\" class=\"text-center text-gray-500\">暂无数据</div>\n    <div class=\"table-wrapper\">\n      <el-table :data=\"plans\" style=\"width: 100%\">\n        <!-- 查看按钮列 -->\n        <el-table-column label=\"操作\" width=\"100\" fixed=\"right\">\n          <template #default=\"{ row }\">\n            <el-button size=\"small\" type=\"primary\" @click=\"viewPlan(row)\">查看</el-button>\n          </template>\n        </el-table-column>\n\n        <!-- 索引列 -->\n        <el-table-column label=\"#\" type=\"index\" width=\"50\" />\n\n        <!-- 显示 ID、名称、类型 -->\n        <el-table-column label=\"ID\" prop=\"id\" />\n        <el-table-column label=\"名称\" prop=\"name\" />\n        <el-table-column label=\"类型\" prop=\"type\" />\n      </el-table>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted } from 'vue'\nimport axios from 'axios'\nimport { ElMessage } from 'element-plus'\n\nconst plans = ref([])\n\n// 获取计划列表\nconst fetchPlans = async () => {\n  try {\n    const response = await axios.get('http://localhost:8081/plan/list')\n    plans.value = response.data.records || []\n  } catch (error) {\n    ElMessage.error('获取计划数据失败')\n    console.error(error)\n  }\n}\n\nonMounted(fetchPlans)\n\n// 查看计划详细信息\nconst viewPlan = (plan) => {\n  alert(`查看计划：\\nID: ${plan.id}\\n名称: ${plan.name}\\n类型: ${plan.type}\\n描述: ${plan.description}\\n大小: ${plan.size}\\n时间: ${plan.time}\\n数量: ${plan.num}\\n速度: ${plan.velocity}\\n容器1: ${plan.container1}\\n容器2: ${plan.container2}\\n容器2 IP: ${plan.container2Ip}`)\n}\n</script>\n\n<style scoped>\n.el-table th {\n  background-color: #f1f5f9;\n  color: #333;\n  font-weight: bold;\n}\n\n.el-button {\n  transition: background-color 0.3s ease;\n}\n\n.el-button:hover {\n  background-color: #34d399;\n}\n\n.text-center {\n  text-align: center;\n}\n\n/* 添加表格外部容器，启用横向滚动 */\n.table-wrapper {\n  max-width: 100%;\n  overflow-x: auto;\n}\n</style>\n"],"mappings":"AAyBA,SAASA,GAAG,EAAEC,SAAS,QAAQ,KAAI;AACnC,OAAOC,KAAK,MAAM,OAAM;AACxB,SAASC,SAAS,QAAQ,cAAa;;;;;;;IAEvC,MAAMC,KAAK,GAAGJ,GAAG,CAAC,EAAE;;IAEpB;IACA,MAAMK,UAAU,GAAG,MAAAA,CAAA,KAAY;MAC7B,IAAI;QACF,MAAMC,QAAQ,GAAG,MAAMJ,KAAK,CAACK,GAAG,CAAC,iCAAiC;QAClEH,KAAK,CAACI,KAAK,GAAGF,QAAQ,CAACG,IAAI,CAACC,OAAO,IAAI,EAAC;MAC1C,CAAC,CA