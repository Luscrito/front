{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport axios from 'axios';\nexport default {\n  __name: 'PlanList',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const plans = ref([]);\n    const fetchPlans = async () => {\n      try {\n        const res = await axios.get('http://localhost:8081/plan/list');\n        plans.value = res.data.records;\n      } catch (err) {\n        console.error('获取计划失败：', err);\n      }\n    };\n    const executePlan = async id => {\n      try {\n        const res = await axios.post(`http://localhost:8081/plan/execute/${id}`);\n        alert(`执行计划成功: ${res.data}`);\n      } catch (err) {\n        alert('执行失败');\n        console.error(err);\n      }\n    };\n    onMounted(fetchPlans);\n    const __returned__ = {\n      plans,\n      fetchPlans,\n      executePlan,\n      ref,\n      onMounted,\n      get axios() {\n        return axios;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","axios","plans","fetchPlans","res","get","value","data","records","err","console","error","executePlan","id","post","alert"],"sources":["/home/lsc/IdeaProjects/dockerNetwork/front/src/components/Plan/PlanList.vue"],"sourcesContent":["<template>\n  <div class=\"p-6 bg-white shadow-lg rounded-lg\">\n    <div v-if=\"plans.length === 0\" class=\"text-center text-gray-500\">暂无数据</div>\n    <table v-else class=\"min-w-full table-auto text-sm\">\n      <thead>\n      <tr class=\"bg-blue-100\">\n        <th class=\"px-4 py-3 border text-left\">ID</th>\n        <th class=\"px-4 py-3 border text-left\">名称</th>\n        <th class=\"px-4 py-3 border text-left\">描述</th>\n        <th class=\"px-4 py-3 border text-left\">类型</th>\n        <th class=\"px-4 py-3 border text-left\">大小</th>\n        <th class=\"px-4 py-3 border text-left\">时间</th>\n        <th class=\"px-4 py-3 border text-left\">数量</th>\n        <th class=\"px-4 py-3 border text-left\">速度</th>\n        <th class=\"px-4 py-3 border text-left\">容器1</th>\n        <th class=\"px-4 py-3 border text-left\">容器2</th>\n        <th class=\"px-4 py-3 border text-left\">容器2 IP</th>\n        <th class=\"px-4 py-3 border text-left\">操作</th>\n      </tr>\n      </thead>\n      <tbody>\n      <tr v-for=\"plan in plans\" :key=\"plan.id\" class=\"hover:bg-gray-50\">\n        <td class=\"px-4 py-3 border\">{{ plan.id }}</td>\n        <td class=\"px-4 py-3 border\">{{ plan.name }}</td>\n        <td class=\"px-4 py-3 border\">{{ plan.description }}</td>\n        <td class=\"px-4 py-3 border\">{{ plan.type }}</td>\n        <td class=\"px-4 py-3 border\">{{ plan.size }}</td>\n        <td class=\"px-4 py-3 border\">{{ plan.time }}</td>\n        <td class=\"px-4 py-3 border\">{{ plan.num }}</td>\n        <td class=\"px-4 py-3 border\">{{ plan.velocity }}</td>\n        <td class=\"px-4 py-3 border\">{{ plan.container1 }}</td>\n        <td class=\"px-4 py-3 border\">{{ plan.container2 }}</td>\n        <td class=\"px-4 py-3 border\">{{ plan.container2Ip }}</td>\n        <td class=\"px-4 py-3 border text-center\">\n          <button\n              class=\"px-4 py-2 bg-green-500 text-white rounded hover:bg-green-600\"\n              @click=\"executePlan(plan.id)\"\n          >\n            执行\n          </button>\n        </td>\n      </tr>\n      </tbody>\n    </table>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted } from 'vue'\nimport axios from 'axios'\n\nconst plans = ref([])\n\nconst fetchPlans = async () => {\n  try {\n    const res = await axios.get('http://localhost:8081/plan/list')\n    plans.value = res.data.records\n  } catch (err) {\n    console.error('获取计划失败：', err)\n  }\n}\n\nconst executePlan = async (id) => {\n  try {\n    const res = await axios.post(`http://localhost:8081/plan/execute/${id}`)\n    alert(`执行计划成功: ${res.data}`)\n  } catch (err) {\n    alert('执行失败')\n    console.error(err)\n  }\n}\n\nonMounted(fetchPlans)\n</script>\n\n<style scoped>\ntable {\n  width: 100%;\n  border-collapse: collapse;\n}\n\nth {\n  background-color: #f1f5f9;\n  font-weight: bold;\n}\n\ntd {\n  text-align: left;\n  padding: 0.5rem;\n}\n\nbutton {\n  transition: background-color 0.3s ease;\n}\n\nbutton:hover {\n  background-color: #34d399;\n}\n</style>\n"],"mappings":"AAgDA,SAASA,GAAG,EAAEC,SAAS,QAAQ,KAAI;AACnC,OAAOC,KAAK,MAAM,OAAM;;;;;;;IAExB,MAAMC,KAAK,GAAGH,GAAG,CAAC,EAAE;IAEpB,MAAMI,UAAU,GAAG,MAAAA,CAAA,KAAY;MAC7B,IAAI;QACF,MAAMC,GAAG,GAAG,MAAMH,KAAK,CAACI,GAAG,CAAC,iCAAiC;QAC7DH,KAAK,CAACI,KAAK,GAAGF,GAAG,CAACG,IAAI,CAACC,OAAM;MAC/B,CAAC,CAAC,OAAOC,GAAG,EAAE;QACZC,OAAO,CAACC,KAAK,CAAC,SAAS,EAAEF,GAAG;MAC9B;IACF;IAEA,MAAMG,WAAW,GAAG,MAAOC,EAAE,IAAK;MAChC,IAAI;QACF,MAAMT,GAAG,GAAG,MAAMH,KAAK,CAACa,IAAI,CAAC,sCAAsCD,EAAE,EAAE;QACvEE,KAAK,CAAC,WAAWX,GAAG,CAACG,IAAI,EAAE;MAC7B,CAAC,CAAC,OAAOE,GAAG,EAAE;QACZM,KAAK,CAAC,MAAM;QACZL,OAAO,CAACC,KAAK,CAACF,GAAG;MACnB;IACF;IAEAT,SAAS,CAACG,UAAU","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}