{"ast":null,"code":"import { renderList as _renderList, Fragment as _Fragment, openBlock as _openBlock, createElementBlock as _createElementBlock, resolveComponent as _resolveComponent, createBlock as _createBlock, withCtx as _withCtx, createVNode as _createVNode, createElementVNode as _createElementVNode } from \"vue\";\nconst _hoisted_1 = {\n  class: \"monitor-container\"\n};\nconst _hoisted_2 = {\n  ref: \"bandwidthChartRef\",\n  style: {\n    \"height\": \"300px\",\n    \"margin-top\": \"20px\"\n  }\n};\nconst _hoisted_3 = {\n  ref: \"networkChartRef\",\n  style: {\n    \"height\": \"300px\",\n    \"margin-top\": \"20px\"\n  }\n};\nexport function render(_ctx, _cache, $props, $setup, $data, $options) {\n  const _component_el_option = _resolveComponent(\"el-option\");\n  const _component_el_select = _resolveComponent(\"el-select\");\n  return _openBlock(), _createElementBlock(\"div\", _hoisted_1, [_createVNode(_component_el_select, {\n    modelValue: $setup.selectedContainer,\n    \"onUpdate:modelValue\": _cache[0] || (_cache[0] = $event => $setup.selectedContainer = $event),\n    placeholder: \"选择容器\",\n    onChange: $setup.startMonitoring\n  }, {\n    default: _withCtx(() => [(_openBlock(true), _createElementBlock(_Fragment, null, _renderList($setup.containers, c => {\n      return _openBlock(), _createBlock(_component_el_option, {\n        key: c.name,\n        label: c.name.replace(/^\\//, ''),\n        value: c.name.replace(/^\\//, '')\n      }, null, 8 /* PROPS */, [\"label\", \"value\"]);\n    }), 128 /* KEYED_FRAGMENT */))]),\n    _: 1 /* STABLE */\n  }, 8 /* PROPS */, [\"modelValue\"]), _createElementVNode(\"div\", _hoisted_2, null, 512 /* NEED_PATCH */), _createElementVNode(\"div\", _hoisted_3, null, 512 /* NEED_PATCH */)]);\n}","map":{"version":3,"names":["class","ref","style","_createElementBlock","_hoisted_1","_createVNode","_component_el_select","modelValue","$setup","selectedContainer","_cache","$event","placeholder","onChange","startMonitoring","default","_withCtx","_Fragment","_renderList","containers","c","_createBlock","_component_el_option","key","name","label","replace","value","_","_createElementVNode","_hoisted_2","_hoisted_3"],"sources":["/home/lsc/IdeaProjects/dockerNetwork/front/src/components/Monitor/MonitorView.vue"],"sourcesContent":["<template>\n  <div class=\"monitor-container\">\n    <el-select v-model=\"selectedContainer\" placeholder=\"选择容器\" @change=\"startMonitoring\">\n      <el-option\n          v-for=\"c in containers\"\n          :key=\"c.name\"\n          :label=\"c.name.replace(/^\\//, '')\"\n          :value=\"c.name.replace(/^\\//, '')\"\n      />\n    </el-select>\n\n    <div ref=\"bandwidthChartRef\" style=\"height: 300px; margin-top: 20px\"></div>\n    <div ref=\"networkChartRef\" style=\"height: 300px; margin-top: 20px\"></div>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted, onBeforeUnmount } from 'vue'\nimport axios from 'axios'\nimport * as echarts from 'echarts'\n\nconst selectedContainer = ref('')\nconst containers = ref([])\nconst bandwidthChartRef = ref(null)\nconst networkChartRef = ref(null)\nlet bandwidthChart = null\nlet networkChart = null\nlet intervalId = null\n\n// 初始化图表数据数组\nconst bandwidthData = ref([])\nconst timeData = ref([])\nconst rxData = ref([])\nconst txData = ref([])\n\nconst fetchContainers = async () => {\n  try {\n    const res = await axios.get('http://localhost:8081/container/list')\n    containers.value = res.data\n  } catch (err) {\n    console.error('获取容器列表失败', err)\n  }\n}\n\nconst startMonitoring = () => {\n  clearInterval(intervalId)\n  bandwidthData.value = []\n  timeData.value = []\n  rxData.value = []\n  txData.value = []\n\n  updateCharts()\n\n  intervalId = setInterval(async () => {\n    if (!selectedContainer.value) return\n    const timestamp = new Date().toLocaleTimeString()\n\n    try {\n      const bandwidthRes = await axios.get(`http://localhost:8081/stats/bandwidth/${selectedContainer.value}?interval=1000`)\n      const statsRes = await axios.get(`http://localhost:8081/stats/networkStats/${selectedContainer.value}`)\n\n      timeData.value.push(timestamp)\n      bandwidthData.value.push(bandwidthRes.data.totalRate)\n      rxData.value.push(statsRes.data.rxBytes)\n      txData.value.push(statsRes.data.txBytes)\n\n      if (timeData.value.length > 20) {\n        timeData.value.shift()\n        bandwidthData.value.shift()\n        rxData.value.shift()\n        txData.value.shift()\n      }\n\n      updateCharts()\n    } catch (err) {\n      console.error('监控数据获取失败', err)\n    }\n  }, 1000)\n}\n\nconst updateCharts = () => {\n  if (!bandwidthChart || !networkChart) {\n    bandwidthChart = echarts.init(bandwidthChartRef.value)\n    networkChart = echarts.init(networkChartRef.value)\n  }\n\n  bandwidthChart.setOption({\n    title: { text: '容器带宽使用率 (Bytes/s)' },\n    xAxis: { type: 'category', data: timeData.value },\n    yAxis: { type: 'value' },\n    series: [\n      { data: bandwidthData.value, type: 'line', name: '总带宽', smooth: true }\n    ]\n  })\n\n  networkChart.setOption({\n    title: { text: '网络收发字节数 (累计)' },\n    tooltip: { trigger: 'axis' },\n    legend: { data: ['接收字节 RX', '发送字节 TX'] },\n    xAxis: { type: 'category', data: timeData.value },\n    yAxis: { type: 'value' },\n    series: [\n      { data: rxData.value, type: 'line', name: '接收字节 RX', smooth: true },\n      { data: txData.value, type: 'line', name: '发送字节 TX', smooth: true }\n    ]\n  })\n}\n\nonMounted(() => {\n  fetchContainers()\n})\n\nonBeforeUnmount(() => {\n  clearInterval(intervalId)\n})\n</script>\n\n<style scoped>\n.monitor-container {\n  padding: 20px;\n}\n</style>\n"],"mappings":";;EACOA,KAAK,EAAC;AAAmB;;EAUvBC,GAAG,EAAC,mBAAmB;EAACC,KAAuC,EAAvC;IAAA;IAAA;EAAA;;;EACxBD,GAAG,EAAC,iBAAiB;EAACC,KAAuC,EAAvC;IAAA;IAAA;EAAA;;;;;uBAX7BC,mBAAA,CAYM,OAZNC,UAYM,GAXJC,YAAA,CAOYC,oBAAA;IAThBC,UAAA,EAEwBC,MAAA,CAAAC,iBAAiB;IAFzC,uBAAAC,MAAA,QAAAA,MAAA,MAAAC,MAAA,IAEwBH,MAAA,CAAAC,iBAAiB,GAAAE,MAAA;IAAEC,WAAW,