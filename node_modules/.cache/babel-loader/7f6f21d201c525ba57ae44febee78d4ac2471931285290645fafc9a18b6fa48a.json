{"ast":null,"code":"import { ref, onMounted, onBeforeUnmount } from 'vue';\nimport axios from 'axios';\nimport { ElMessage, ElMessageBox } from 'element-plus';\nexport default {\n  __name: 'PlanList',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const plansRef = ref([]);\n    const dialogVisible = ref(false);\n    const selectedPlan = ref(null);\n    const fetchPlans = async () => {\n      try {\n        const response = await axios.get('http://localhost:8081/plan/list');\n        plansRef.value = response.data.records || [];\n      } catch (error) {\n        ElMessage.error('获取计划数据失败');\n        console.error(error);\n      }\n    };\n    const refreshPlans = () => {\n      fetchPlans();\n    };\n    let intervalId = null;\n    onMounted(() => {\n      intervalId = setInterval(() => {\n        refreshPlans();\n      }, 1000);\n    });\n    onBeforeUnmount(() => {\n      if (intervalId) {\n        clearInterval(intervalId);\n      }\n    });\n    const viewPlan = plan => {\n      selectedPlan.value = plan;\n      dialogVisible.value = true;\n    };\n    const executePlan = plan => {\n      ElMessage.success(`执行计划: ${plan.name}`);\n      console.log(`正在执行计划: ${plan.name}`);\n    };\n    const deletePlan = async plan => {\n      try {\n        await ElMessageBox.confirm(`确定要删除计划「${plan.name}」吗？`, '提示', {\n          confirmButtonText: '确定',\n          cancelButtonText: '取消',\n          type: 'warning'\n        });\n        await axios.delete(`http://localhost:8081/plan/delete/${plan.id}`);\n        ElMessage.success(`已删除计划: ${plan.name}`);\n        refreshPlans();\n      } catch (error) {\n        if (error !== 'cancel') {\n          ElMessage.error('删除失败');\n          console.error(error);\n        }\n      }\n    };\n    const __returned__ = {\n      plansRef,\n      dialogVisible,\n      selectedPlan,\n      fetchPlans,\n      refreshPlans,\n      get intervalId() {\n        return intervalId;\n      },\n      set intervalId(v) {\n        intervalId = v;\n      },\n      viewPlan,\n      executePlan,\n      deletePlan,\n      ref,\n      onMounted,\n      onBeforeUnmount,\n      get axios() {\n        return axios;\n      },\n      get ElMessage() {\n        return ElMessage;\n      },\n      get ElMessageBox() {\n        return ElMessageBox;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","onBeforeUnmount","axios","ElMessage","ElMessageBox","plansRef","dialogVisible","selectedPlan","fetchPlans","response","get","value","data","records","error","console","refreshPlans","intervalId","setInterval","clearInterval","viewPlan","plan","executePlan","success","name","log","deletePlan","confirm","confirmButtonText","cancelButtonText","type","delete","id"],"sources":["/home/lsc/IdeaProjects/dockerNetwork/front/src/components/Plan/PlanList.vue"],"sourcesContent":["<template>\n  <div class=\"plan-section\">\n    <div v-if=\"plansRef.length === 0\" class=\"text-center text-gray-500\">暂无数据</div>\n    <div class=\"table-wrapper\">\n      <el-table :data=\"plansRef\" style=\"width: 100%\">\n        <el-table-column label=\"操作\" width=\"300\" fixed=\"right\">\n          <template #default=\"{ row }\">\n            <div class=\"button-group\">\n              <el-button size=\"small\" type=\"primary\" @click=\"viewPlan(row)\">查看</el-button>\n              <el-button size=\"small\" type=\"success\" @click=\"executePlan(row)\">执行</el-button>\n              <el-button size=\"small\" type=\"danger\" @click=\"deletePlan(row)\">删除</el-button>\n            </div>\n          </template>\n        </el-table-column>\n        <el-table-column label=\"#\" type=\"index\" width=\"50\" />\n        <el-table-column label=\"名称\" prop=\"name\" />\n        <el-table-column label=\"类型\" prop=\"type\" />\n      </el-table>\n    </div>\n\n    <!-- Plan Detail Dialog -->\n    <el-dialog v-model=\"dialogVisible\" title=\"计划详情\" width=\"500px\" :close-on-click-modal=\"false\">\n      <div v-if=\"selectedPlan\">\n        <p><strong>ID:</strong> {{ selectedPlan.id }}</p>\n        <p><strong>名称:</strong> {{ selectedPlan.name }}</p>\n        <p><strong>类型:</strong> {{ selectedPlan.type }}</p>\n        <p><strong>大小:</strong> {{ selectedPlan.size }}</p>\n        <p><strong>时间:</strong> {{ selectedPlan.time }}</p>\n        <p><strong>数量:</strong> {{ selectedPlan.num }}</p>\n        <p><strong>速度:</strong> {{ selectedPlan.velocity }}</p>\n        <p><strong>容器1:</strong> {{ selectedPlan.container1 }}</p>\n        <p><strong>容器2:</strong> {{ selectedPlan.container2 }}</p>\n        <p><strong>容器2 IP:</strong> {{ selectedPlan.container2Ip }}</p>\n      </div>\n      <template #footer>\n        <el-button @click=\"dialogVisible = false\">关闭</el-button>\n      </template>\n    </el-dialog>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted, onBeforeUnmount } from 'vue'\nimport axios from 'axios'\nimport { ElMessage, ElMessageBox } from 'element-plus'\n\nconst plansRef = ref([])\nconst dialogVisible = ref(false)\nconst selectedPlan = ref(null)\n\nconst fetchPlans = async () => {\n  try {\n    const response = await axios.get('http://localhost:8081/plan/list')\n    plansRef.value = response.data.records || []\n  } catch (error) {\n    ElMessage.error('获取计划数据失败')\n    console.error(error)\n  }\n}\n\nconst refreshPlans = () => {\n  fetchPlans()\n}\n\nlet intervalId = null\nonMounted(() => {\n  intervalId = setInterval(() => {\n    refreshPlans()\n  }, 1000)\n})\n\nonBeforeUnmount(() => {\n  if (intervalId) {\n    clearInterval(intervalId)\n  }\n})\n\nconst viewPlan = (plan) => {\n  selectedPlan.value = plan\n  dialogVisible.value = true\n}\n\nconst executePlan = (plan) => {\n  ElMessage.success(`执行计划: ${plan.name}`)\n  console.log(`正在执行计划: ${plan.name}`)\n}\n\nconst deletePlan = async (plan) => {\n  try {\n    await ElMessageBox.confirm(\n        `确定要删除计划「${plan.name}」吗？`,\n        '提示',\n        {\n          confirmButtonText: '确定',\n          cancelButtonText: '取消',\n          type: 'warning',\n        }\n    )\n    await axios.delete(`http://localhost:8081/plan/delete/${plan.id}`)\n    ElMessage.success(`已删除计划: ${plan.name}`)\n    refreshPlans()\n  } catch (error) {\n    if (error !== 'cancel') {\n      ElMessage.error('删除失败')\n      console.error(error)\n    }\n  }\n}\n</script>\n\n<style scoped>\n.plan-section {\n  flex: 1;\n  overflow-y: auto;\n  padding-right: 8px;\n}\n\n.table-wrapper {\n  flex: 1;\n  overflow-y: auto;\n  padding-right: 10px;\n}\n\n.el-table th {\n  background-color: #f1f5f9;\n  color: #333;\n  font-weight: bold;\n}\n\n.text-center {\n  text-align: center;\n}\n\n.button-group {\n  display: flex;\n  justify-content: flex-start;\n  gap: 10px;\n}\n</style>\n"],"mappings":"AA0CA,SAASA,GAAG,EAAEC,SAAS,EAAEC,eAAe,QAAQ,KAAI;AACpD,OAAOC,KAAK,MAAM,OAAM;AACxB,SAASC,SAAS,EAAEC,YAAY,QAAQ,cAAa;;;;;;;IAErD,MAAMC,QAAQ,GAAGN,GAAG,CAAC,EAAE;IACvB,MAAMO,aAAa,GAAGP,GAAG,CAAC,KAAK;IAC/B,MAAMQ,YAAY,GAAGR,GAAG,CAAC,IAAI;IAE7B,MAAMS,UAAU,GAAG,MAAAA,CAAA,KAAY;MAC7B,IAAI;QACF,MAAMC,QAAQ,GAAG,MAAMP,KAAK,CAACQ,GAAG,CAAC,iCAAiC;QAClEL,QAAQ,CAACM,KAAK,GAAGF,QAAQ,CAACG,IAAI,CAACC,OAAO,IAAI,EAAC;MAC7C,CAAC,CAAC,OAAOC,KAAK,EAAE;QACdX,SAAS,CAACW,KAAK,CAAC,UAAU;QAC1BC,OAAO,CAACD,KAAK,CAACA,KAAK;MACrB;IACF;IAEA,MAAME,YAAY,GAAGA,CAAA,KAAM;MACzBR,UAAU,CAAC;IACb;IAEA,IAAIS,UAAU,GAAG,IAAG;IACpBjB,SAAS,CAAC,MAAM;MACdiB,UAAU,GAAGC,WAAW,CAAC,MAAM;QAC7BF,YAAY,CAAC;MACf,CAAC,EAAE,IAAI;IACT,CAAC;IAEDf,eAAe,CAAC,MAAM;MACpB,IAAIgB,UAAU,EAAE;QACdE,aAAa,CAACF,UAAU;MAC1B;IACF,CAAC;IAED,MAAMG,QAAQ,GAAIC,IAAI,IAAK;MACzBd,YAAY,CAACI,KAAK,GAAGU,IAAG;MACxBf,aAAa,CAACK,KAAK,GAAG,IAAG;IAC3B;IAEA,MAAMW,WAAW,GAAID,IAAI,IAAK;MAC5BlB,SAAS,CAACoB,OAAO,CAAC,SAASF,IAAI,CAACG,IAAI,EAAE;MACtCT,OAAO,CAACU,GAAG,CAAC,WAAWJ,IAAI,CAACG,IAAI,EAAE;IACpC;IAEA,MAAME,UAAU,GAAG,MAAOL,IAAI,IAAK;MACjC,IAAI;QACF,MAAMjB,YAAY,CAACuB,OAAO,CACtB,WAAWN,IAAI,CA