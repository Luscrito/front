{"ast":null,"code":"import { ref, reactive, nextTick } from 'vue';\nimport axios from 'axios';\nimport { ElMessage } from 'element-plus';\nexport default {\n  __name: 'AddPlanDialog',\n  setup(__props, {\n    expose: __expose\n  }) {\n    const dialogVisible = ref(false);\n    const formRef = ref(null);\n    const form = reactive({\n      selectedContainer: '',\n      selectedChain: '',\n      sourceAddress: '',\n      destinationAddress: '',\n      destinationPort: '',\n      selectedRule: ''\n    });\n    const rules = {\n      selectedContainer: [{\n        required: true,\n        message: '请选择容器',\n        trigger: 'manual'\n      }],\n      selectedChain: [{\n        required: true,\n        message: '请选择链',\n        trigger: 'manual'\n      }],\n      sourceAddress: [{\n        required: true,\n        message: '请输入源地址',\n        trigger: 'manual'\n      }],\n      destinationAddress: [{\n        required: true,\n        message: '请输入目标地址',\n        trigger: 'manual'\n      }],\n      destinationPort: [{\n        required: true,\n        message: '请输入目的端口',\n        trigger: 'manual'\n      }],\n      selectedRule: [{\n        required: true,\n        message: '请选择规则',\n        trigger: 'manual'\n      }]\n    };\n    const containers = ref([]);\n    const containersRef = ref(null);\n    const openDialog = async () => {\n      dialogVisible.value = true;\n      Object.assign(form, {\n        selectedContainer: '',\n        selectedChain: '',\n        sourceAddress: '',\n        destinationAddress: '',\n        destinationPort: '',\n        selectedRule: ''\n      });\n      await nextTick();\n      if (containersRef.value) {\n        await containersRef.value.fetchContainers();\n        containers.value = containersRef.value.containers || [];\n      }\n    };\n    const generateRule = () => {\n      if (form.selectedChain === 'INPUT') {\n        return `-i ${form.sourceAddress} -d ${form.destinationAddress} -j ${form.selectedRule}`;\n      } else if (form.selectedChain === 'OUTPUT') {\n        return `-s ${form.sourceAddress} -d ${form.destinationAddress} --dport ${form.destinationPort} -j ${form.selectedRule}`;\n      } else if (form.selectedChain === 'FORWARD') {\n        return `-s ${form.sourceAddress} -d ${form.destinationAddress} -j ${form.selectedRule}`;\n      }\n      return '';\n    };\n    const handleAddRule = async () => {\n      if (!formRef.value) return;\n      formRef.value.validate(async valid => {\n        if (!valid) {\n          ElMessage.warning('请填写所有必需字段');\n          return;\n        }\n        try {\n          const ruleString = generateRule();\n          await axios.post(`/api/firewall/add`, null, {\n            params: {\n              containerName: form.selectedContainer,\n              chain: form.selectedChain,\n              rule: ruleString\n            }\n          });\n          ElMessage.success('防火墙规则添加成功');\n          dialogVisible.value = false;\n        } catch (err) {\n          console.error('添加规则失败', err);\n          ElMessage.error(`添加规则失败：${err}`);\n        }\n      });\n    };\n    const handleChainChange = () => {\n      form.sourceAddress = '';\n      form.destinationAddress = '';\n      form.destinationPort = '';\n      form.selectedRule = '';\n    };\n    __expose({\n      openDialog\n    });\n    const __returned__ = {\n      dialogVisible,\n      formRef,\n      form,\n      rules,\n      containers,\n      containersRef,\n      openDialog,\n      generateRule,\n      handleAddRule,\n      handleChainChange,\n      ref,\n      reactive,\n      nextTick,\n      get axios() {\n        return axios;\n      },\n      get ElMessage() {\n        return ElMessage;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","reactive","nextTick","axios","ElMessage","dialogVisible","formRef","form","selectedContainer","selectedChain","sourceAddress","destinationAddress","destinationPort","selectedRule","rules","required","message","trigger","containers","containersRef","openDialog","value","Object","assign","fetchContainers","generateRule","handleAddRule","validate","valid","warning","ruleString","post","params","containerName","chain","rule","success","err","console","error","handleChainChange","__expose"],"sources":["/home/lsc/IdeaProjects/dockerNetwork/front/src/components/Plan/AddPlanDialog.vue"],"sourcesContent":["<template>\n  <el-dialog title=\"添加防火墙规则\" v-model=\"dialogVisible\" width=\"600px\">\n    <el-form :model=\"form\" :rules=\"rules\" ref=\"formRef\" label-width=\"100px\">\n      <el-form-item label=\"选择容器\" prop=\"selectedContainer\">\n        <el-select v-model=\"form.selectedContainer\" placeholder=\"请选择容器\">\n          <el-option\n              v-for=\"(container, index) in containers\"\n              :key=\"index\"\n              :label=\"container.name.replace(/^\\//, '')\"\n              :value=\"container.name.replace(/^\\//, '')\"\n          />\n        </el-select>\n      </el-form-item>\n\n      <el-form-item label=\"选择链\" prop=\"selectedChain\">\n        <el-select v-model=\"form.selectedChain\" placeholder=\"请选择链\" @change=\"handleChainChange\">\n          <el-option label=\"INPUT\" value=\"INPUT\" />\n          <el-option label=\"OUTPUT\" value=\"OUTPUT\" />\n          <el-option label=\"FORWARD\" value=\"FORWARD\" />\n        </el-select>\n      </el-form-item>\n\n      <!-- INPUT 链 -->\n      <div v-if=\"form.selectedChain === 'INPUT'\">\n        <el-form-item label=\"源地址\" prop=\"sourceAddress\">\n          <el-input v-model=\"form.sourceAddress\" placeholder=\"请输入源地址\" />\n        </el-form-item>\n        <el-form-item label=\"目标地址\" prop=\"destinationAddress\">\n          <el-input v-model=\"form.destinationAddress\" placeholder=\"请输入目标地址\" />\n        </el-form-item>\n        <el-form-item label=\"选择规则\" prop=\"selectedRule\">\n          <el-select v-model=\"form.selectedRule\" placeholder=\"请选择规则\">\n            <el-option label=\"流量通过\" value=\"ACCEPT\" />\n            <el-option label=\"流量拒绝\" value=\"REJECT\" />\n          </el-select>\n        </el-form-item>\n      </div>\n\n      <!-- OUTPUT 链 -->\n      <div v-if=\"form.selectedChain === 'OUTPUT'\">\n        <el-form-item label=\"源地址\" prop=\"sourceAddress\">\n          <el-input v-model=\"form.sourceAddress\" placeholder=\"请输入源地址\" />\n        </el-form-item>\n        <el-form-item label=\"目标地址\" prop=\"destinationAddress\">\n          <el-input v-model=\"form.destinationAddress\" placeholder=\"请输入目标地址\" />\n        </el-form-item>\n        <el-form-item label=\"目的端口\" prop=\"destinationPort\">\n          <el-input v-model=\"form.destinationPort\" placeholder=\"请输入目的端口\" />\n        </el-form-item>\n        <el-form-item label=\"选择规则\" prop=\"selectedRule\">\n          <el-select v-model=\"form.selectedRule\" placeholder=\"请选择规则\">\n            <el-option label=\"流量通过\" value=\"ACCEPT\" />\n            <el-option label=\"流量拒绝\" value=\"REJECT\" />\n          </el-select>\n        </el-form-item>\n      </div>\n\n      <!-- FORWARD 链 -->\n      <div v-if=\"form.selectedChain === 'FORWARD'\">\n        <el-form-item label=\"源地址\" prop=\"sourceAddress\">\n          <el-input v-model=\"form.sourceAddress\" placeholder=\"请输入源地址\" />\n        </el-form-item>\n        <el-form-item label=\"目标地址\" prop=\"destinationAddress\">\n          <el-input v-model=\"form.destinationAddress\" placeholder=\"请输入目标地址\" />\n        </el-form-item>\n        <el-form-item label=\"选择规则\" prop=\"selectedRule\">\n          <el-select v-model=\"form.selectedRule\" placeholder=\"请选择规则\">\n            <el-option label=\"流量通过\" value=\"ACCEPT\" />\n            <el-option label=\"流量拒绝\" value=\"REJECT\" />\n          </el-select>\n        </el-form-item>\n      </div>\n    </el-form>\n\n    <template #footer>\n      <el-button type=\"primary\" @click=\"handleAddRule\">添加规则</el-button>\n      <el-button @click=\"dialogVisible = false\">取消</el-button>\n    </template>\n  </el-dialog>\n</template>\n\n<script setup>\nimport { ref, reactive, nextTick, defineExpose } from 'vue'\nimport axios from 'axios'\nimport { ElMessage } from 'element-plus'\n\nconst dialogVisible = ref(false)\nconst formRef = ref(null)\n\nconst form = reactive({\n  selectedContainer: '',\n  selectedChain: '',\n  sourceAddress: '',\n  destinationAddress: '',\n  destinationPort: '',\n  selectedRule: ''\n})\n\nconst rules = {\n  selectedContainer: [{ required: true, message: '请选择容器', trigger: 'manual' }],\n  selectedChain: [{ required: true, message: '请选择链', trigger: 'manual' }],\n  sourceAddress: [{ required: true, message: '请输入源地址', trigger: 'manual' }],\n  destinationAddress: [{ required: true, message: '请输入目标地址', trigger: 'manual' }],\n  destinationPort: [{ required: true, message: '请输入目的端口', trigger: 'manual' }],\n  selectedRule: [{ required: true, message: '请选择规则', trigger: 'manual' }]\n}\n\nconst containers = ref([])\nconst containersRef = ref(null)\n\nconst openDialog = async () => {\n  dialogVisible.value = true\n  Object.assign(form, {\n    selectedContainer: '',\n    selectedChain: '',\n    sourceAddress: '',\n    destinationAddress: '',\n    destinationPort: '',\n    selectedRule: ''\n  })\n\n  await nextTick()\n  if (containersRef.value) {\n    await containersRef.value.fetchContainers()\n    containers.value = containersRef.value.containers || []\n  }\n}\n\nconst generateRule = () => {\n  if (form.selectedChain === 'INPUT') {\n    return `-i ${form.sourceAddress} -d ${form.destinationAddress} -j ${form.selectedRule}`\n  } else if (form.selectedChain === 'OUTPUT') {\n    return `-s ${form.sourceAddress} -d ${form.destinationAddress} --dport ${form.destinationPort} -j ${form.selectedRule}`\n  } else if (form.selectedChain === 'FORWARD') {\n    return `-s ${form.sourceAddress} -d ${form.destinationAddress} -j ${form.selectedRule}`\n  }\n  return ''\n}\n\nconst handleAddRule = async () => {\n  if (!formRef.value) return\n  formRef.value.validate(async (valid) => {\n    if (!valid) {\n      ElMessage.warning('请填写所有必需字段')\n      return\n    }\n\n    try {\n      const ruleString = generateRule()\n      await axios.post(`/api/firewall/add`, null, {\n        params: {\n          containerName: form.selectedContainer,\n          chain: form.selectedChain,\n          rule: ruleString\n        }\n      })\n      ElMessage.success('防火墙规则添加成功')\n      dialogVisible.value = false\n    } catch (err) {\n      console.error('添加规则失败', err)\n      ElMessage.error(`添加规则失败：${err}`)\n    }\n  })\n}\n\nconst handleChainChange = () => {\n  form.sourceAddress = ''\n  form.destinationAddress = ''\n  form.destinationPort = ''\n  form.selectedRule = ''\n}\n\ndefineExpose({ openDialog })\n</script>\n"],"mappings":"AAkFA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,QAAsB,QAAQ,KAAI;AAC1D,OAAOC,KAAK,MAAM,OAAM;AACxB,SAASC,SAAS,QAAQ,cAAa;;;;;;IAEvC,MAAMC,aAAa,GAAGL,GAAG,CAAC,KAAK;IAC/B,MAAMM,OAAO,GAAGN,GAAG,CAAC,IAAI;IAExB,MAAMO,IAAI,GAAGN,QAAQ,CAAC;MACpBO,iBAAiB,EAAE,EAAE;MACrBC,aAAa,EAAE,EAAE;MACjBC,aAAa,EAAE,EAAE;MACjBC,kBAAkB,EAAE,EAAE;MACtBC,eAAe,EAAE,EAAE;MACnBC,YAAY,EAAE;IAChB,CAAC;IAED,MAAMC,KAAK,GAAG;MACZN,iBAAiB,EAAE,CAAC;QAAEO,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,OAAO;QAAEC,OAAO,EAAE;MAAS,CAAC,CAAC;MAC5ER,aAAa,EAAE,CAAC;QAAEM,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,MAAM;QAAEC,OAAO,EAAE;MAAS,CAAC,CAAC;MACvEP,aAAa,EAAE,CAAC;QAAEK,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,QAAQ;QAAEC,OAAO,EAAE;MAAS,CAAC,CAAC;MACzEN,kBAAkB,EAAE,CAAC;QAAEI,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,SAAS;QAAEC,OAAO,EAAE;MAAS,CAAC,CAAC;MAC/EL,eAAe,EAAE,CAAC;QAAEG,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,SAAS;QAAEC,OAAO,EAAE;MAAS,CAAC,CAAC;MAC5EJ,YAAY,EAAE,CAAC;QAAEE,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,OAAO;QAAEC,OAAO,EAAE;MAAS,CAAC;IACxE;IAEA,MAAMC,UAAU,GAAGlB,GAAG,CAAC,EAAE;IACzB,MAAMmB,aAAa,GAAGnB,GAAG,CAAC,IAAI;IAE9B,MAAMoB,UAAU,GAAG,MAAAA,CAAA,KAAY;MAC7Bf,aAAa,CAACgB,KAAK,GAAG,IAAG;MACzBC,MAAM,CAACC,MAAM,CAAChB,IAAI,EAAE;QAClBC,iBAAiB,EAAE,EAAE;QACrBC,aAA