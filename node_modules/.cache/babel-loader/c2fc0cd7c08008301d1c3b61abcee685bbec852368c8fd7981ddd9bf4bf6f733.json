pan>\n          <el-button type=\"primary\" size=\"small\" @click=\"fetchTopology\">刷新</el-button>\n        </div>\n      </template>\n      <div ref=\"chartRef\" style=\"width: 100%; height: 600px;\"></div>\n    </el-card>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted, onBeforeUnmount } from 'vue'\nimport * as echarts from 'echarts'\nimport axios from 'axios'\n\n// refs\nconst chartRef = ref(null)\nlet chartInstance = null\n\n// 拿到拓扑数据\nconst fetchTopology = async () => {\n  try {\n    const response = await axios.get('http://localhost:8081/topology/get')\n    const { nodes, links } = response.data\n\n    renderGraph(nodes, links)\n  } catch (error) {\n    console.error('获取拓扑数据失败:', error)\n  }\n}\n\n// 渲染图表\nconst renderGraph = (nodes, links) => {\n  if (!chartInstance && chartRef.value) {\n    chartInstance = echarts.init(chartRef.value)\n  }\n\n  const option = {\n    title: {\n      text: 'Docker 容器拓扑图',\n      left: 'center'\n    },\n    tooltip: {\n      trigger: 'item',\n      formatter: function (params) {\n        if (params.dataType === 'node') {\n          return `容器：${params.data.name}`\n        } else if (params.dataType === 'edge') {\n          return `${params.data.source} ➔ ${params.data.target}`\n        }\n      }\n    },\n    series: [\n      {\n        type: 'graph',\n        layout: 'force',\n        roam: true,\n        label: {\n          show: true,\n          position: 'right',\n          formatter: '{b}'\n        },\n        force: {\n          repulsion: 200,\n          edgeLength: 120\n        },\n        draggable: true,\n        data: nodes.map(n => ({\n          id: n.id,\n          name: n.name,\n          symbolSize: 60\n        })),\n        links: links.map(l => ({\n          source: l.source,\n          target: l.target\n        }))\n      }\n    ]\n  }\n\n  chartInstance.setOption(option)\n}\n\n// 自动加载拓扑\nonMounted(() => {\n  fetchTopology()\n})\n\n// 销毁 ECharts 实例\nonBeforeUnmount(() => {\n  if (chartInstance) {\n    chartInstance.dispose()\n  }\n})\n</script>\n\n<style scoped>\n.topology-graph {\n  padding: 20px;\n}\n\n.card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n</style>\n"],"mappings":";;EACOA,KAAK,EAAC;AAAgB;;EAGhBA,KAAK,EAAC;AAAa;;EAKrBC,GAAG,EAAC,UAAU;EAACC,KAAmC,EAAnC;IAAA;IAAA;EAAA;;;;;uBARxBC,mBAAA,CAUM,OAVNC,UAUM,GATJC,YAAA,CAQUC,kBAAA;IARDC,MAAM,EAAC;EAAO;IACVC,MAAM,EAAAC,QAAA,CACf,MAGM,CAHNC,mBAAA,CAGM,OAHNC,UAGM,G,0BAFJD,mBAAA,CAAoB,cAAd,SAAO,sBACbL,YAAA,CAA4EO,oBAAA;MAAjEC,IAAI,EAAC,SAAS;MAACC,IAAI,EAAC,OAAO;MAAEC,OAAK,EAAEC,MAAA,CAAAC;;MANzDC,OAAA,EAAAT,QAAA,CAMwE,MAAEU,MAAA,QAAAA,MAAA,OAN1EC,gBAAA,CAMwE,IAAE,E;MAN1EC,CAAA;;IAAAH,OAAA,EAAAT,QAAA,CASM,MAA8D,CAA9DC,mBAAA,CAA8D,OAA9DY,UAA8D,8B;IATpED,CAAA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}