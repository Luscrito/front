{"ast":null,"code":"import { createCommentVNode as _createCommentVNode, renderList as _renderList, Fragment as _Fragment, openBlock as _openBlock, createElementBlock as _createElementBlock, resolveComponent as _resolveComponent, createBlock as _createBlock, withCtx as _withCtx, createElementVNode as _createElementVNode, createVNode as _createVNode } from \"vue\";\nconst _hoisted_1 = {\n  class: \"monitor-container\"\n};\nconst _hoisted_2 = {\n  class: \"charts-wrapper\"\n};\nconst _hoisted_3 = {\n  ref: \"bandwidthChartRef\",\n  class: \"chart\"\n};\nconst _hoisted_4 = {\n  ref: \"networkChartRef\",\n  class: \"chart\"\n};\nexport function render(_ctx, _cache, $props, $setup, $data, $options) {\n  const _component_el_option = _resolveComponent(\"el-option\");\n  const _component_el_select = _resolveComponent(\"el-select\");\n  return _openBlock(), _createElementBlock(_Fragment, null, [_createElementVNode(\"div\", _hoisted_1, [_createCommentVNode(\" 容器选择器 \"), $setup.containers.length > 0 ? (_openBlock(), _createBlock(_component_el_select, {\n    key: 0,\n    modelValue: $setup.selectedContainer,\n    \"onUpdate:modelValue\": _cache[0] || (_cache[0] = $event => $setup.selectedContainer = $event),\n    placeholder: \"选择容器\",\n    onChange: $setup.startMonitoring\n  }, {\n    default: _withCtx(() => [(_openBlock(true), _createElementBlock(_Fragment, null, _renderList($setup.containers, c => {\n      return _openBlock(), _createBlock(_component_el_option, {\n        key: c.name,\n        label: c.name.replace(/^\\//, ''),\n        value: c.name.replace(/^\\//, '')\n      }, null, 8 /* PROPS */, [\"label\", \"value\"]);\n    }), 128 /* KEYED_FRAGMENT */))]),\n    _: 1 /* STABLE */\n  }, 8 /* PROPS */, [\"modelValue\"])) : _createCommentVNode(\"v-if\", true), _createCommentVNode(\" 图表容器 \"), _createElementVNode(\"div\", _hoisted_2, [_createElementVNode(\"div\", _hoisted_3, null, 512 /* NEED_PATCH */), _createElementVNode(\"div\", _hoisted_4, null, 512 /* NEED_PATCH */)])]), _createVNode($setup[\"DockerContainers\"], {\n    ref: \"dockerContainersRef\"\n  }, null, 512 /* NEED_PATCH */)], 64 /* STABLE_FRAGMENT */);\n}","map":{"version":3,"names":["class","ref","_createElementBlock","_Fragment","_createElementVNode","_hoisted_1","_createCommentVNode","$setup","containers","length","_createBlock","_component_el_select","key","modelValue","selectedContainer","_cache","$event","placeholder","onChange","startMonitoring","default","_withCtx","_renderList","c","_component_el_option","name","label","replace","value","_","_hoisted_2","_hoisted_3","_hoisted_4","_createVNode"],"sources":["/home/lsc/IdeaProjects/dockerNetwork/front/src/components/Monitor/MonitorView.vue"],"sourcesContent":["<template>\n  <div class=\"monitor-container\">\n    <!-- 容器选择器 -->\n    <el-select\n        v-if=\"containers.length > 0\"\n        v-model=\"selectedContainer\"\n        placeholder=\"选择容器\"\n        @change=\"startMonitoring\"\n    >\n      <el-option\n          v-for=\"c in containers\"\n          :key=\"c.name\"\n          :label=\"c.name.replace(/^\\//, '')\"\n          :value=\"c.name.replace(/^\\//, '')\"\n      />\n    </el-select>\n\n    <!-- 图表容器 -->\n    <div class=\"charts-wrapper\">\n      <div ref=\"bandwidthChartRef\" class=\"chart\"></div>\n      <div ref=\"networkChartRef\" class=\"chart\"></div>\n    </div>\n  </div>\n  <DockerContainers ref=\"dockerContainersRef\" />\n</template>\n\n<script setup>\nimport { ref, onMounted, onBeforeUnmount, nextTick } from 'vue'\nimport DockerContainers from '@/components/Container/DockerContainers.vue' // 修改为你的实际路径\nimport axios from 'axios'\nimport * as echarts from 'echarts'\n\n// refs\nconst dockerContainersRef = ref(null)\nconst containers = ref([])  // 容器列表\nconst selectedContainer = ref('')  // 当前选中的容器\nconst bandwidthChartRef = ref(null)\nconst networkChartRef = ref(null)\n\nlet bandwidthChart = null\nlet networkChart = null\nlet intervalId = null\n\n// 图表数据\nconst timeData = ref([])\nconst bandwidthData = ref([])\nconst rxData = ref([])\nconst txData = ref([])\n\n// 获取容器列表（通过子组件暴露的方法）\nconst fetchContainers = async () => {\n  if (dockerContainersRef.value) {\n    await dockerContainersRef.value.fetchContainers()\n    containers.value = dockerContainersRef.value.containers\n  }\n}\n\n// 开始监控\nconst startMonitoring = () => {\n  clearInterval(intervalId)\n\n  timeData.value = []\n  bandwidthData.value = []\n  rxData.value = []\n  txData.value = []\n\n  updateCharts()\n\n  intervalId = setInterval(async () => {\n    if (!selectedContainer.value) return\n\n    const timestamp = new Date().toLocaleTimeString()\n\n    try {\n      const bandwidthRes = await axios.get(`http://localhost:8081/stats/bandwidth/${selectedContainer.value}?interval=1000`)\n      const statsRes = await axios.get(`http://localhost:8081/stats/networkStats/${selectedContainer.value}`)\n\n      timeData.value.push(timestamp)\n      bandwidthData.value.push(bandwidthRes.data.totalRate)\n      rxData.value.push(statsRes.data.rxBytes)\n      txData.value.push(statsRes.data.txBytes)\n\n      if (timeData.value.length > 20) {\n        timeData.value.shift()\n        bandwidthData.value.shift()\n        rxData.value.shift()\n        txData.value.shift()\n      }\n\n      updateCharts()\n    } catch (err) {\n      console.error('监控数据获取失败', err)\n    }\n  }, 1000)\n}\n\n// 更新图表\nconst updateCharts = () => {\n  if (!bandwidthChart || !networkChart) {\n    bandwidthChart = echarts.init(bandwidthChartRef.value)\n    networkChart = echarts.init(networkChartRef.value)\n  }\n\n  bandwidthChart.setOption({\n    title: { text: '容器带宽使用率 (Bytes/s)' },\n    tooltip: { trigger: 'axis' },\n    xAxis: { type: 'category', data: timeData.value },\n    yAxis: { type: 'value' },\n    series: [\n      {\n        data: bandwidthData.value,\n        type: 'line',\n        name: '总带宽',\n        smooth: true,\n        areaStyle: {}\n      }\n    ]\n  })\n\n  networkChart.setOption({\n    title: { text: '网络收发字节数 (累计)' },\n    tooltip: { trigger: 'axis' },\n    legend: { data: ['接收字节 RX', '发送字节 TX'] },\n    xAxis: { type: 'category', data: timeData.value },\n    yAxis: { type: 'value' },\n    series: [\n      {\n        data: rxData.value,\n        type: 'line',\n        name: '接收字节 RX',\n        smooth: true\n      },\n      {\n        data: txData.value,\n        type: 'line',\n        name: '发送字节 TX',\n        smooth: true\n      }\n    ]\n  })\n}\n\nonMounted(async () => {\n  await nextTick()\n  await fetchContainers()\n})\n\nonBeforeUnmount(() => {\n  clearInterval(intervalId)\n})\n</script>\n\n<style scoped>\n.monitor-container {\n  padding: 20px;\n}\n\n.charts-wrapper {\n  display: flex;\n  gap: 20px;\n  margin-top: 20px;\n}\n\n.chart {\n  flex: 1;\n  height: 300px;\n  /* 为图表添加阴影和圆角增强视觉效果 */\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\n  border-radius: 8px;\n  background: white;\n}\n\n/* 调整下拉菜单样式 */\n.el-select {\n  width: 100%;\n  max-width: 300px;\n  margin-bottom: 20px;\n}\n</style>\n"],"mappings":";;EACOA,KAAK,EAAC;AAAmB;;EAiBvBA,KAAK,EAAC;AAAgB;;EACpBC,GAAG,EAAC,mBAAmB;EAACD,KAAK,EAAC;;;EAC9BC,GAAG,EAAC,iBAAiB;EAACD,KAAK,EAAC;;;;;uBApBvCE,mBAAA,CAAAC,SAAA,SACEC,mBAAA,CAqBM,OArBNC,UAqBM,GApBJC,mBAAA,WAAc,EAEJC,MAAA,CAAAC,UAAU,CAACC,MAAM,Q,cAD3BC,YAAA,CAYYC,oBAAA;IAfhBC,GAAA;IAAAC,UAAA,EAKiBN,MAAA,CAAAO,iBAAiB;IALlC,uBAAAC,MAAA,QAAAA,MAAA,MAAAC,MAAA,IAKiBT,MAAA,CAAAO,iBAAiB,GAAAE,MAAA;IAC1BC,WAAW,EAAC,MAAM;IACjBC,QAAM,EAAEX,MAAA,CAAAY;;IAPjBC,OAAA,EAAAC,QAAA,CAUU,MAAuB,E,kBAD3BnB,mBAAA,CAKEC,SAAA,QAdRmB,WAAA,CAUsBf,MAAA,CAAAC,UAAU,EAAfe,CAAC;2BADZb,YAAA,CAKEc,oBAAA;QAHGZ,GAAG,EAAEW,CAAC,CAACE,IAAI;QACXC,KAAK,EAAEH,CAAC,CAACE,IAAI,CAACE,OAAO;QACrBC,KAAK,EAAEL,CAAC,CAACE,IAAI,CAACE,OAAO;;;IAbhCE,CAAA;uCAAAvB,mBAAA,gBAiBIA,mBAAA,UAAa,EACbF,mBAAA,CAGM,OAHN0B,UAGM,GAFJ1B,mBAAA,CAAiD,OAAjD2B,UAAiD,+BACjD3B,mBAAA,CAA+C,OAA/C4B,UAA+C,8B,KAGnDC,YAAA,CAA8C1B,MAAA;IAA5BN,GAAG,EAAC;EAAqB,+B","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}