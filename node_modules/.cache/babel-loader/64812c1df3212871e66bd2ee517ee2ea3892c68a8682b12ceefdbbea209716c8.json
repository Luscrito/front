{"ast":null,"code":"import { Cpu, Share, Warning, Guide, Lock, Setting, DocumentChecked } from '@element-plus/icons-vue';\nexport default {\n  __name: 'MainLayout',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const __returned__ = {\n      get Cpu() {\n        return Cpu;\n      },\n      get Share() {\n        return Share;\n      },\n      get Warning() {\n        return Warning;\n      },\n      get Guide() {\n        return Guide;\n      },\n      get Lock() {\n        return Lock;\n      },\n      get Setting() {\n        return Setting;\n      },\n      get DocumentChecked() {\n        return DocumentChecked;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["Cpu","Share","Warning","Guide","Lock","Setting","DocumentChecked"],"sources":["/home/lsc/IdeaProjects/dockerNetwork/front/src/views/MainLayout.vue"],"sourcesContent":["<template>\n  <div class=\"main-layout\">\n    <!-- 顶部菜单栏 -->\n    <el-menu\n        mode=\"horizontal\"\n        menu-trigger=\"hover\"\n        background-color=\"#409EFF\"\n        text-color=\"#fff\"\n        active-text-color=\"#ffd04b\"\n        class=\"top-menu\"\n    >\n      <!-- 容器 -->\n      <el-sub-menu index=\"1\">\n        <template #title>\n          <el-icon><Cpu /></el-icon>\n          <span class=\"menu-label\">容器</span>\n        </template>\n        <el-menu-item index=\"1-1\">添加容器</el-menu-item>\n        <el-menu-item index=\"1-2\">删除容器</el-menu-item>\n        <el-menu-item index=\"1-3\">启动容器</el-menu-item>\n        <el-menu-item index=\"1-4\">停止容器</el-menu-item>\n      </el-sub-menu>\n\n      <!-- 网络 -->\n      <el-sub-menu index=\"2\">\n        <template #title>\n          <el-icon><Share /></el-icon>\n          <span class=\"menu-label\">网络</span>\n        </template>\n        <el-menu-item index=\"2-1\">创建网络</el-menu-item>\n        <el-menu-item 