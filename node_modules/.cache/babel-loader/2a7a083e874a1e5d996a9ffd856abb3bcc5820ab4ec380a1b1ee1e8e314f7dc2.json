{"ast":null,"code":"import { dialogVisible, container, containers, openDialog, submitContainer } from '@/utils/container.js';\nimport { ElButton, ElDialog, ElForm, ElFormItem, ElInput } from 'element-plus';\nimport { Cpu, Share, Monitor, PieChart } from '@element-plus/icons-vue';\nexport default {\n  __name: 'MainLayout',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const __returned__ = {\n      get dialogVisible() {\n        return dialogVisible;\n      },\n      get container() {\n        return container;\n      },\n      get containers() {\n        return containers;\n      },\n      get openDialog() {\n        return openDialog;\n      },\n      get submitContainer() {\n        return submitContainer;\n      },\n      get ElButton() {\n        return ElButton;\n      },\n      get ElDialog() {\n        return ElDialog;\n      },\n      get ElForm() {\n        return ElForm;\n      },\n      get ElFormItem() {\n        return ElFormItem;\n      },\n      get ElInput() {\n        return ElInput;\n      },\n      get Cpu() {\n        return Cpu;\n      },\n      get Share() {\n        return Share;\n      },\n      get Monitor() {\n        return Monitor;\n      },\n      get PieChart() {\n        return PieChart;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["dialogVisible","container","containers","openDialog","submitContainer","ElButton","ElDialog","ElForm","ElFormItem","ElInput","Cpu","Share","Monitor","PieChart"],"sources":["/home/lsc/IdeaProjects/dockerNetwork/front/src/views/MainLayout.vue"],"sourcesContent":["<template>\n  <div class=\"main-layout\">\n    <!-- 顶部菜单栏 -->\n    <el-menu\n        mode=\"horizontal\"\n        menu-trigger=\"hover\"\n        background-color=\"#409EFF\"\n        text-color=\"#fff\"\n        active-text-color=\"#ffd04b\"\n        class=\"top-menu\"\n    >\n      <!-- 容器 -->\n      <el-sub-menu index=\"1\">\n        <template #title>\n          <el-icon><Cpu /></el-icon>\n          <span class=\"menu-label\">容器</span>\n        </template>\n        <!-- 添加容器菜单项 -->\n        <el-menu-item index=\"1-1\" @click=\"openDialog\">添加容器</el-menu-item>\n        <el-menu-item index=\"1-2\">删除容器</el-menu-item>\n        <el-menu-item index=\"1-3\">启动容器</el-menu-item>\n        <el-menu-item index=\"1-4\">停止容器</el-menu-item>\n      </el-sub-menu>\n\n      <!-- 网络 -->\n      <el-sub-menu index=\"2\">\n        <template #title>\n          <el-icon><Share /></el-icon>\n          <span class=\"menu-label\">网络</span>\n        </template>\n        <el-menu-item index=\"2-1\">创建网络</el-menu-item>\n        <el-menu-item index=\"2-2\">断开网络</el-menu-item>\n      </el-sub-menu>\n\n      <!-- 其他菜单项... -->\n    </el-menu>\n\n    <!-- 主内容区域 -->\n    <div class=\"layout-body\">\n      <!-- 拓扑区域（含容器列表） -->\n      <div class=\"topology-area\">\n        <div class=\"topology-header\">\n          <el-icon><PieChart /></el-icon>\n          <span class=\"topology-label\">拓扑区域</span>\n        </div>\n\n        <div class=\"topology-content\">\n          <!-- 左侧容器列表 -->\n          <div class=\"container-list\">\n            <h4>容器列表</h4>\n            <ul>\n              <li v-for=\"(container, index) in containers\" :key=\"index\">\n                <el-icon><Cpu /></el-icon>\n                {{ container.name }}\n              </li>\n            </ul>\n          </div>\n\n          <!-- 右侧拓扑图 -->\n          <div class=\"topology-graph\">\n            <p>拓扑图展示区域</p>\n          </div>\n        </div>\n      </div>\n\n      <!-- 监控区域 -->\n      <div class=\"monitor-area\">\n        <p><el-icon><Monitor /></el-icon> 监控区域</p>\n      </div>\n    </div>\n\n    <!-- 弹出框 -->\n    <el-dialog title=\"添加容器\" :visible=\"dialogVisible\">\n      <el-form :model=\"container\" ref=\"containerForm\" label-width=\"80px\" class=\"container-form\">\n        <!-- 容器名称 -->\n        <el-form-item label=\"容器名称\" :rules=\"[{ required: true, message: '请输入容器名称', trigger: 'blur' }]\">\n          <el-input v-model=\"container.name\" placeholder=\"请输入容器名称\"></el-input>\n        </el-form-item>\n\n        <!-- 镜像 -->\n        <el-form-item label=\"容器镜像\" :rules=\"[{ required: true, message: '请输入镜像名称', trigger: 'blur' }]\">\n          <el-input v-model=\"container.image\" placeholder=\"请输入镜像名称\"></el-input>\n        </el-form-item>\n\n        <!-- 网络 -->\n        <el-form-item label=\"容器网络\" :rules=\"[{ required: true, message: '请输入网络名称', trigger: 'blur' }]\">\n          <el-input v-model=\"container.networks\" placeholder=\"请输入网络名称，用逗号分隔\"></el-input>\n        </el-form-item>\n      </el-form>\n\n      <!-- 底部按钮 -->\n      <template #footer>\n        <el-button @click=\"dialogVisible = false\">取 消</el-button>\n        <el-button type=\"primary\" @click=\"submitContainer\">确 定</el-button>\n      </template>\n    </el-dialog>\n  </div>\n</template>\n\n<script setup>\nimport { dialogVisible, container, containers, openDialog, submitContainer } from '@/utils/container.js';\nimport { ElButton, ElDialog, ElForm, ElFormItem, ElInput } from 'element-plus';\nimport { Cpu, Share, Monitor, PieChart } from '@element-plus/icons-vue';\n</script>\n\n<style scoped>\n/* 样式部分保持不变 */\n</style>\n"],"mappings":"AAoGA,SAASA,aAAa,EAAEC,SAAS,EAAEC,UAAU,EAAEC,UAAU,EAAEC,eAAe,QAAQ,sBAAsB;AACxG,SAASC,QAAQ,EAAEC,QAAQ,EAAEC,MAAM,EAAEC,UAAU,EAAEC,OAAO,QAAQ,cAAc;AAC9E,SAASC,GAAG,EAAEC,KAAK,EAAEC,OAAO,EAAEC,QAAQ,QAAQ,yBAAyB","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}