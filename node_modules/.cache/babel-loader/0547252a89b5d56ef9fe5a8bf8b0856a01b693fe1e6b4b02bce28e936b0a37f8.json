{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport axios from 'axios';\nexport default {\n  __name: 'PlanList',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const plans = ref([]);\n    const fetchPlans = async () => {\n      try {\n        const res = await axios.get('http:localhost:8081/plan/list');\n        plans.value = res.data.records;\n      } catch (err) {\n        console.error('获取计划列表失败：', err);\n      }\n    };\n    onMounted(fetchPlans);\n    const __returned__ = {\n      plans,\n      fetchPlans,\n      ref,\n      onMounted,\n      get axios() {\n        return axios;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","axios","plans","fetchPlans","res","get","value","data","records","err","console","error"],"sources":["/home/lsc/IdeaProjects/dockerNetwork/front/src/components/Plan/PlanList.vue"],"sourcesContent":["<template>\n  <div class=\"p-4\">\n    <h2 class=\"text-xl font-bold mb-4\">测试计划列表</h2>\n    <div v-if=\"plans.length === 0\">暂无数据</div>\n    <table v-else class=\"table-auto w-full border\">\n      <thead>\n      <tr class=\"bg-gray-100\">\n        <th class=\"px-4 py-2 border\">ID</th>\n        <th class=\"px-4 py-2 border\">名称</th>\n        <th class=\"px-4 py-2 border\">描述</th>\n        <th class=\"px-4 py-2 border\">操作</th>\n      </tr>\n      </thead>\n      <tbody>\n      <tr v-for=\"plan in plans\" :key=\"plan.id\" class=\"hover:bg-gray-50\">\n        <td class=\"px-4 py-2 border\">{{ plan.id }}</td>\n        <td class=\"px-4 py-2 border\">{{ plan.name }}</td>\n        <td class=\"px-4 py-2 border\">{{ plan.description }}</td>\n        <td class=\"px-4 py-2 border\">\n          <!-- 可扩展操作按钮 -->\n          <button class=\"text-blue-500 hover:underline\" @click=\"$emit('view', plan)\">查看</button>\n        </td>\n      </tr>\n      </tbody>\n    </table>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted } from 'vue'\nimport axios from 'axios'\n\nconst plans = ref([])\n\nconst fetchPlans = async () => {\n  try {\n    const res = await axios.get('http:localhost:8081/plan/list')\n    plans.value = res.data.records\n  } catch (err) {\n    console.error('获取计划列表失败：', err)\n  }\n}\n\nonMounted(fetchPlans)\n</script>\n"],"mappings":"AA6BA,SAASA,GAAG,EAAEC,SAAS,QAAQ,KAAI;AACnC,OAAOC,KAAK,MAAM,OAAM;;;;;;;IAExB,MAAMC,KAAK,GAAGH,GAAG,CAAC,EAAE;IAEpB,MAAMI,UAAU,GAAG,MAAAA,CAAA,KAAY;MAC7B,IAAI;QACF,MAAMC,GAAG,GAAG,MAAMH,KAAK,CAACI,GAAG,CAAC,+BAA+B;QAC3DH,KAAK,CAACI,KAAK,GAAGF,GAAG,CAACG,IAAI,CAACC,OAAM;MAC/B,CAAC,CAAC,OAAOC,GAAG,EAAE;QACZC,OAAO,CAACC,KAAK,CAAC,WAAW,EAAEF,GAAG;MAChC;IACF;IAEAT,SAAS,CAACG,UAAU","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}