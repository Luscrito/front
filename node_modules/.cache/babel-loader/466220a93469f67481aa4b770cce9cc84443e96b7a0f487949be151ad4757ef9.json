{"ast":null,"code":"import { ref, onMounted, onBeforeUnmount } from 'vue';\nimport axios from 'axios';\nimport { ElMessage } from 'element-plus';\nexport default {\n  __name: 'PlanList',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const plansRef = ref([]);\n\n    // 获取计划列表\n    const fetchPlans = async () => {\n      try {\n        const response = await axios.get('http://localhost:8081/plan/list');\n        plansRef.value = response.data.records || [];\n      } catch (error) {\n        ElMessage.error('获取计划数据失败');\n        console.error(error);\n      }\n    };\n\n    // 手动刷新计划列表\n    const refreshPlans = () => {\n      fetchPlans();\n    };\n    let intervalId = null;\n    onMounted(() => {\n      intervalId = setInterval(() => {\n        refreshPlans();\n      }, 1000); // 每 1 秒刷新一次\n    });\n\n    // 清理定时器\n    onBeforeUnmount(() => {\n      if (intervalId) {\n        clearInterval(intervalId);\n      }\n    });\n\n    // 查看计划详细信息\n    const viewPlan = plan => {\n      alert(`ID: ${plan.id}\n名称: ${plan.name}\n类型: ${plan.type}\n描述: ${plan.description}\n大小: ${plan.size}\n时间: ${plan.time}\n数量: ${plan.num}\n速度: ${plan.velocity}\n容器1: ${plan.container1}\n容器2: ${plan.container2}\n容器2 IP: ${plan.container2Ip}`);\n    };\n    const __returned__ = {\n      plansRef,\n      fetchPlans,\n      refreshPlans,\n      get intervalId() {\n        return intervalId;\n      },\n      set intervalId(v) {\n        intervalId = v;\n      },\n      viewPlan,\n      ref,\n      onMounted,\n      onBeforeUnmount,\n      get axios() {\n        return axios;\n      },\n      get ElMessage() {\n        return ElMessage;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","onBeforeUnmount","axios","ElMessage","plansRef","fetchPlans","response","get","value","data","records","error","console","refreshPlans","intervalId","setInterval","clearInterval","viewPlan","plan","alert","id","name","type","description","size","time","num","velocity","container1","container2","container2Ip"],"sources":["/home/lsc/IdeaProjects/dockerNetwork/front/src/components/Plan/PlanList.vue"],"sourcesContent":["<template>\n  <div class=\"p-4\">\n    <div v-if=\"plansRef.length === 0\" class=\"text-center text-gray-500\">暂无数据</div>\n    <div class=\"table-wrapper\">\n      <el-table :data=\"plansRef\" style=\"width: 100%\">\n        <!-- 查看按钮列 -->\n        <el-table-column label=\"操作\" width=\"100\" fixed=\"right\">\n          <template #default=\"{ row }\">\n            <el-button size=\"small\" type=\"primary\" @click=\"viewPlan(row)\">查看</el-button>\n          </template>\n        </el-table-column>\n\n        <!-- 索引列 -->\n        <el-table-column label=\"#\" type=\"index\" width=\"50\" />\n\n        <!-- 显示 ID、名称、类型 -->\n        <el-table-column label=\"ID\" prop=\"id\" />\n        <el-table-column label=\"名称\" prop=\"name\" />\n        <el-table-column label=\"类型\" prop=\"type\" />\n      </el-table>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted, onBeforeUnmount } from 'vue'\nimport axios from 'axios'\nimport { ElMessage } from 'element-plus'\n\nconst plansRef = ref([])\n\n// 获取计划列表\nconst fetchPlans = async () => {\n  try {\n    const response = await axios.get('http://localhost:8081/plan/list')\n    plansRef.value = response.data.records || []\n  } catch (error) {\n    ElMessage.error('获取计划数据失败')\n    console.error(error)\n  }\n}\n\n// 手动刷新计划列表\nconst refreshPlans = () => {\n  fetchPlans()\n}\n\nlet intervalId = null\nonMounted(() => {\n  intervalId = setInterval(() => {\n    refreshPlans()\n  }, 1000) // 每 1 秒刷新一次\n})\n\n// 清理定时器\nonBeforeUnmount(() => {\n  if (intervalId) {\n    clearInterval(intervalId)\n  }\n})\n\n// 查看计划详细信息\nconst viewPlan = (plan) => {\n  alert(`ID: ${plan.id}\n名称: ${plan.name}\n类型: ${plan.type}\n描述: ${plan.description}\n大小: ${plan.size}\n时间: ${plan.time}\n数量: ${plan.num}\n速度: ${plan.velocity}\n容器1: ${plan.container1}\n容器2: ${plan.container2}\n容器2 IP: ${plan.container2Ip}`)\n}\n</script>\n\n<style scoped>\n.el-table th {\n  background-color: #f1f5f9;\n  color: #333;\n  font-weight: bold;\n}\n\n.el-button {\n  transition: background-color 0.3s ease;\n}\n\n.el-button:hover {\n  background-color: #34d399;\n}\n\n.text-center {\n  text-align: center;\n}\n\n/* 表格滚动区域支持横向和纵向滚动 */\n.table-wrapper {\n  max-width: 100%;\n  max-height: 400px; /* 控制纵向最大高度 */\n  overflow-x: auto;\n  overflow-y: auto;\n  border: 1px solid #e5e7eb;\n  border-radius: 8px;\n}\n</style>\n"],"mappings":"AAyBA,SAASA,GAAG,EAAEC,SAAS,EAAEC,eAAe,QAAQ,KAAI;AACpD,OAAOC,KAAK,MAAM,OAAM;AACxB,SAASC,SAAS,QAAQ,cAAa;;;;;;;IAEvC,MAAMC,QAAQ,GAAGL,GAAG,CAAC,EAAE;;IAEvB;IACA,MAAMM,UAAU,GAAG,MAAAA,CAAA,KAAY;MAC7B,IAAI;QACF,MAAMC,QAAQ,GAAG,MAAMJ,KAAK,CAACK,GAAG,CAAC,iCAAiC;QAClEH,QAAQ,CAACI,KAAK,GAAGF,QAAQ,CAACG,IAAI,CAACC,OAAO,IAAI,EAAC;MAC7C,CAAC,CAAC,OAAOC,KAAK,EAAE;QACdR,SAAS,CAACQ,KAAK,CAAC,UAAU;QAC1BC,OAAO,CAACD,KAAK,CAACA,KAAK;MACrB;IACF;;IAEA;IACA,MAAME,YAAY,GAAGA,CAAA,KAAM;MACzBR,UAAU,CAAC;IACb;IAEA,IAAIS,UAAU,GAAG,IAAG;IACpBd,SAAS,CAAC,MAAM;MACdc,UAAU,GAAGC,WAAW,CAAC,MAAM;QAC7BF,YAAY,CAAC;MACf,CAAC,EAAE,IAAI,CAAC,EAAC;IACX,CAAC;;IAED;IACAZ,eAAe,CAAC,MAAM;MACpB,IAAIa,UAAU,EAAE;QACdE,aAAa,CAACF,UAAU;MAC1B;IACF,CAAC;;IAED;IACA,MAAMG,QAAQ,GAAIC,IAAI,IAAK;MACzBC,KAAK,CAAC,OAAOD,IAAI,CAACE,EAAE;AACtB,MAAMF,IAAI,CAACG,IAAI;AACf,MAAMH,IAAI,CAACI,IAAI;AACf,MAAMJ,IAAI,CAACK,WAAW;AACtB,MAAML,IAAI,CAACM,IAAI;AACf,MAAMN,IAAI,CAACO,IAAI;AACf,MAAMP,IAAI,CAACQ,GAAG;AACd,MAAMR,IAAI,CAACS,QAAQ;AACnB,OAAOT,IAAI,CAACU,UAAU;AACtB,OAAOV,IAAI,CAACW,UAAU;AACtB,UAAUX,IAAI,CAACY,YAAY,EAAE;IAC7B","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}